config settings 'settings'
	option dns_type 'doh'
	option dns_server '1.1.1.1'
	option bootstrap_dns_server '77.88.8.8'
	option dns_rewrite_ttl '60'
	list source_network_interfaces 'br-lan'
	option enable_output_network_interface '0'
	option enable_badwan_interface_monitoring '0'
	option enable_yacd '1'
	option disable_quic '1'
	option update_interval '1d'
	option download_lists_via_proxy '0'
	option dont_touch_dhcp '0'
	option config_path '/etc/sing-box/config.json'
	option cache_path '/tmp/sing-box/cache.db'
	option log_level 'warn'
	option exclude_ntp '0'
	option shutdown_correctly '0'

config section 'main'
	option connection_type 'proxy'
	option proxy_config_type 'url'
	option proxy_string 'vless://6f1c9a0e-3b52-4c1e-9a55-2d4a1b0f7c11@203.0.113.10:443?type=tcp&security=reality&pbk=TyK5Ml0SeZmyYFHYYN4VHaV19HMb2GcH3DSRabyxHmU&fp=chrome&sni=www.example.com&sid=0123456789abcdef&flow=xtls-rprx-vision#main'
	list community_lists 'russia_inside'
	option mixed_proxy_enabled '1'
	option mixed_proxy_port '2080'

config section 'hy'
	option connection_type 'proxy'
	option proxy_config_type 'url'
	option proxy_string 'hy2://secret@203.0.113.11:8443?sni=hy.example.com&obfs=salamander&obfs-password=pw&insecure=1#hy'
	list user_domains 'example.org'

config section 'tr'
	option connection_type 'proxy'
	option proxy_config_type 'url'
	option proxy_string 'trojan://pass@203.0.113.12:443?security=tls&type=ws&path=%2Fws&host=tr.example.com&sni=tr.example.com&fp=firefox#tr'
	list user_domains 'example.net'

config section 'grpcx'
	option connection_type 'proxy'
	option proxy_config_type 'url'
	option proxy_string 'vless://6f1c9a0e-3b52-4c1e-9a55-2d4a1b0f7c11@203.0.113.13:443?type=grpc&serviceName=gun&security=tls&sni=g.example.com&fp=safari#g'
	list user_domains 'example.info'

config section 'ut'
	option connection_type 'proxy'
	option proxy_config_type 'urltest'
	list urltest_proxy_links 'ss://YWVzLTI1Ni1nY206cGFzcw@203.0.113.14:8388#ss'
	list urltest_proxy_links 'socks5://u:p@203.0.113.15:1080#s5'
	list user_domains 'example.biz'

config section 'js'
	option connection_type 'proxy'
	option proxy_config_type 'outbound'
	option outbound_json '{"type":"tuic","server":"203.0.113.16","server_port":443,"uuid":"6f1c9a0e-3b52-4c1e-9a55-2d4a1b0f7c11","password":"p","tls":{"enabled":true,"server_name":"t.example.com"}}'
	list user_domains 'example.co'

config section 'wg'
	option connection_type 'vpn'
	option interface 'wg0'
	option domain_resolver_enabled '0'
	list user_domains 'example.dev'

config section 'blk'
	option connection_type 'block'
	list user_domains 'ads.example.com'
