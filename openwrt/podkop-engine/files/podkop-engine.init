#!/bin/sh /etc/rc.common
# podkop-engine: failsafe for sing-box crash loops
# (see /usr/libexec/podkop-engine/failsafe). It runs whether podkop is installed yet or
# not: podkop may be installed later, and nothing would start this service then.
# Off: uci set sing-box.main.failsafe=0; uci commit sing-box; service podkop-engine restart

USE_PROCD=1
START=95

start_service() {
	[ "$(uci -q get sing-box.main.failsafe)" = 0 ] && return 0
	procd_open_instance failsafe
	procd_set_param command /usr/libexec/podkop-engine/failsafe
	procd_set_param stderr 1
	procd_set_param respawn
	procd_close_instance
}
