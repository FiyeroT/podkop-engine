#!/bin/sh /etc/rc.common
# podkop-engine: failsafe for sing-box crash loops
# (see /usr/libexec/podkop-engine/failsafe). Runs only when podkop is installed.

USE_PROCD=1
START=95

start_service() {
	[ -x /usr/bin/podkop ] || return 0
	procd_open_instance failsafe
	procd_set_param command /usr/libexec/podkop-engine/failsafe
	procd_set_param stderr 1
	procd_set_param respawn
	procd_close_instance
}
