From 88fd5639c0ed49c9df955e995c300cc2a35da6d5 Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Mon, 28 Sep 2026 08:37:30 +0300
Subject: [PATCH 04/66] urltest: re-check when the default interface changes

Before the first check urltest uses its first outbound, and the first check
runs right at start. If WAN is not up yet, every outbound fails that check
and stays marked down until the next interval (3 min by default). Re-check
the group when the network changes, as 1.14 does.
---
 protocol/group/urltest.go | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/protocol/group/urltest.go b/protocol/group/urltest.go
index cf82c342e..98d29a191 100644
--- a/protocol/group/urltest.go
+++ b/protocol/group/urltest.go
@@ -119,6 +119,14 @@ func (s *URLTest) PerformUpdateCheck() {
 	s.group.performUpdateCheck()
 }
 
+// InterfaceUpdated re-checks the group when the default interface changes
+// (e.g. WAN came up after boot), instead of waiting for the next interval.
+func (s *URLTest) InterfaceUpdated() {
+	if s.group != nil {
+		go s.group.CheckOutbounds(true)
+	}
+}
+
 func (s *URLTest) DialContext(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
 	s.group.Touch()
 	var outbound adapter.Outbound
-- 
