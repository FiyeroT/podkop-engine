From eb1ca717db5c8ce0390463751e2f4a2cbace67bf Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Mon, 28 Sep 2026 10:26:27 +0300
Subject: [PATCH 05/35] rule-set: close the connection of a failed download

fetch creates a new HTTP client for every update and never closed the
response body on an unexpected status (404, 403, 5xx). The connection then
stays open even after the server closes it (CLOSE_WAIT), with its
goroutines and buffers. Once a day that went unnoticed; with the retries
of the previous patch a list answering 404 leaked about 40 KB and one file
descriptor every 30 s, i.e. ~115 MB a day.

Close the body in every case and the client's idle connections after the
fetch, as 1.14 does.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 route/rule/rule_set_remote.go | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/route/rule/rule_set_remote.go b/route/rule/rule_set_remote.go
index c45001dc3..72b5f4135 100644
--- a/route/rule/rule_set_remote.go
+++ b/route/rule/rule_set_remote.go
@@ -268,6 +268,8 @@ func (s *RemoteRuleSet) fetch(ctx context.Context, startContext *adapter.HTTPSta
 				},
 			},
 		}
+		// The client is thrown away after this fetch: do not leave its connections open.
+		defer httpClient.CloseIdleConnections()
 	}
 	request, err := http.NewRequest("GET", s.options.RemoteOptions.URL, nil)
 	if err != nil {
@@ -280,6 +282,8 @@ func (s *RemoteRuleSet) fetch(ctx context.Context, startContext *adapter.HTTPSta
 	if err != nil {
 		return err
 	}
+	// Also on an unexpected status, otherwise the connection stays open.
+	defer response.Body.Close()
 	switch response.StatusCode {
 	case http.StatusOK:
 	case http.StatusNotModified:
