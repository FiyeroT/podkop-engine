From 5fb008ba023df0851cf6a159cea467b37d4ca7c9 Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Tue, 29 Sep 2026 15:33:06 +0300
Subject: [PATCH 07/24] dns/tls: drop idle pooled connections before servers
 close them

Public DoT servers close idle connections after 10 s (Cloudflare, Quad9),
30 s (Yandex, AdGuard) or 60 s (Google). The pool kept connections for
ever and could not see that the server had closed them: after a pause every
query picked a dead connection, got EOF, retried once on another dead one
and failed. A burst of 40 queries left 40 such connections behind.

A pooled connection idle for more than 8 s is now closed instead of reused,
and a query tries up to 5 pooled connections before giving up. Against five
public servers, queries after 25 s and 70 s of idle time now all succeed
(before: all failed on Cloudflare and Quad9 after 25 s and on every server
after 70 s).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 dns/transport/tls.go | 16 ++++++++++++++--
 1 file changed, 14 insertions(+), 2 deletions(-)

diff --git a/dns/transport/tls.go b/dns/transport/tls.go
index fdb485637..b03e5aeeb 100644
--- a/dns/transport/tls.go
+++ b/dns/transport/tls.go
@@ -2,6 +2,7 @@ package transport
 
 import (
 	"context"
+	"time"
 
 	"github.com/sagernet/sing-box/adapter"
 	"github.com/sagernet/sing-box/common/dialer"
@@ -24,6 +25,14 @@ var _ adapter.DNSTransport = (*TLSTransport)(nil)
 
 const tlsDNSMaxInflight = 8
 
+// Public DoT servers close idle connections after 10 s (Cloudflare, Quad9) to 60 s
+// (Google). A pooled connection idle for longer than this is dropped instead of reused,
+// so a query does not land on a connection the server has already closed.
+const tlsDNSIdleTimeout = 8 * time.Second
+
+// A query tries pooled connections until one works or a fresh one has been dialed.
+const tlsDNSMaxAttempts = 5
+
 func RegisterTLS(registry *dns.TransportRegistry) {
 	dns.RegisterTransport[option.RemoteTLSDNSServerOptions](registry, C.DNSTypeTLS, NewTLS)
 }
@@ -42,6 +51,7 @@ type tlsDNSConn struct {
 	tls.Conn
 	queryId           uint16
 	needDeadlineClose bool
+	lastUsed          time.Time
 }
 
 func NewTLS(ctx context.Context, logger log.ContextLogger, tag string, options option.RemoteTLSDNSServerOptions) (adapter.DNSTransport, error) {
@@ -76,7 +86,7 @@ func NewTLSRaw(logger logger.ContextLogger, adapter dns.TransportAdapter, dialer
 			Mode:        ConnPoolOrdered,
 			MaxInflight: tlsDNSMaxInflight,
 			IsAlive: func(conn *tlsDNSConn) bool {
-				return conn != nil
+				return conn != nil && time.Since(conn.lastUsed) < tlsDNSIdleTimeout
 			},
 			Close: func(conn *tlsDNSConn, _ error) {
 				conn.Close()
@@ -102,7 +112,7 @@ func (t *TLSTransport) Reset() {
 
 func (t *TLSTransport) Exchange(ctx context.Context, message *mDNS.Msg) (*mDNS.Msg, error) {
 	var lastErr error
-	for range 2 {
+	for range tlsDNSMaxAttempts {
 		conn, created, err := t.connections.Acquire(ctx, func(ctx context.Context) (*tlsDNSConn, error) {
 			tlsConn, err := t.dialer.DialTLSContext(ctx, t.serverAddr)
 			if err != nil {
@@ -111,6 +121,7 @@ func (t *TLSTransport) Exchange(ctx context.Context, message *mDNS.Msg) (*mDNS.M
 			return &tlsDNSConn{
 				Conn:              tlsConn,
 				needDeadlineClose: deadline.NeedAdditionalReadDeadline(tlsConn.NetConn()),
+				lastUsed:          time.Now(),
 			}, nil
 		})
 		if err != nil {
@@ -118,6 +129,7 @@ func (t *TLSTransport) Exchange(ctx context.Context, message *mDNS.Msg) (*mDNS.M
 		}
 		response, err := t.exchange(ctx, message, conn)
 		if err == nil {
+			conn.lastUsed = time.Now()
 			t.connections.Release(conn, true)
 			return response, nil
 		}
-- 
