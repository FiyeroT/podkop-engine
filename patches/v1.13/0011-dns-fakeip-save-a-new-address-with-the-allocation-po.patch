From f12c1cda96be5f1355b68b55de0f6e680cd96b01 Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Wed, 30 Sep 2026 23:36:29 +0300
Subject: [PATCH 11/11] dns/fakeip: save a new address with the allocation
 position in one write

The allocation position was saved by a timer 10 s after the last new name and
removed from the cache file at start, so it reached the file only on a clean
stop. After a crash, an OOM kill or SIGKILL (procd sends it 5 s after
SIGTERM) the store started again from the beginning of the range and gave
addresses clients still held to other names: connections went to the wrong
site, or got "missing fakeip record". Every new name also waited for a bbolt
batch (10 ms) under the store lock: at most about 100 new names per second, a
burst of 100 new names got its last answer after about 1 s.

A new address and the position are now written in one transaction (a plain
update, not a batch), the position in a bucket of its own; an address that
cannot be saved is not given out; Close keeps the lock until the position is
saved and gives out nothing after it. On a clean stop the position is also
written where older versions read it.

Lab (podkop, 100 new names at once): cache file in tmpfs, last answer
1040 ms -> 6 ms; on emulated SPI-NAND (UBIFS, ESMT F50L1G41LB timings)
1170 ms -> 125 ms. After kill -9 under load no address is given out twice.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 dns/transport/fakeip/store.go    |  88 ++++++++++++++--------
 experimental/cachefile/fakeip.go | 121 ++++++++++++++++++++++---------
 2 files changed, 144 insertions(+), 65 deletions(-)

diff --git a/dns/transport/fakeip/store.go b/dns/transport/fakeip/store.go
index b7c51dfa5..da34bcc0e 100644
--- a/dns/transport/fakeip/store.go
+++ b/dns/transport/fakeip/store.go
@@ -13,6 +13,13 @@ import (
 
 var _ adapter.FakeIPStore = (*Store)(nil)
 
+// fakeIPAtomicStorage saves a new address and the allocation position in one write (the
+// cache file, podkop-engine): a crash can then neither hand an address out twice nor lose
+// the position.
+type fakeIPAtomicStorage interface {
+	FakeIPStoreWithMetadata(address netip.Addr, domain string, metadata *adapter.FakeIPMetadata) error
+}
+
 type Store struct {
 	ctx        context.Context
 	logger     logger.Logger
@@ -25,6 +32,7 @@ type Store struct {
 	addressAccess sync.Mutex
 	inet4Current  netip.Addr
 	inet6Current  netip.Addr
+	closed        bool
 }
 
 func NewStore(ctx context.Context, logger logger.Logger, inet4Range netip.Prefix, inet6Range netip.Prefix) *Store {
@@ -43,6 +51,14 @@ func NewStore(ctx context.Context, logger logger.Logger, inet4Range netip.Prefix
 	return store
 }
 
+func nextAddress(addressRange netip.Prefix, last netip.Addr, current netip.Addr) netip.Addr {
+	address := current.Next()
+	if address == last || !addressRange.Contains(address) {
+		address = addressRange.Addr().Next().Next()
+	}
+	return address
+}
+
 func broadcastAddress(prefix netip.Prefix) netip.Addr {
 	addr := prefix.Addr()
 	raw := addr.As16()
@@ -93,15 +109,17 @@ func (s *Store) Close() error {
 	if s.storage == nil {
 		return nil
 	}
+	// the lock is kept until the position is saved: queries waiting for it must not give
+	// out addresses after it
 	s.addressAccess.Lock()
-	metadata := &adapter.FakeIPMetadata{
+	defer s.addressAccess.Unlock()
+	s.closed = true
+	return s.storage.FakeIPSaveMetadata(&adapter.FakeIPMetadata{
 		Inet4Range:   s.inet4Range,
 		Inet6Range:   s.inet6Range,
 		Inet4Current: s.inet4Current,
 		Inet6Current: s.inet6Current,
-	}
-	s.addressAccess.Unlock()
-	return s.storage.FakeIPSaveMetadata(metadata)
+	})
 }
 
 func (s *Store) Create(domain string, isIPv6 bool) (netip.Addr, error) {
@@ -117,38 +135,48 @@ func (s *Store) Create(domain string, isIPv6 bool) (netip.Addr, error) {
 		return address, nil
 	}
 
+	if s.closed {
+		return netip.Addr{}, E.New("fakeip store closed")
+	}
+	if !isIPv6 && !s.inet4Current.IsValid() {
+		return netip.Addr{}, E.New("missing IPv4 fakeip address range")
+	} else if isIPv6 && !s.inet6Current.IsValid() {
+		return netip.Addr{}, E.New("missing IPv6 fakeip address range")
+	}
+	inet4Current, inet6Current := s.inet4Current, s.inet6Current
 	var address netip.Addr
 	if !isIPv6 {
-		if !s.inet4Current.IsValid() {
-			return netip.Addr{}, E.New("missing IPv4 fakeip address range")
-		}
-		nextAddress := s.inet4Current.Next()
-		if nextAddress == s.inet4Last || !s.inet4Range.Contains(nextAddress) {
-			nextAddress = s.inet4Range.Addr().Next().Next()
-		}
-		s.inet4Current = nextAddress
-		address = nextAddress
+		inet4Current = nextAddress(s.inet4Range, s.inet4Last, inet4Current)
+		address = inet4Current
 	} else {
-		if !s.inet6Current.IsValid() {
-			return netip.Addr{}, E.New("missing IPv6 fakeip address range")
+		inet6Current = nextAddress(s.inet6Range, s.inet6Last, inet6Current)
+		address = inet6Current
+	}
+	if storage, isAtomic := s.storage.(fakeIPAtomicStorage); isAtomic {
+		// an address that is not saved is not given out: a client would reach nothing
+		// with it after a restart ("missing fakeip record")
+		err := storage.FakeIPStoreWithMetadata(address, domain, &adapter.FakeIPMetadata{
+			Inet4Range:   s.inet4Range,
+			Inet6Range:   s.inet6Range,
+			Inet4Current: inet4Current,
+			Inet6Current: inet6Current,
+		})
+		if err != nil {
+			return netip.Addr{}, E.Cause(err, "save FakeIP address")
 		}
-		nextAddress := s.inet6Current.Next()
-		if nextAddress == s.inet6Last || !s.inet6Range.Contains(nextAddress) {
-			nextAddress = s.inet6Range.Addr().Next().Next()
+	} else {
+		err := s.storage.FakeIPStore(address, domain)
+		if err != nil {
+			s.logger.Warn("save FakeIP cache: ", err)
 		}
-		s.inet6Current = nextAddress
-		address = nextAddress
-	}
-	err := s.storage.FakeIPStore(address, domain)
-	if err != nil {
-		s.logger.Warn("save FakeIP cache: ", err)
+		s.storage.FakeIPSaveMetadataAsync(&adapter.FakeIPMetadata{
+			Inet4Range:   s.inet4Range,
+			Inet6Range:   s.inet6Range,
+			Inet4Current: inet4Current,
+			Inet6Current: inet6Current,
+		})
 	}
-	s.storage.FakeIPSaveMetadataAsync(&adapter.FakeIPMetadata{
-		Inet4Range:   s.inet4Range,
-		Inet6Range:   s.inet6Range,
-		Inet4Current: s.inet4Current,
-		Inet6Current: s.inet6Current,
-	})
+	s.inet4Current, s.inet6Current = inet4Current, inet6Current
 	return address, nil
 }
 
diff --git a/experimental/cachefile/fakeip.go b/experimental/cachefile/fakeip.go
index 0eff2ebef..91d391fd0 100644
--- a/experimental/cachefile/fakeip.go
+++ b/experimental/cachefile/fakeip.go
@@ -1,6 +1,7 @@
 package cachefile
 
 import (
+	"bytes"
 	"net/netip"
 	"os"
 	"time"
@@ -19,22 +20,35 @@ var (
 	bucketFakeIPDomain4 = []byte(fakeipBucketPrefix + "domain4")
 	bucketFakeIPDomain6 = []byte(fakeipBucketPrefix + "domain6")
 	keyMetadata         = []byte(fakeipBucketPrefix + "metadata")
+	// the allocation position, written together with every new address (podkop-engine);
+	// a bucket of its own keeps the commit small (no leaf page of the address bucket)
+	bucketFakeIPCursor = []byte(fakeipBucketPrefix + "cursor")
 )
 
+// FakeIPMetadata returns the allocation position: the one written with the last address
+// given out, else the one saved on a clean stop (as before podkop-engine r6). The latter
+// is removed as it was: it stays valid only until this process gives out an address.
 func (c *CacheFile) FakeIPMetadata() *adapter.FakeIPMetadata {
 	var metadata adapter.FakeIPMetadata
-	err := c.batch(func(tx *bbolt.Tx) error {
-		bucket := tx.Bucket(bucketFakeIP)
-		if bucket == nil {
-			return os.ErrNotExist
+	err := c.update(func(tx *bbolt.Tx) error {
+		var metadataBinary []byte
+		if bucket := tx.Bucket(bucketFakeIP); bucket != nil {
+			metadataBinary = bucket.Get(keyMetadata)
+			if len(metadataBinary) > 0 {
+				metadataBinary = append([]byte(nil), metadataBinary...)
+				err := bucket.Delete(keyMetadata)
+				if err != nil {
+					return err
+				}
+			}
 		}
-		metadataBinary := bucket.Get(keyMetadata)
-		if len(metadataBinary) == 0 {
-			return os.ErrInvalid
+		if bucket := tx.Bucket(bucketFakeIPCursor); bucket != nil {
+			if cursorBinary := bucket.Get(keyMetadata); len(cursorBinary) > 0 {
+				metadataBinary = cursorBinary
+			}
 		}
-		err := bucket.Delete(keyMetadata)
-		if err != nil {
-			return err
+		if len(metadataBinary) == 0 {
+			return os.ErrNotExist
 		}
 		return metadata.UnmarshalBinary(metadataBinary)
 	})
@@ -44,20 +58,52 @@ func (c *CacheFile) FakeIPMetadata() *adapter.FakeIPMetadata {
 	return &metadata
 }
 
+// FakeIPSaveMetadata saves the position on a clean stop, also where versions before
+// podkop-engine r6 read it.
 func (c *CacheFile) FakeIPSaveMetadata(metadata *adapter.FakeIPMetadata) error {
-	return c.batch(func(tx *bbolt.Tx) error {
+	metadataBinary, err := metadata.MarshalBinary()
+	if err != nil {
+		return err
+	}
+	return c.update(func(tx *bbolt.Tx) error {
 		bucket, err := tx.CreateBucketIfNotExists(bucketFakeIP)
 		if err != nil {
 			return err
 		}
-		metadataBinary, err := metadata.MarshalBinary()
+		err = bucket.Put(keyMetadata, metadataBinary)
 		if err != nil {
 			return err
 		}
-		return bucket.Put(keyMetadata, metadataBinary)
+		return putFakeIPCursor(tx, metadataBinary)
 	})
 }
 
+// FakeIPStoreWithMetadata saves a new address and the allocation position in one
+// transaction, written at once: after a crash the position is never behind an address
+// that was given out. Not a batch: the store gives out addresses one at a time, a batch
+// would only wait for writes that cannot come.
+func (c *CacheFile) FakeIPStoreWithMetadata(address netip.Addr, domain string, metadata *adapter.FakeIPMetadata) error {
+	metadataBinary, err := metadata.MarshalBinary()
+	if err != nil {
+		return err
+	}
+	return c.update(func(tx *bbolt.Tx) error {
+		err := putFakeIP(tx, address, domain)
+		if err != nil {
+			return err
+		}
+		return putFakeIPCursor(tx, metadataBinary)
+	})
+}
+
+func putFakeIPCursor(tx *bbolt.Tx, metadataBinary []byte) error {
+	bucket, err := tx.CreateBucketIfNotExists(bucketFakeIPCursor)
+	if err != nil {
+		return err
+	}
+	return bucket.Put(keyMetadata, metadataBinary)
+}
+
 func (c *CacheFile) FakeIPSaveMetadataAsync(metadata *adapter.FakeIPMetadata) {
 	c.saveMetadataAccess.Lock()
 	defer c.saveMetadataAccess.Unlock()
@@ -78,30 +124,35 @@ func (c *CacheFile) FakeIPSaveMetadataAsync(metadata *adapter.FakeIPMetadata) {
 
 func (c *CacheFile) FakeIPStore(address netip.Addr, domain string) error {
 	return c.batch(func(tx *bbolt.Tx) error {
-		bucket, err := tx.CreateBucketIfNotExists(bucketFakeIP)
-		if err != nil {
-			return err
-		}
-		oldDomain := bucket.Get(address.AsSlice())
-		err = bucket.Put(address.AsSlice(), []byte(domain))
-		if err != nil {
-			return err
-		}
-		if address.Is4() {
-			bucket, err = tx.CreateBucketIfNotExists(bucketFakeIPDomain4)
-		} else {
-			bucket, err = tx.CreateBucketIfNotExists(bucketFakeIPDomain6)
-		}
-		if err != nil {
+		return putFakeIP(tx, address, domain)
+	})
+}
+
+func putFakeIP(tx *bbolt.Tx, address netip.Addr, domain string) error {
+	bucket, err := tx.CreateBucketIfNotExists(bucketFakeIP)
+	if err != nil {
+		return err
+	}
+	oldDomain := bucket.Get(address.AsSlice())
+	err = bucket.Put(address.AsSlice(), []byte(domain))
+	if err != nil {
+		return err
+	}
+	if address.Is4() {
+		bucket, err = tx.CreateBucketIfNotExists(bucketFakeIPDomain4)
+	} else {
+		bucket, err = tx.CreateBucketIfNotExists(bucketFakeIPDomain6)
+	}
+	if err != nil {
+		return err
+	}
+	// the old name may point to another address by now
+	if oldDomain != nil && bytes.Equal(bucket.Get(oldDomain), address.AsSlice()) {
+		if err := bucket.Delete(oldDomain); err != nil {
 			return err
 		}
-		if oldDomain != nil {
-			if err := bucket.Delete(oldDomain); err != nil {
-				return err
-			}
-		}
-		return bucket.Put([]byte(domain), address.AsSlice())
-	})
+	}
+	return bucket.Put([]byte(domain), address.AsSlice())
 }
 
 func (c *CacheFile) FakeIPStoreAsync(address netip.Addr, domain string, logger logger.Logger) {
