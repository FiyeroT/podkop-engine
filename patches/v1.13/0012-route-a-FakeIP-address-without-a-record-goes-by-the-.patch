From dc9284098234adcb265bc55d36b18ed27db9877e Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Fri, 2 Oct 2026 06:52:30 +0300
Subject: [PATCH 12/66] route: a FakeIP address without a record goes by the
 sniffed domain

A connection to a FakeIP address the store has no record for was refused
("missing fakeip record"). The store has no record when the address was
given out just before a crash, when it was released as unused while a
client still kept it, or when the cache file was lost; the client keeps
the address for as long as its DNS cache does.

Such a connection is no longer refused at once. If a sniff rule finds the
domain the client names itself (TLS SNI, HTTP Host, QUIC), the connection
goes to that domain as if the record were there: the destination becomes
the domain, and the rules after the sniff rule see it. Without a sniff
rule, or when the client names no domain within the sniff timeout, it is
refused as before, once the rules are through.

Lab (podkop, 100 names, their records gone): TLS 100 of 100 and HTTP 100 of
100 connections reach their own domain, 100 of 100 connections that name no
domain are refused. QUIC is not tested.
---
 route/route.go | 39 +++++++++++++++++++++++++++++++++++----
 1 file changed, 35 insertions(+), 4 deletions(-)

diff --git a/route/route.go b/route/route.go
index 5fadff0a4..888086a34 100644
--- a/route/route.go
+++ b/route/route.go
@@ -400,6 +400,11 @@ func (r *Router) PreMatch(metadata adapter.InboundContext, routeContext tun.Dire
 	return directRouteOutbound.NewDirectRouteConnection(metadata, routeContext, timeout)
 }
 
+// errMissingFakeIPRecord: a connection to a FakeIP address the store has no record for. The
+// store forgets an address that was given out shortly before a crash, or that nobody used
+// for a long time; a client may still hold it.
+var errMissingFakeIPRecord = E.New("missing fakeip record")
+
 func (r *Router) matchRule(
 	ctx context.Context, metadata *adapter.InboundContext, preMatch bool, supportBypass bool,
 	inputConn net.Conn, inputPacketConn N.PacketConn,
@@ -408,13 +413,29 @@ func (r *Router) matchRule(
 	buffers []*buf.Buffer, packetBuffers []*N.PacketBuffer, fatalErr error,
 ) {
 	r.searchProcessInfo(ctx, metadata)
+	// A connection to a FakeIP address without a record is not refused at once: if a rule
+	// sniffs it and the client names the domain itself (TLS, HTTP, QUIC), that domain is
+	// where it goes, as if the record were there. Without a name it is refused once the
+	// rules are through.
+	var missingFakeIP bool
 	if metadata.Destination.Addr.IsValid() && r.dnsTransport.FakeIP() != nil && r.dnsTransport.FakeIP().Store().Contains(metadata.Destination.Addr) {
 		domain, loaded := r.dnsTransport.FakeIP().Store().Lookup(metadata.Destination.Addr)
 		if !loaded {
-			fatalErr = E.New("missing fakeip record, try enable `experimental.cache_file`")
-			return
-		}
-		if domain != "" {
+			if preMatch {
+				fatalErr = errMissingFakeIPRecord
+				return
+			}
+			missingFakeIP = true
+			defer func() {
+				if missingFakeIP && fatalErr == nil {
+					selectedRule = nil
+					buf.ReleaseMulti(buffers)
+					N.ReleaseMultiPacketBuffer(packetBuffers)
+					buffers, packetBuffers = nil, nil
+					fatalErr = errMissingFakeIPRecord
+				}
+			}()
+		} else if domain != "" {
 			metadata.OriginDestination = metadata.Destination
 			metadata.Destination = M.Socksaddr{
 				Fqdn: domain,
@@ -529,6 +550,16 @@ match:
 					fatalErr = newErr
 					return
 				}
+				if missingFakeIP && M.IsDomainName(metadata.Domain) {
+					missingFakeIP = false
+					metadata.OriginDestination = metadata.Destination
+					metadata.Destination = M.Socksaddr{
+						Fqdn: metadata.Domain,
+						Port: metadata.Destination.Port,
+					}
+					metadata.FakeIP = true
+					r.logger.InfoContext(ctx, "missing fakeip record, sniffed domain used: ", metadata.Domain)
+				}
 			} else if metadata.Network != N.NetworkICMP {
 				selectedRule = currentRule
 				selectedRuleIndex = currentRuleIndex
