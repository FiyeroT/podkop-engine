From 0bcbdc10b4437fbf8a020eac16e67571782f9043 Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Sat, 3 Oct 2026 06:19:26 +0300
Subject: [PATCH 20/44] urltest: test each member every interval, not every
 other one

A member is skipped in a round when its test result is younger than the
interval, so that a member shared by several groups is tested once per
round. The group's own result from the previous round is younger than the
interval too (it is stored when that test finishes, after the round began),
so every other round skipped it: a healthy member was tested once per two
intervals, and a member that died silently stayed selected for up to two
intervals plus the test timeout.

A test takes at most C.TCPTimeout, so the group's own result is at least
interval - C.TCPTimeout old when the next round begins; only a younger
result comes from another group within this round.
---
 protocol/group/urltest.go               |  6 +-
 protocol/group/urltest_interval_test.go | 96 +++++++++++++++++++++++++
 2 files changed, 101 insertions(+), 1 deletion(-)
 create mode 100644 protocol/group/urltest_interval_test.go

diff --git a/protocol/group/urltest.go b/protocol/group/urltest.go
index 98d29a191..15283f153 100644
--- a/protocol/group/urltest.go
+++ b/protocol/group/urltest.go
@@ -395,8 +395,12 @@ func (g *URLTestGroup) urlTest(ctx context.Context, force bool) (map[string]uint
 		if checked[realTag] {
 			continue
 		}
+		// A member that some group tested within this round is not tested again. The
+		// group's own test from the previous round must not count: it finished at most one
+		// test timeout after that round began, so it is at least interval minus that timeout
+		// old. Comparing with the whole interval made every other round skip it.
 		history := g.history.LoadURLTestHistory(realTag)
-		if !force && history != nil && time.Since(history.Time) < g.interval {
+		if !force && history != nil && time.Since(history.Time) < g.interval-C.TCPTimeout {
 			continue
 		}
 		checked[realTag] = true
diff --git a/protocol/group/urltest_interval_test.go b/protocol/group/urltest_interval_test.go
new file mode 100644
index 000000000..38c00c5be
--- /dev/null
+++ b/protocol/group/urltest_interval_test.go
@@ -0,0 +1,96 @@
+package group
+
+import (
+	"context"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/adapter/outbound"
+	"github.com/sagernet/sing-box/common/urltest"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/log"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+	"github.com/sagernet/sing/service"
+
+	"github.com/stretchr/testify/require"
+)
+
+type testMember struct {
+	outbound.Adapter
+	dials atomic.Int32
+	dial  func(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error)
+}
+
+func newTestMember(outboundType, tag string, dial func(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error)) *testMember {
+	return &testMember{Adapter: outbound.NewAdapter(outboundType, tag, []string{N.NetworkTCP, N.NetworkUDP}, nil), dial: dial}
+}
+
+func (m *testMember) DialContext(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+	m.dials.Add(1)
+	return m.dial(ctx, network, destination)
+}
+
+func (m *testMember) ListenPacket(ctx context.Context, destination M.Socksaddr) (net.PacketConn, error) {
+	return nil, os.ErrInvalid
+}
+
+func dialWorking(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+	return (&net.Dialer{}).DialContext(ctx, network, destination.String())
+}
+
+// testURL serves the URL test and counts its requests.
+func testURL(t *testing.T, delay time.Duration) (string, *atomic.Int32) {
+	var requests atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		requests.Add(1)
+		time.Sleep(delay)
+		w.WriteHeader(http.StatusNoContent)
+	}))
+	t.Cleanup(server.Close)
+	return server.URL, &requests
+}
+
+// testOutboundManager finds the members of a test group by tag.
+type testOutboundManager struct {
+	adapter.OutboundManager
+	members map[string]adapter.Outbound
+}
+
+func (m *testOutboundManager) Outbound(tag string) (adapter.Outbound, bool) {
+	member, loaded := m.members[tag]
+	return member, loaded
+}
+
+// The periodic test runs every interval: this group's own result from the previous round is
+// not fresh any more, while a result another group got within this round is.
+func TestURLTestFreshness(t *testing.T) {
+	link, _ := testURL(t, 0)
+	interval := time.Minute
+	for _, testCase := range []struct {
+		name   string
+		age    time.Duration
+		tested bool
+	}{
+		{"own result of the previous round", interval - C.TCPTimeout + time.Second, true},
+		{"result of another group in this round", time.Second, false},
+	} {
+		t.Run(testCase.name, func(t *testing.T) {
+			member := newTestMember(C.TypeVLESS, "member", dialWorking)
+			history := urltest.NewHistoryStorage()
+			history.StoreURLTestHistory("member", &adapter.URLTestHistory{Time: time.Now().Add(-testCase.age), Delay: 10})
+			ctx := service.ContextWithPtr(context.Background(), history)
+			manager := &testOutboundManager{members: map[string]adapter.Outbound{"member": member}}
+			group, err := NewURLTestGroup(ctx, manager, log.NewNOPFactory().Logger(), []adapter.Outbound{member}, link, interval, 50, 0, false)
+			require.NoError(t, err)
+			_, _ = group.urlTest(ctx, false)
+			require.Equal(t, testCase.tested, member.dials.Load() > 0)
+		})
+	}
+}
