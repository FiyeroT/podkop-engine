From 1988af6a91ee2d1bc656048279861aab714abf67 Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Sat, 3 Oct 2026 06:57:51 +0300
Subject: [PATCH 22/44] tls: bound the handshake of a TLS dial

A TLS dial (VLESS, Trojan, VMess, AnyTLS, http, and the v2ray transports
over TLS or Reality) ran its handshake with the caller's context, which for a
proxied connection has no deadline. A server that accepts the connection and
never answers the ClientHello, as behind a DPI that drops the ServerHello,
kept every dial through it waiting until the server's TCP gave up, holding
its goroutine and socket, and the dial never failed for urltest to see.

Bound it by C.TCPTimeout, as ClientHandshake already does and as 1.14 does
by default (tls handshake_timeout).
---
 common/tls/client.go      |  8 +++++-
 common/tls/client_test.go | 51 +++++++++++++++++++++++++++++++++++++++
 2 files changed, 58 insertions(+), 1 deletion(-)
 create mode 100644 common/tls/client_test.go

diff --git a/common/tls/client.go b/common/tls/client.go
index 839699547..62b95bba7 100644
--- a/common/tls/client.go
+++ b/common/tls/client.go
@@ -119,7 +119,13 @@ func (d *defaultDialer) dialContext(ctx context.Context, destination M.Socksaddr
 	if err != nil {
 		return nil, err
 	}
-	tlsConn, err := aTLS.ClientHandshake(ctx, conn, d.config)
+	// The handshake is bounded as in ClientHandshake above (and by handshake_timeout in
+	// 1.14, same default): a server that accepts the connection and never answers the
+	// ClientHello kept a dial waiting for as long as its caller did, which for a proxied
+	// connection has no deadline (podkop-engine).
+	handshakeCtx, cancel := context.WithTimeout(ctx, C.TCPTimeout)
+	tlsConn, err := aTLS.ClientHandshake(handshakeCtx, conn, d.config)
+	cancel()
 	if err != nil {
 		conn.Close()
 		var echErr *tls.ECHRejectionError
diff --git a/common/tls/client_test.go b/common/tls/client_test.go
new file mode 100644
index 000000000..79f3c4940
--- /dev/null
+++ b/common/tls/client_test.go
@@ -0,0 +1,51 @@
+package tls
+
+import (
+	"context"
+	"net"
+	"os"
+	"testing"
+	"time"
+
+	C "github.com/sagernet/sing-box/constant"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+	aTLS "github.com/sagernet/sing/common/tls"
+
+	"github.com/stretchr/testify/require"
+)
+
+// handshakeRecorder stands for a TLS client config and records the context its handshake
+// gets.
+type handshakeRecorder struct {
+	Config
+	deadline    time.Time
+	hasDeadline bool
+}
+
+func (c *handshakeRecorder) ClientHandshake(ctx context.Context, conn net.Conn) (aTLS.Conn, error) {
+	c.deadline, c.hasDeadline = ctx.Deadline()
+	return nil, os.ErrInvalid
+}
+
+// A proxied connection's context has no deadline: the dialer still bounds the handshake,
+// or a server that accepts the connection and never answers would keep the dial forever.
+func TestDialerBoundsHandshake(t *testing.T) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	defer listener.Close()
+	go func() {
+		for {
+			conn, err := listener.Accept()
+			if err != nil {
+				return
+			}
+			defer conn.Close()
+		}
+	}()
+	config := &handshakeRecorder{}
+	_, err = NewDialer(N.SystemDialer, config).DialTLSContext(context.Background(), M.SocksaddrFromNet(listener.Addr()))
+	require.Error(t, err)
+	require.True(t, config.hasDeadline, "the handshake has no deadline")
+	require.WithinDuration(t, time.Now().Add(C.TCPTimeout), config.deadline, time.Second)
+}
