From 4bb50e3cd2b8f331cc85762dc3d6d8463e7277e7 Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Sat, 3 Oct 2026 16:05:16 +0300
Subject: [PATCH 025/126] dns/https: reset the transport on a timeout only when
 no later query was answered

A query to DoH that runs out of time reset the whole transport. On 1.14 the reset
closes the connection with every query in flight on it, so one slow name (an
upstream that takes long for one domain) failed the queries of other names; on 1.13
it opened a new connection and left the old one open. Now the timeout resets the
transport only when no query that began after it was answered: a frozen connection
is still dropped at the same moment, a live one is kept.
---
 dns/transport/https.go | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/dns/transport/https.go b/dns/transport/https.go
index 206e6fb8a..6b6d3a4ce 100644
--- a/dns/transport/https.go
+++ b/dns/transport/https.go
@@ -10,6 +10,7 @@ import (
 	"net/url"
 	"strconv"
 	"sync"
+	"sync/atomic"
 	"time"
 
 	"github.com/sagernet/sing-box/adapter"
@@ -48,6 +49,7 @@ type HTTPSTransport struct {
 	transportAccess  sync.Mutex
 	transport        *HTTPSTransportWrapper
 	transportResetAt time.Time
+	answeredStartAt  atomic.Int64 // unix nanoseconds: the latest start among the answered exchanges
 }
 
 func NewHTTPS(ctx context.Context, logger log.ContextLogger, tag string, options option.RemoteHTTPSDNSServerOptions) (adapter.DNSTransport, error) {
@@ -160,6 +162,12 @@ func (t *HTTPSTransport) Exchange(ctx context.Context, message *mDNS.Msg) (*mDNS
 	response, err := t.exchange(ctx, message)
 	if err != nil {
 		if errors.Is(err, context.DeadlineExceeded) {
+			// A query that began after this one was answered: the connection is alive
+			// and the timeout is about this query alone (a slow upstream for one name).
+			// A reset would open a new connection and leave the old one open.
+			if t.answeredStartAt.Load() > startAt.UnixNano() {
+				return nil, err
+			}
 			t.transportAccess.Lock()
 			defer t.transportAccess.Unlock()
 			if t.transportResetAt.After(startAt) {
@@ -171,6 +179,12 @@ func (t *HTTPSTransport) Exchange(ctx context.Context, message *mDNS.Msg) (*mDNS
 		}
 		return nil, err
 	}
+	for started := startAt.UnixNano(); ; {
+		latest := t.answeredStartAt.Load()
+		if started <= latest || t.answeredStartAt.CompareAndSwap(latest, started) {
+			break
+		}
+	}
 	return response, nil
 }
 
