From c7f836b967e4264c6e2a184dbd1ee3343b073029 Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Sat, 3 Oct 2026 16:35:35 +0300
Subject: [PATCH 26/44] tls: release the uTLS handshake state after the
 handshake

A uTLS or REALITY client connection kept the ClientHello, the private keys of
the key shares (the ML-KEM-768 decapsulation key alone takes ~8 KiB) and the
extension objects for its whole life. They are read only while the handshake
runs. Releasing them takes the live heap of an idle VLESS REALITY connection
from 69 to 56 KiB.
---
 common/tls/reality_client.go |  1 +
 common/tls/utls_client.go    | 18 +++++++++++++++++-
 2 files changed, 18 insertions(+), 1 deletion(-)

diff --git a/common/tls/reality_client.go b/common/tls/reality_client.go
index ed4eae126..c7e804702 100644
--- a/common/tls/reality_client.go
+++ b/common/tls/reality_client.go
@@ -219,6 +219,7 @@ func (e *RealityClientConfig) ClientHandshake(ctx context.Context, conn net.Conn
 		return nil, E.New("reality verification failed")
 	}
 
+	releaseHandshakeState(uConn)
 	return &realityClientConnWrapper{uConn}, nil
 }
 
diff --git a/common/tls/utls_client.go b/common/tls/utls_client.go
index a242498d2..706933cd8 100644
--- a/common/tls/utls_client.go
+++ b/common/tls/utls_client.go
@@ -143,7 +143,23 @@ func (c *utlsALPNWrapper) HandshakeContext(ctx context.Context) error {
 			}
 		}
 	}
-	return c.UConn.HandshakeContext(ctx)
+	err := c.UConn.HandshakeContext(ctx)
+	if err != nil {
+		return err
+	}
+	releaseHandshakeState(c.UConn)
+	return nil
+}
+
+// releaseHandshakeState drops what only the handshake reads: the ClientHello, the private
+// keys of the key shares (an ML-KEM-768 decapsulation key takes ~8 KiB) and the extension
+// objects. The connection keeps them for its whole life otherwise; after the handshake
+// uTLS works through the embedded Conn, which does not use them.
+func releaseHandshakeState(uConn *utls.UConn) {
+	uConn.HandshakeState.Hello = nil
+	uConn.HandshakeState.ServerHello = nil
+	uConn.HandshakeState.State13 = utls.TLS13OnlyState{}
+	uConn.Extensions = nil
 }
 
 func NewUTLSClient(ctx context.Context, logger logger.ContextLogger, serverAddress string, options option.OutboundTLSOptions) (Config, error) {
-- 
