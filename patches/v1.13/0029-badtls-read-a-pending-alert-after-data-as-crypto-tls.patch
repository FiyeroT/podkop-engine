From b825c1f78f27beac18805846e6b0beda1e67505b Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Sat, 3 Oct 2026 20:23:36 +0300
Subject: [PATCH 29/44] badtls: read a pending alert after data, as crypto/tls
 does

The check meant to read an alert record that follows the data compared the
length of the decrypted input with zero and above zero at once, so it never ran.
It now looks at the raw input, as Conn.Read of crypto/tls does, and a
close_notify after the last data is seen with that data.
---
 common/badtls/read_wait.go | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/common/badtls/read_wait.go b/common/badtls/read_wait.go
index 8448b1a24..25a8e49dd 100644
--- a/common/badtls/read_wait.go
+++ b/common/badtls/read_wait.go
@@ -62,7 +62,7 @@ func (c *ReadWaitConn) WaitReadBuffer() (buffer *buf.Buffer, err error) {
 	}
 	buffer.Truncate(n)
 
-	if n != 0 && c.rawConn.Input.Len() == 0 && c.rawConn.Input.Len() > 0 &&
+	if n != 0 && c.rawConn.Input.Len() == 0 && c.rawConn.RawInput.Len() > 0 &&
 		// recordType(c.RawInput.Bytes()[0]) == recordTypeAlert {
 		c.rawConn.RawInput.Bytes()[0] == 21 {
 		_ = c.rawConn.ReadRecord()
-- 
