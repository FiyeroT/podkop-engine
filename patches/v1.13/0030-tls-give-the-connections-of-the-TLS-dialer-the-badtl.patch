From 9ca4864337952e771435eaa17de1f4ef3244a647 Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Sat, 3 Oct 2026 20:23:36 +0300
Subject: [PATCH 30/35] tls: give the connections of the TLS dialer the badtls
 read waiter

ClientHandshake wraps a client connection in badtls.ReadWaitConn, but the dialer
that VLESS, Trojan and VMess use returned the bare connection. The copy loop then
took a pool buffer before every blocking read, and an idle proxied connection
held it (32 KiB, 64 KiB after 512 KB) for as long as the server stayed silent;
with the read waiter the buffer is taken once a whole record has arrived. A
connection badtls cannot handle is kept as it is, with one warning, so that a
change in the layout of crypto/tls or utls costs the read waiter, not the dial.

Idle VLESS (no flow) or Trojan connection, live heap: 57 -> 25 KiB after a short
response, 98 -> 33 KiB after a bulk transfer.
---
 common/tls/client.go                | 26 ++++++++-
 common/tls/client_read_wait_test.go | 83 +++++++++++++++++++++++++++++
 2 files changed, 108 insertions(+), 1 deletion(-)
 create mode 100644 common/tls/client_read_wait_test.go

diff --git a/common/tls/client.go b/common/tls/client.go
index 62b95bba7..78fbfb6e7 100644
--- a/common/tls/client.go
+++ b/common/tls/client.go
@@ -6,9 +6,11 @@ import (
 	"errors"
 	"net"
 	"os"
+	"sync"
 
 	"github.com/sagernet/sing-box/common/badtls"
 	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/log"
 	"github.com/sagernet/sing-box/option"
 	"github.com/sagernet/sing/common/logger"
 	M "github.com/sagernet/sing/common/metadata"
@@ -85,6 +87,28 @@ func ClientHandshake(ctx context.Context, conn net.Conn, config Config) (Conn, e
 	return tlsConn, nil
 }
 
+// withReadWait gives a client connection the read waiter of badtls, as ClientHandshake
+// does (podkop-engine): the dialer of the proxy protocols returned the bare connection,
+// so the copy loop took a buffer before every blocking read and an idle proxied
+// connection held it for as long as the server stayed silent. With the read waiter the
+// buffer is taken only once a whole record has arrived. A connection badtls cannot handle
+// is kept as it is, unlike in ClientHandshake: a change in the layout of crypto/tls or
+// utls must cost the read waiter, not every TLS dial.
+func withReadWait(tlsConn Conn) Conn {
+	readWaitConn, err := badtls.NewReadWaitConn(tlsConn)
+	if err == nil {
+		return readWaitConn
+	}
+	if err != os.ErrInvalid {
+		readWaitFailure.Do(func() {
+			log.StdLogger().Warn("TLS read waiter unavailable: ", err)
+		})
+	}
+	return tlsConn
+}
+
+var readWaitFailure sync.Once
+
 type Dialer interface {
 	N.Dialer
 	DialTLSContext(ctx context.Context, destination M.Socksaddr) (Conn, error)
@@ -137,7 +161,7 @@ func (d *defaultDialer) dialContext(ctx context.Context, destination M.Socksaddr
 		}
 		return nil, err
 	}
-	return tlsConn, nil
+	return withReadWait(tlsConn), nil
 }
 
 func (d *defaultDialer) Upstream() any {
diff --git a/common/tls/client_read_wait_test.go b/common/tls/client_read_wait_test.go
new file mode 100644
index 000000000..8f6fdb43d
--- /dev/null
+++ b/common/tls/client_read_wait_test.go
@@ -0,0 +1,83 @@
+//go:build go1.25 && badlinkname
+
+package tls
+
+import (
+	"context"
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/tls"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"math/big"
+	"net"
+	"testing"
+	"time"
+
+	N "github.com/sagernet/sing/common/network"
+
+	"github.com/stretchr/testify/require"
+)
+
+func testCertificate(t *testing.T) tls.Certificate {
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	require.NoError(t, err)
+	template := &x509.Certificate{
+		SerialNumber: big.NewInt(1),
+		Subject:      pkix.Name{CommonName: "test"},
+		NotBefore:    time.Now().Add(-time.Hour),
+		NotAfter:     time.Now().Add(time.Hour),
+	}
+	der, err := x509.CreateCertificate(rand.Reader, template, template, &key.PublicKey, key)
+	require.NoError(t, err)
+	return tls.Certificate{Certificate: [][]byte{der}, PrivateKey: key}
+}
+
+// A connection from the dialer reads through the read waiter of badtls: the copy loop takes
+// a buffer only once a record has arrived, not before it waits.
+func TestWithReadWait(t *testing.T) {
+	serverSide, clientSide := net.Pipe()
+	defer serverSide.Close()
+	defer clientSide.Close()
+	certificate := testCertificate(t)
+	go func() {
+		server := tls.Server(serverSide, &tls.Config{Certificates: []tls.Certificate{certificate}})
+		server.Write([]byte("hello"))
+	}()
+	client := tls.Client(clientSide, &tls.Config{InsecureSkipVerify: true})
+	require.NoError(t, client.HandshakeContext(context.Background()))
+
+	readWaiter, isReadWaiter := withReadWait(client).(N.ReadWaiter)
+	require.True(t, isReadWaiter, "the dialer's connection has no read waiter")
+	require.False(t, readWaiter.InitializeReadWaiter(N.ReadWaitOptions{}), "the read waiter asks for a copy")
+	buffer, err := readWaiter.WaitReadBuffer()
+	require.NoError(t, err)
+	require.Equal(t, "hello", string(buffer.Bytes()))
+	buffer.Release()
+}
+
+type plainConn struct {
+	net.Conn
+}
+
+func (c plainConn) NetConn() net.Conn {
+	return c.Conn
+}
+
+func (c plainConn) HandshakeContext(context.Context) error {
+	return nil
+}
+
+func (c plainConn) ConnectionState() tls.ConnectionState {
+	return tls.ConnectionState{}
+}
+
+// A connection badtls does not know stays as it is, and the dial goes on.
+func TestWithReadWaitUnknownConn(t *testing.T) {
+	side, peer := net.Pipe()
+	defer side.Close()
+	defer peer.Close()
+	conn := plainConn{side}
+	require.Equal(t, Conn(conn), withReadWait(conn))
+}
