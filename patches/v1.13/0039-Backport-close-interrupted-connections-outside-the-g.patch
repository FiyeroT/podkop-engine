From f1ae2b099563949e8ff51c8d6c83a3949395cb60 Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Sun, 4 Oct 2026 08:35:42 +0300
Subject: [PATCH 39/44] Backport: close interrupted connections outside the
 group lock (upstream d2cf9747d)

From the stable branch after 1.14.2. Interrupt closed every connection while
holding the group's lock, and a connection's Close took the same lock: a
close that blocked (a TLS close_notify on a stalled link) held up every new
connection of the group and every other close until it returned. Now the
connections are taken off the list under the lock and closed after it.
---
 common/interrupt/conn.go  |  4 ++--
 common/interrupt/group.go | 16 +++++++++-------
 2 files changed, 11 insertions(+), 9 deletions(-)

diff --git a/common/interrupt/conn.go b/common/interrupt/conn.go
index 6a6d31c68..4c7810a6c 100644
--- a/common/interrupt/conn.go
+++ b/common/interrupt/conn.go
@@ -28,8 +28,8 @@ type Conn struct {
 
 func (c *Conn) Close() error {
 	c.group.access.Lock()
-	defer c.group.access.Unlock()
 	c.group.connections.Remove(c.element)
+	c.group.access.Unlock()
 	return c.Conn.Close()
 }
 
@@ -57,8 +57,8 @@ type PacketConn struct {
 
 func (c *PacketConn) Close() error {
 	c.group.access.Lock()
-	defer c.group.access.Unlock()
 	c.group.connections.Remove(c.element)
+	c.group.access.Unlock()
 	return c.PacketConn.Close()
 }
 
diff --git a/common/interrupt/group.go b/common/interrupt/group.go
index ba2e7f739..cbb63310d 100644
--- a/common/interrupt/group.go
+++ b/common/interrupt/group.go
@@ -38,15 +38,17 @@ func (g *Group) NewPacketConn(conn net.PacketConn, isExternal bool) net.PacketCo
 
 func (g *Group) Interrupt(interruptExternalConnections bool) {
 	g.access.Lock()
-	defer g.access.Unlock()
-	var toDelete []*list.Element[*groupConnItem]
-	for element := g.connections.Front(); element != nil; element = element.Next() {
+	var closers []io.Closer
+	for element := g.connections.Front(); element != nil; {
+		nextElement := element.Next()
 		if !element.Value.isExternal || interruptExternalConnections {
-			element.Value.conn.Close()
-			toDelete = append(toDelete, element)
+			closers = append(closers, element.Value.conn)
+			g.connections.Remove(element)
 		}
+		element = nextElement
 	}
-	for _, element := range toDelete {
-		g.connections.Remove(element)
+	g.access.Unlock()
+	for _, closer := range closers {
+		closer.Close()
 	}
 }
-- 
