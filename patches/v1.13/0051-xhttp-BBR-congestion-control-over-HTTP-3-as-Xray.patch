From 3798758964bdb04eb14874e7d3ec8a563a49228a Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Mon, 5 Oct 2026 13:36:55 +0300
Subject: [PATCH 051/104] xhttp: BBR congestion control over HTTP/3, as Xray

---
 transport/v2rayxhttp/http3.go | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/transport/v2rayxhttp/http3.go b/transport/v2rayxhttp/http3.go
index 89e0b56c5..a1aeab444 100644
--- a/transport/v2rayxhttp/http3.go
+++ b/transport/v2rayxhttp/http3.go
@@ -9,8 +9,11 @@ import (
 	"time"
 
 	"github.com/sagernet/quic-go"
+	"github.com/sagernet/quic-go/congestion"
 	"github.com/sagernet/quic-go/http3"
 	"github.com/sagernet/sing-box/common/tls"
+	congestion_meta1 "github.com/sagernet/sing-quic/congestion_meta1"
+	congestion_meta2 "github.com/sagernet/sing-quic/congestion_meta2"
 	"github.com/sagernet/sing/common/bufio"
 	E "github.com/sagernet/sing/common/exceptions"
 	M "github.com/sagernet/sing/common/metadata"
@@ -65,6 +68,12 @@ func newHTTP3Connections(dialer N.Dialer, serverAddr M.Socksaddr, tlsConfig tls.
 				context.AfterFunc(quicConn.Context(), func() {
 					conn.Close()
 				})
+				// BBR, as Xray's HTTP/3 uses.
+				quicConn.SetCongestionControl(congestion_meta2.NewBbrSender(
+					congestion_meta2.DefaultClock{TimeFunc: time.Now},
+					congestion.ByteCount(quicConn.Config().InitialPacketSize),
+					congestion.ByteCount(congestion_meta1.InitialCongestionWindow),
+				))
 				return quicConn, nil
 			},
 		}}
