From 429cbe20e28fce3d0b14092eec73d83eedabd6f8 Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Tue, 6 Oct 2026 23:53:23 +0300
Subject: [PATCH 068/118] v2ray: state and test that Close of a client
 transport is a reset

The outbounds call Close of their transport from InterfaceUpdated on every change of the
network and dial through it again afterwards. Every transport has to allow that, yet the
contract was written nowhere and no test dialed after a Close, which is how a transport
whose Close was final went unnoticed.

A comment at adapter.V2RayClientTransport states the contract. A table test builds every
client transport of the build through NewClientTransport (ws, httpupgrade, http, grpc,
xhttp over HTTP/1.1, HTTP/2 and HTTP/3 and with a download server, quic) over a dialer
that fails, and checks that a dial after one Close and after two in a row still goes out
to the server and reports the failure of the dialer, never a closed transport.

With the tag with_grpc the grpc rows are skipped and the lite client is tested through
force_lite: the client of grpc-go connects under the context of the transport and does
not return while its server cannot be reached.
---
 adapter/v2ray.go                       |   8 ++
 transport/v2ray/transport_grpc_test.go |  25 +++++
 transport/v2ray/transport_quic_test.go |  16 +++
 transport/v2ray/transport_test.go      | 131 +++++++++++++++++++++++++
 4 files changed, 180 insertions(+)
 create mode 100644 transport/v2ray/transport_grpc_test.go
 create mode 100644 transport/v2ray/transport_quic_test.go
 create mode 100644 transport/v2ray/transport_test.go

diff --git a/adapter/v2ray.go b/adapter/v2ray.go
index d9370807f..d0add2593 100644
--- a/adapter/v2ray.go
+++ b/adapter/v2ray.go
@@ -18,6 +18,14 @@ type V2RayServerTransportHandler interface {
 	N.TCPConnectionHandlerEx
 }
 
+// V2RayClientTransport is the client side of a V2Ray transport, owned by an
+// outbound.
+//
+// Close is a reset, not an end: it closes the connections the transport keeps
+// and leaves the transport usable. The outbounds call it from InterfaceUpdated
+// on every change of the network, before the first dial as well and any number
+// of times, and once more when they close. DialContext after a Close must open
+// a new connection and must not fail for the Close.
 type V2RayClientTransport interface {
 	DialContext(ctx context.Context) (net.Conn, error)
 	Close() error
diff --git a/transport/v2ray/transport_grpc_test.go b/transport/v2ray/transport_grpc_test.go
new file mode 100644
index 000000000..f61c1214b
--- /dev/null
+++ b/transport/v2ray/transport_grpc_test.go
@@ -0,0 +1,25 @@
+//go:build with_grpc
+
+package v2ray_test
+
+import (
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/option"
+)
+
+func init() {
+	for i, c := range clientTransportCases {
+		if c.options.Type == C.V2RayTransportTypeGRPC {
+			// With this tag "grpc" is the client of grpc-go, which connects under
+			// the context of the transport and waits for the server for as long
+			// as that lives: with a dialer that only fails, its dial never
+			// returns.
+			clientTransportCases[i].skip = "the grpc-go client waits for its server"
+		}
+	}
+	forceLite := option.V2RayTransportOptions{Type: C.V2RayTransportTypeGRPC, GRPCOptions: option.V2RayGRPCOptions{ForceLite: true}}
+	clientTransportCases = append(clientTransportCases,
+		clientTransportCase{name: "grpc, lite", options: forceLite},
+		clientTransportCase{name: "grpc, lite, TLS", options: forceLite, alpn: []string{}},
+	)
+}
