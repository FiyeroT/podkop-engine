From b574cd838a2b8e198ff49d20a8579cd54c36d6e4 Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Tue, 6 Oct 2026 23:37:26 +0300
Subject: [PATCH 083/118] tls: do not rebuild the Client Hello after the
 handshake

The uTLS connection with ALPN rebuilds its Client Hello in HandshakeContext, and the
handshake state is released once the handshake is done: a second call would dereference
the released Client Hello. No caller does that today. The call now goes straight to the
connection, which reports the finished handshake.
---
 common/tls/reality_fingerprint_test.go | 38 ++++++++++++++++++++++++++
 common/tls/utls_client.go              |  5 ++++
 2 files changed, 43 insertions(+)

diff --git a/common/tls/reality_fingerprint_test.go b/common/tls/reality_fingerprint_test.go
index 1d6ab8373..c448ac0fe 100644
--- a/common/tls/reality_fingerprint_test.go
+++ b/common/tls/reality_fingerprint_test.go
@@ -345,3 +345,41 @@ func TestRealityRejectedCertificateNamesFingerprint(t *testing.T) {
 		})
 	}
 }
+
+// The handshake state is released once the handshake is done. A second HandshakeContext
+// on a connection with ALPN has no Client Hello to rebuild and reports the finished
+// handshake instead.
+func TestUTLSALPNHandshakeAgainAfterRelease(t *testing.T) {
+	rootKey, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	require.NoError(t, err)
+	template := &x509.Certificate{
+		SerialNumber: big.NewInt(1),
+		Subject:      pkix.Name{CommonName: "example.org"},
+		DNSNames:     []string{"example.org"},
+		NotBefore:    time.Now().Add(-time.Hour),
+		NotAfter:     time.Now().Add(time.Hour),
+	}
+	der, err := x509.CreateCertificate(rand.Reader, template, template, &rootKey.PublicKey, rootKey)
+	require.NoError(t, err)
+
+	options := realityOptionsForTest("chrome", false)
+	options.Insecure = true
+	options.ALPN = []string{"h2", "http/1.1"}
+	config, err := NewClient(context.Background(), nil, "example.org", options)
+	require.NoError(t, err)
+	client, server := net.Pipe()
+	defer client.Close()
+	plainTLSServer(t, server, tls.Certificate{Certificate: [][]byte{der}, PrivateKey: rootKey})
+
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+	defer cancel()
+	conn, err := config.Client(client)
+	require.NoError(t, err)
+	require.IsType(t, &utlsALPNWrapper{}, conn)
+	require.NoError(t, conn.HandshakeContext(ctx))
+	require.Nil(t, conn.(*utlsALPNWrapper).HandshakeState.Hello)
+	require.NotPanics(t, func() {
+		require.NoError(t, conn.HandshakeContext(ctx))
+	})
+	require.True(t, conn.ConnectionState().HandshakeComplete)
+}
diff --git a/common/tls/utls_client.go b/common/tls/utls_client.go
index 706933cd8..c1f831da6 100644
--- a/common/tls/utls_client.go
+++ b/common/tls/utls_client.go
@@ -127,6 +127,11 @@ type utlsALPNWrapper struct {
 }
 
 func (c *utlsALPNWrapper) HandshakeContext(ctx context.Context) error {
+	if c.UConn.HandshakeState.Hello == nil {
+		// the handshake is done and its state released (releaseHandshakeState): there is
+		// no Client Hello to rebuild, the connection only reports that it is complete
+		return c.UConn.HandshakeContext(ctx)
+	}
 	if len(c.nextProtocols) > 0 {
 		err := c.BuildHandshakeState()
 		if err != nil {
