From 98565fada63dbf489d6c70083bc5f109501e099b Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Thu, 8 Oct 2026 15:11:05 +0300
Subject: [PATCH 089/104] rule-set: download as an external connection

A urltest or selector group that switches members closes every connection
it does not know as a routed one, whatever interrupt_exist_connections
says. A rule-set downloaded through the group was cut and, when the set
had been loaded before, retried only after update_interval.

Mark the download context as external, as routed connections are.
---
 route/rule/rule_set_remote.go           |  4 ++++
 route/rule/rule_set_remote_body_test.go | 28 +++++++++++++++++++++++++
 2 files changed, 32 insertions(+)

diff --git a/route/rule/rule_set_remote.go b/route/rule/rule_set_remote.go
index b3e91cb40..dce65fdab 100644
--- a/route/rule/rule_set_remote.go
+++ b/route/rule/rule_set_remote.go
@@ -17,6 +17,7 @@ import (
 	"time"
 
 	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/interrupt"
 	"github.com/sagernet/sing-box/common/srs"
 	C "github.com/sagernet/sing-box/constant"
 	"github.com/sagernet/sing-box/option"
@@ -405,6 +406,9 @@ func describeRuleSetBody(response *http.Response, size int64, sample []byte) str
 
 func (s *RemoteRuleSet) fetch(ctx context.Context, startContext *adapter.HTTPStartContext) error {
 	s.logger.Debug("updating rule-set ", s.options.Tag, " from URL: ", s.options.RemoteOptions.URL)
+	// a group that switches members closes the connections it does not know as routed
+	// ones: a list half downloaded through it would wait for the next update_interval
+	ctx = interrupt.ContextWithIsExternalConnection(ctx)
 	ctx, cancel := context.WithCancel(ctx)
 	defer cancel()
 	if startContext != nil {
diff --git a/route/rule/rule_set_remote_body_test.go b/route/rule/rule_set_remote_body_test.go
index 0074cb9b1..970e73913 100644
--- a/route/rule/rule_set_remote_body_test.go
+++ b/route/rule/rule_set_remote_body_test.go
@@ -3,6 +3,7 @@ package rule
 import (
 	"context"
 	"io"
+	"net"
 	"net/http"
 	"net/http/httptest"
 	"strconv"
@@ -10,8 +11,10 @@ import (
 	"testing"
 	"time"
 
+	"github.com/sagernet/sing-box/common/interrupt"
 	C "github.com/sagernet/sing-box/constant"
 	"github.com/sagernet/sing-box/log"
+	M "github.com/sagernet/sing/common/metadata"
 
 	"github.com/stretchr/testify/require"
 )
@@ -130,3 +133,28 @@ func TestRemoteRuleSetUpdateCancelledByShutdown(t *testing.T) {
 	require.Zero(t, set.failures)
 	require.Zero(t, countPrefix(writer.take(), "ERROR"))
 }
+
+// The download is dialed as an external connection, so that a group switching members does
+// not close it together with its own connections.
+func TestRemoteRuleSetFetchIsExternalConnection(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		io.WriteString(w, testSourceSet)
+	}))
+	defer server.Close()
+	dialer := &recordingDialer{}
+	set := newTestRuleSet(server.URL)
+	set.dialer = dialer
+	set.options.Format = C.RuleSetFormatSource
+	require.NoError(t, set.fetch(context.Background(), nil))
+	require.True(t, dialer.external)
+}
+
+type recordingDialer struct {
+	testDialer
+	external bool
+}
+
+func (d *recordingDialer) DialContext(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+	d.external = interrupt.IsExternalConnectionFromContext(ctx)
+	return d.testDialer.DialContext(ctx, network, destination)
+}
