From 2564cbf82aa301a1749e824b45d3a2549fc4b71f Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Thu, 8 Oct 2026 16:45:53 +0300
Subject: [PATCH 092/126] clashapi: drop the sniffer state from a tracker's
 metadata

A tracker keeps a copy of the connection's metadata for as long as the connection
lives, and then in the list of closed connections. The copy carried what only routing
reads: the sniffer's working state (for QUIC, the client hello fragments collected so
far) and its error. The connection list shows none of it.
---
 .../clashapi/trafficontrol/tracker.go         | 10 +++++++
 .../trafficontrol/tracker_metadata_test.go    | 29 +++++++++++++++++++
 2 files changed, 39 insertions(+)
 create mode 100644 experimental/clashapi/trafficontrol/tracker_metadata_test.go

diff --git a/experimental/clashapi/trafficontrol/tracker.go b/experimental/clashapi/trafficontrol/tracker.go
index f001b77b2..f128d1e85 100644
--- a/experimental/clashapi/trafficontrol/tracker.go
+++ b/experimental/clashapi/trafficontrol/tracker.go
@@ -118,8 +118,17 @@ func (tt *TCPConn) WriterReplaceable() bool {
 	return true
 }
 
+// trimTrackedMetadata drops from the tracker's copy what only routing needed: the sniffer's
+// working state (for QUIC, the fragments of the client hello collected so far). A tracker
+// lives as long as its connection, and then in the list of closed connections.
+func trimTrackedMetadata(metadata *adapter.InboundContext) {
+	metadata.SniffContext = nil
+	metadata.SniffError = nil
+}
+
 func NewTCPTracker(conn net.Conn, manager *Manager, metadata adapter.InboundContext, outboundManager adapter.OutboundManager, matchRule adapter.Rule, matchOutbound adapter.Outbound) *TCPConn {
 	id, _ := uuid.NewV4()
+	trimTrackedMetadata(&metadata)
 	var (
 		chain        []string
 		next         string
@@ -201,6 +210,7 @@ func (ut *UDPConn) WriterReplaceable() bool {
 
 func NewUDPTracker(conn N.PacketConn, manager *Manager, metadata adapter.InboundContext, outboundManager adapter.OutboundManager, matchRule adapter.Rule, matchOutbound adapter.Outbound) *UDPConn {
 	id, _ := uuid.NewV4()
+	trimTrackedMetadata(&metadata)
 	var (
 		chain        []string
 		next         string
diff --git a/experimental/clashapi/trafficontrol/tracker_metadata_test.go b/experimental/clashapi/trafficontrol/tracker_metadata_test.go
new file mode 100644
index 000000000..0c17aaf73
--- /dev/null
+++ b/experimental/clashapi/trafficontrol/tracker_metadata_test.go
@@ -0,0 +1,29 @@
+package trafficontrol
+
+import (
+	"errors"
+	"testing"
+
+	"github.com/sagernet/sing-box/adapter"
+
+	"github.com/stretchr/testify/require"
+)
+
+// The tracker's copy of the metadata drops the sniffer's state; the caller's metadata keeps
+// it, and what the connection list shows stays.
+func TestTrimTrackedMetadata(t *testing.T) {
+	original := adapter.InboundContext{
+		Protocol:     "quic",
+		Domain:       "example.com",
+		SniffContext: make([]byte, 4096),
+		SniffError:   errors.New("need more packets"),
+	}
+	tracked := original
+	trimTrackedMetadata(&tracked)
+	require.Nil(t, tracked.SniffContext)
+	require.NoError(t, tracked.SniffError)
+	require.Equal(t, "quic", tracked.Protocol)
+	require.Equal(t, "example.com", tracked.Domain)
+	require.NotNil(t, original.SniffContext)
+	require.Error(t, original.SniffError)
+}
