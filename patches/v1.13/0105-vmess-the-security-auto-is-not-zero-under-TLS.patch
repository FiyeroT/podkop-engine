From b44d809692ccc1985613957036f8b54bf563b7c1 Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Fri, 9 Oct 2026 16:15:04 +0300
Subject: [PATCH 105/126] vmess: the security auto is not zero under TLS

With TLS the outbound turned the security "auto" into "zero": no cipher
of its own under a transport that encrypts. Xray-core has removed zero
and none (#6303, July 2026) and closes a request that asks for them, so
a VMess outbound with TLS did not work with a server on Xray 26 at all:
on the stand of r13, 17 links to VMess inbounds with TLS out of 17.

auto stays auto: AES-128-GCM or ChaCha20-Poly1305, which every VMess
server takes. zero and none set in the configuration are sent as before.
---
 protocol/vmess/outbound.go | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/protocol/vmess/outbound.go b/protocol/vmess/outbound.go
index 1baf3b350..446c4bacb 100644
--- a/protocol/vmess/outbound.go
+++ b/protocol/vmess/outbound.go
@@ -96,9 +96,9 @@ func NewOutbound(ctx context.Context, router adapter.Router, logger log.ContextL
 	if security == "" {
 		security = "auto"
 	}
-	if security == "auto" && outbound.tlsConfig != nil {
-		security = "zero"
-	}
+	// "auto" is AES-128-GCM or ChaCha20-Poly1305, by the hardware, under TLS too. It was
+	// made "zero" there; Xray-core has dropped "zero" and "none", and its server refuses a
+	// request that names one of them ("unknown security type").
 	client, err := vmess.NewClient(options.UUID, security, options.AlterId, clientOptions...)
 	if err != nil {
 		return nil, err
-- 
