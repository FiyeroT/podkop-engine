 		conn, err := listener.Accept()
 		if err != nil {
 			return
@@ -39,9 +41,11 @@ func dialLocalWith(t *testing.T, dialControl func(fd int)) (*net.TCPConn, chan [
 	}}
 	client, err := dialer.DialContext(context.Background(), "tcp4", listener.Addr().String())
