From 2a0312a9859320f1e87f4ea54f080248897dec02 Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Fri, 9 Oct 2026 16:15:04 +0300
Subject: [PATCH 111/126] route: apply tls_spoof of a bypass action

The route option tls_spoof was read for the actions route and
route-options and not for bypass, where it is of the most use: a
connection that goes out directly. Only the spoof options of a bypass
action are applied; its other route options stay unapplied on this line,
as before.
---
 route/route.go | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/route/route.go b/route/route.go
index 22bfbd3b7..83c73b39e 100644
--- a/route/route.go
+++ b/route/route.go
@@ -559,6 +559,13 @@ match:
 			routeOptions = &action.RuleActionRouteOptions
 		case *R.RuleActionRouteOptions:
 			routeOptions = action
+		case *R.RuleActionBypass:
+			// Of the route options of a bypass action this line applies none; tls_spoof
+			// is new here and is applied as on 1.14 (podkop-engine).
+			if action.Outbound != "" && action.TLSSpoof != "" {
+				metadata.TLSSpoof = action.TLSSpoof
+				metadata.TLSSpoofMethod = action.TLSSpoofMethod
+			}
 		}
 		if routeOptions != nil {
 			// TODO: add nat
