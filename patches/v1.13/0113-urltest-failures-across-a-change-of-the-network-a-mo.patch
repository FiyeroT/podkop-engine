-			// interface, mostly): its results are of the old state, so another follows it
-			g.recheck.Store(true)
+			g.requestRecheck()
 		}
 		return result, nil
 	}
+	g.lastRound.Store(int64(time.Since(g.epoch)))
 	defer func() {
 		g.checking.Store(false)
+		g.access.Lock()
+		g.keepTicking()
+		g.access.Unlock()
