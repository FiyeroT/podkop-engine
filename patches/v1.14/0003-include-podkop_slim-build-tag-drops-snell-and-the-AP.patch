From 836117150a621212a67de7071856343963f3804b Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Sat, 26 Sep 2026 22:31:45 +0300
Subject: [PATCH 003/125] include: podkop_slim build tag drops snell and the
 API service

snell and the gRPC API service are registered unconditionally since 1.14
and podkop uses neither. With -tags podkop_slim they are replaced by stubs
that fail with a clear error, the way optional features are stubbed out
upstream. The sing-box api CLI (cmd/sing-box/cmd_api*.go) is removed by the
build recipe; together this saves about 6 MB per binary.
---
 include/registry.go       |  8 +++-----
 include/snell_api.go      | 23 +++++++++++++++++++++++
 include/snell_api_stub.go | 34 ++++++++++++++++++++++++++++++++++
 3 files changed, 60 insertions(+), 5 deletions(-)
 create mode 100644 include/snell_api.go
 create mode 100644 include/snell_api_stub.go

diff --git a/include/registry.go b/include/registry.go
index 9bb9220c1..e6d721b73 100644
--- a/include/registry.go
+++ b/include/registry.go
@@ -30,7 +30,6 @@ import (
 	"github.com/sagernet/sing-box/protocol/redirect"
 	"github.com/sagernet/sing-box/protocol/shadowsocks"
 	"github.com/sagernet/sing-box/protocol/shadowtls"
-	"github.com/sagernet/sing-box/protocol/snell"
 	"github.com/sagernet/sing-box/protocol/socks"
 	"github.com/sagernet/sing-box/protocol/ssh"
 	"github.com/sagernet/sing-box/protocol/tor"
@@ -38,7 +37,6 @@ import (
 	"github.com/sagernet/sing-box/protocol/tun"
 	"github.com/sagernet/sing-box/protocol/vless"
 	"github.com/sagernet/sing-box/protocol/vmess"
-	"github.com/sagernet/sing-box/service/api"
 	originca "github.com/sagernet/sing-box/service/origin_ca"
 	"github.com/sagernet/sing-box/service/resolved"
 	"github.com/sagernet/sing-box/service/ssmapi"
@@ -62,7 +60,7 @@ func InboundRegistry() *inbound.Registry {
 	mixed.RegisterInbound(registry)
 
 	shadowsocks.RegisterInbound(registry)
-	snell.RegisterInbound(registry)
+	registerSnellInbound(registry)
 	vmess.RegisterInbound(registry)
 	trojan.RegisterInbound(registry)
 	naive.RegisterInbound(registry)
@@ -91,7 +89,7 @@ func OutboundRegistry() *outbound.Registry {
 	socks.RegisterOutbound(registry)
 	http.RegisterOutbound(registry)
 	shadowsocks.RegisterOutbound(registry)
-	snell.RegisterOutbound(registry)
+	registerSnellOutbound(registry)
 	vmess.RegisterOutbound(registry)
 	trojan.RegisterOutbound(registry)
 	registerNaiveOutbound(registry)
@@ -143,7 +141,7 @@ func DNSTransportRegistry() *dns.TransportRegistry {
 func ServiceRegistry() *service.Registry {
 	registry := service.NewRegistry()
 
-	api.RegisterService(registry)
+	registerAPIService(registry)
 	resolved.RegisterService(registry)
 	ssmapi.RegisterService(registry)
 
diff --git a/include/snell_api.go b/include/snell_api.go
new file mode 100644
index 000000000..3d240a43c
--- /dev/null
+++ b/include/snell_api.go
@@ -0,0 +1,23 @@
+//go:build !podkop_slim
+
+package include
+
+import (
+	"github.com/sagernet/sing-box/adapter/inbound"
+	"github.com/sagernet/sing-box/adapter/outbound"
+	"github.com/sagernet/sing-box/adapter/service"
+	"github.com/sagernet/sing-box/protocol/snell"
+	"github.com/sagernet/sing-box/service/api"
+)
+
+func registerSnellInbound(registry *inbound.Registry) {
+	snell.RegisterInbound(registry)
+}
+
+func registerSnellOutbound(registry *outbound.Registry) {
+	snell.RegisterOutbound(registry)
+}
+
+func registerAPIService(registry *service.Registry) {
+	api.RegisterService(registry)
+}
diff --git a/include/snell_api_stub.go b/include/snell_api_stub.go
new file mode 100644
index 000000000..bc0ffa69b
--- /dev/null
+++ b/include/snell_api_stub.go
@@ -0,0 +1,34 @@
+//go:build podkop_slim
+
+package include
+
+import (
+	"context"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/adapter/inbound"
+	"github.com/sagernet/sing-box/adapter/outbound"
+	"github.com/sagernet/sing-box/adapter/service"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+	E "github.com/sagernet/sing/common/exceptions"
+)
+
+func registerSnellInbound(registry *inbound.Registry) {
+	inbound.Register[option.SnellInboundOptions](registry, C.TypeSnell, func(ctx context.Context, router adapter.Router, logger log.ContextLogger, tag string, options option.SnellInboundOptions) (adapter.Inbound, error) {
+		return nil, E.New(`snell is not included in this build (podkop_slim)`)
+	})
+}
+
+func registerSnellOutbound(registry *outbound.Registry) {
+	outbound.Register[option.SnellOutboundOptions](registry, C.TypeSnell, func(ctx context.Context, router adapter.Router, logger log.ContextLogger, tag string, options option.SnellOutboundOptions) (adapter.Outbound, error) {
+		return nil, E.New(`snell is not included in this build (podkop_slim)`)
+	})
+}
+
+func registerAPIService(registry *service.Registry) {
+	service.Register[option.APIServiceOptions](registry, C.TypeAPI, func(ctx context.Context, logger log.ContextLogger, tag string, options option.APIServiceOptions) (adapter.Service, error) {
+		return nil, E.New(`API service is not included in this build (podkop_slim)`)
+	})
+}
