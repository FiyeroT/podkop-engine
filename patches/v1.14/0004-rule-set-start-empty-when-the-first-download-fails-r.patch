From 839405f499938d5a00ece16c4b48e883d0470761 Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Mon, 28 Sep 2026 08:37:30 +0300
Subject: [PATCH 4/4] rule-set: start empty when the first download fails, retry,
 run a hook

A remote rule-set that cannot be downloaded at start (WAN not up yet, clock
wrong, the first outbound of a urltest dead, the list host unreachable) made
the whole start fail. On OpenWrt procd gives up after a few respawns and the
router is left without the proxy and without DNS.

Now the rule-set starts empty, the error is logged, and the download is
retried after 5, 10, 20 s and then every 30 s until it succeeds; after that
the regular update_interval applies. Rule-sets loaded from cache.db are not
affected.

When such a rule-set is downloaded at last, the command in
SING_BOX_RULESET_RECOVERED_HOOK (if set) is run once via /bin/sh, with the
tags in SING_BOX_RULESET_TAGS (rule-sets recovering within 5 s are batched).
podkop uses it to re-run its own list download.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 route/rule/rule_set_hook.go    | 55 ++++++++++++++++++++++++++++++++++
 route/rule/rule_set_remote.go  |  6 +++-
 route/rule/rule_set_updater.go | 12 ++++++++
 3 files changed, 72 insertions(+), 1 deletion(-)
 create mode 100644 route/rule/rule_set_hook.go

diff --git a/route/rule/rule_set_hook.go b/route/rule/rule_set_hook.go
new file mode 100644
index 000000000..5ee60d49e
--- /dev/null
+++ b/route/rule/rule_set_hook.go
@@ -0,0 +1,55 @@
+package rule
+
+import (
+	"os"
+	"os/exec"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/sagernet/sing/common/logger"
+)
+
+// RuleSetRecoveredHookEnv names a command run once remote rule-sets that could
+// not be downloaded at start have been downloaded after all: the network path
+// to the lists works now, so whatever else depends on it (e.g. podkop's own
+// list download) can be retried. Unset: nothing happens.
+const RuleSetRecoveredHookEnv = "SING_BOX_RULESET_RECOVERED_HOOK"
+
+// Rule-sets recovering close together are reported by a single run.
+const ruleSetRecoveredHookDelay = 5 * time.Second
+
+var ruleSetRecovered struct {
+	access sync.Mutex
+	timer  *time.Timer
+	tags   []string
+}
+
+func notifyRuleSetRecovered(logger logger.ContextLogger, tag string) {
+	command := os.Getenv(RuleSetRecoveredHookEnv)
+	if command == "" {
+		return
+	}
+	ruleSetRecovered.access.Lock()
+	defer ruleSetRecovered.access.Unlock()
+	ruleSetRecovered.tags = append(ruleSetRecovered.tags, tag)
+	if ruleSetRecovered.timer != nil {
+		return
+	}
+	ruleSetRecovered.timer = time.AfterFunc(ruleSetRecoveredHookDelay, func() {
+		ruleSetRecovered.access.Lock()
+		tags := strings.Join(ruleSetRecovered.tags, ",")
+		ruleSetRecovered.tags = nil
+		ruleSetRecovered.timer = nil
+		ruleSetRecovered.access.Unlock()
+		cmd := exec.Command("/bin/sh", "-c", command)
+		cmd.Env = append(os.Environ(), "SING_BOX_RULESET_TAGS="+tags)
+		err := cmd.Start()
+		if err != nil {
+			logger.Error("run rule-set recovered hook: ", err)
+			return
+		}
+		logger.Info("rule-set recovered hook started for ", tags)
+		go cmd.Wait()
+	})
+}
diff --git a/route/rule/rule_set_remote.go b/route/rule/rule_set_remote.go
index 10b1f13c1..8df496a6f 100644
--- a/route/rule/rule_set_remote.go
+++ b/route/rule/rule_set_remote.go
@@ -49,6 +49,7 @@ type RemoteRuleSet struct {
 	metadata       adapter.RuleSetMetadata
 	lastUpdated    time.Time
 	lastEtag       string
+	startedEmpty   bool
 	cacheFile      adapter.CacheFile
 	pauseManager   pause.Manager
 	callbacks      list.List[adapter.RuleSetUpdateCallback]
@@ -132,7 +133,10 @@ func (s *RemoteRuleSet) StartContext(ctx context.Context, startContext *adapter.
 	if s.lastUpdated.IsZero() && !loadedFromInitialPath {
 		err = s.fetch(ctx, true)
 		if err != nil {
-			return E.Cause(err, "initial rule-set: ", s.tag)
+			// Start with an empty rule-set instead of failing the whole start:
+			// RuleSetUpdater keeps retrying until the first download succeeds.
+			s.logger.Error(E.Cause(err, "initial rule-set: ", s.tag, ", starting empty and retrying"))
+			s.startedEmpty = true
 		}
 	}
 	return nil
diff --git a/route/rule/rule_set_updater.go b/route/rule/rule_set_updater.go
index 66148c620..2d9a9934c 100644
--- a/route/rule/rule_set_updater.go
+++ b/route/rule/rule_set_updater.go
@@ -44,6 +44,7 @@ func (u *RuleSetUpdater) Close() error {
 
 func (u *RuleSetUpdater) loopUpdate() {
 	nextUpdates := make([]time.Time, len(u.ruleSets))
+	retryDelays := make([]time.Duration, len(u.ruleSets))
 	for i, ruleSet := range u.ruleSets {
 		nextUpdates[i] = ruleSet.lastUpdated.Add(ruleSet.updateInterval)
 	}
@@ -63,6 +64,17 @@ func (u *RuleSetUpdater) loopUpdate() {
 			}
 			ruleSet.updateOnce()
 			nextUpdates[i] = now.Add(ruleSet.updateInterval)
+			if ruleSet.startedEmpty {
+				if ruleSet.lastUpdated.IsZero() {
+					// Never downloaded (initial fetch failed): retry with backoff
+					// instead of waiting a whole update_interval.
+					retryDelays[i] = min(max(retryDelays[i]*2, 5*time.Second), 30*time.Second)
+					nextUpdates[i] = now.Add(retryDelays[i])
+				} else {
+					ruleSet.startedEmpty = false
+					notifyRuleSetRecovered(ruleSet.logger, ruleSet.tag)
+				}
+			}
 			updated = true
 		}
 		if updated {
