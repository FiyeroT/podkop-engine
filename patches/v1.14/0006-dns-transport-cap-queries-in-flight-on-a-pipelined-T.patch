From 9e8a4b89aceb0220d1f23903e2eb49195ace871a Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Tue, 29 Sep 2026 15:33:06 +0300
Subject: [PATCH 06/35] dns/transport: cap queries in flight on a pipelined
 TCP/TLS connection

Yandex DNS over TLS resets a connection that carries more than about 20
queries at once. The multiplexer sent every query over one connection and
re-sent the pending ones over a new connection, which was reset again: a
burst of 25 or 40 queries got no answer at all.

At most 16 queries are now in flight on the shared connection; the rest
get a connection of their own, as before the reuse probe succeeded.
Against Yandex a burst of 25 now gets 24 answers and a burst of 40 all 40;
other public servers are unaffected.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 dns/transport/multiplexer.go | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/dns/transport/multiplexer.go b/dns/transport/multiplexer.go
index 6b275ae9d..c9e7241ba 100644
--- a/dns/transport/multiplexer.go
+++ b/dns/transport/multiplexer.go
@@ -137,9 +137,24 @@ func (m *queryMultiplexer) dispatch(ctx context.Context, message *mDNS.Msg, call
 		go m.exchangeSingle(ctx, message, callback)
 		return
 	}
+	if m.options.probeReuse && m.inflight() >= pipelineMaxInflight {
+		go m.exchangeSingle(ctx, message, callback)
+		return
+	}
 	m.exchangeAsync(ctx, message, callback, retryReadError)
 }
 
+// Some servers reset a TCP/TLS connection that carries too many queries at once:
+// Yandex DNS over TLS does with more than about 20. Queries beyond this limit on the
+// shared connection get a connection of their own instead.
+const pipelineMaxInflight = 16
+
+func (m *queryMultiplexer) inflight() int {
+	m.queryAccess.Lock()
+	defer m.queryAccess.Unlock()
+	return len(m.queries)
+}
+
 func (m *queryMultiplexer) exchangeSingle(ctx context.Context, message *mDNS.Msg, callback func(response *mDNS.Msg, err error)) {
