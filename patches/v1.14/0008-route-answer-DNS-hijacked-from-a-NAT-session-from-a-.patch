From 6b8fa72e6c87b747d64b2c9c90cb90a313fc0359 Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Tue, 29 Sep 2026 21:16:02 +0300
Subject: [PATCH 08/88] route: answer DNS hijacked from a NAT session from a
 handler

Since "Refactor UDP DNS hijack" (1.14), DNS hijacked from a UDP session
of an inbound's NAT table (direct, mixed, socks) is served by a reading
loop per session: three goroutines, a timer and a 64-packet channel that
stay alive for 10 s after the last answer. TUN and the VPN endpoints got
a packet-level path instead. A direct inbound behind dnsmasq (podkop)
gets a new session for every query, as dnsmasq forwards each query from
a new port, so under load thousands of goroutines were alive and memory
grew.

Answer the packets of such a session from a handler of the session, as
1.13 did, through the asynchronous exchange of 1.14; the handshake report
and the process search stay. The session leaves the table 10 s after its
last packet.

Measured with podkop 0.7.22 on OpenWrt 24.10, 200 queries per second for
60 s, each from a new port as dnsmasq sends them: 3094 goroutines, 27 MB
of heap and 91 MB RSS before, 22 goroutines, 10 MB and 49 MB after (1.13:
26, 7 MB and 38 MB). CPU for 24000 queries: 950 ticks instead of 1100.
---
 route/dns.go     |  4 +++
 route/dns_nat.go | 68 ++++++++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 72 insertions(+)
 create mode 100644 route/dns_nat.go

diff --git a/route/dns.go b/route/dns.go
index d697e787e..659612a0b 100644
--- a/route/dns.go
+++ b/route/dns.go
@@ -13,6 +13,7 @@ import (
 	E "github.com/sagernet/sing/common/exceptions"
 	M "github.com/sagernet/sing/common/metadata"
 	N "github.com/sagernet/sing/common/network"
+	"github.com/sagernet/sing/common/udpnat2"
 
 	mDNS "github.com/miekg/dns"
 )
@@ -43,6 +44,9 @@ func (r *Router) hijackDNSPacket(ctx context.Context, conn N.PacketConn, packetB
 	if err != nil {
 		N.ReleaseMultiPacketBuffer(packetBuffers)
 		err = E.Cause(err, "report handshake success")
+	} else if natConn, isNatConn := conn.(udpnat.Conn); isNatConn {
+		r.hijackDNSNatConn(ctx, natConn, packetBuffers, metadata, onClose) // see dns_nat.go
+		return nil
 	} else {
 		err = dnsOutbound.NewDNSPacketConnection(ctx, r.dns, conn, packetBuffers, metadata)
 	}
diff --git a/route/dns_nat.go b/route/dns_nat.go
new file mode 100644
index 000000000..557a49290
--- /dev/null
+++ b/route/dns_nat.go
@@ -0,0 +1,68 @@
+package route
+
+import (
+	"context"
+
+	"github.com/sagernet/sing-box/adapter"
+	C "github.com/sagernet/sing-box/constant"
+	R "github.com/sagernet/sing-box/route/rule"
+	"github.com/sagernet/sing/common/buf"
+	E "github.com/sagernet/sing/common/exceptions"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+	"github.com/sagernet/sing/common/udpnat2"
+
+	mDNS "github.com/miekg/dns"
+)
+
+// DNS hijacked from a UDP session of an inbound's NAT table (direct, mixed, socks) is
+// answered from a packet handler of the session, as sing-box 1.13 did, not from a
+// reading loop per session. dnsmasq forwards every query from a new port, so every query
+// is a new session, and the loop kept three goroutines, a timer and buffers alive for
+// 10 s after each answer.
+func (r *Router) hijackDNSNatConn(ctx context.Context, conn udpnat.Conn, packetBuffers []*N.PacketBuffer, metadata adapter.InboundContext, onClose N.CloseHandlerFunc) {
+	metadata.Destination = M.Socksaddr{}
+	handler := &dnsNatHandler{router: r, ctx: ctx, conn: conn, metadata: metadata, onClose: onClose}
+	for _, packet := range packetBuffers {
+		handler.NewPacketEx(packet.Buffer, packet.Destination)
+		N.PutPacketBuffer(packet)
+	}
+	// the session leaves the table 10 s after its last packet, not after the UDP timeout
+	conn.SetTimeout(C.DNSTimeout)
+	conn.SetHandler(handler)
+}
+
+type dnsNatHandler struct {
+	router   *Router
+	ctx      context.Context
+	conn     udpnat.Conn
+	metadata adapter.InboundContext
+	onClose  N.CloseHandlerFunc
+}
+
+func (h *dnsNatHandler) NewPacketEx(buffer *buf.Buffer, destination M.Socksaddr) {
+	var message mDNS.Msg
+	err := message.Unpack(buffer.Bytes())
+	buffer.Release()
+	if err != nil {
+		h.router.logger.ErrorContext(h.ctx, E.Cause(err, "process DNS packet: unpack request"))
+		return
+	}
+	metadata := h.metadata
+	h.router.dns.ExchangeAsync(adapter.WithContext(h.ctx, &metadata), &message, adapter.DNSQueryOptions{}, func(response *mDNS.Msg, exchangeErr error) {
+		if exchangeErr == nil {
+			exchangeErr = h.router.writeDNSPacketResponse(&message, response, h.conn, destination)
+		}
+		if exchangeErr != nil && !R.IsRejected(exchangeErr) && !E.IsClosedOrCanceled(exchangeErr) {
+			h.router.logger.ErrorContext(h.ctx, E.Cause(exchangeErr, "process DNS packet"))
+		}
+	})
+}
+
+// Close is called when the session leaves the NAT table.
+func (h *dnsNatHandler) Close() error {
+	if h.onClose != nil {
+		h.onClose(nil)
+	}
+	return nil
+}
