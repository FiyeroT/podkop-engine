From 61a1436e172fab0c40d1c057015edadfe171bd68 Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Wed, 30 Sep 2026 23:36:29 +0300
Subject: [PATCH 10/88] utls: keep the randomized fingerprint consistent

uTLS draws "X25519MLKEM768 in supported_groups" and "a key share for it" as
independent coins in HelloRandomized. A seed that offers the group without its
key share makes servers preferring it (Cloudflare, Google, the Go TLS stack of
Xray) answer with a HelloRetryRequest that uTLS cannot answer for
X25519MLKEM768 ("tls: CurvePreferences includes unsupported curve"); a key
share without the group is refused as an illegal parameter (GitHub, Apple,
Microsoft). REALITY passes either reply on from its target, and REALITY
servers since Xray-core v26.9.8 refuse a Client Hello without the
X25519MLKEM768 key share. HelloRandomized also leaves ALPN out on some seeds,
and gRPC/HTTP2 transports then cannot agree on h2. The seed is drawn once per
process: a bad draw breaks every connection until the next restart.

"randomized" now starts from HelloRandomizedALPN (as Xray-core), always offers
X25519MLKEM768, and sends its key share exactly when the group is offered (as
proposed in refraction-networking/utls#415); ALPN takes the configured
protocols. The P-256 key share, cipher suites and extensions stay random.

Lab: Xray 25.12.8, 26.3.27, 26.7.28, 26.9.9 with ten REALITY targets, and a
TLS server with vless tcp/ws/grpc, trojan and grpc+REALITY: 40 process starts
per line went from 38-84% of requests answered to 100%; chrome, firefox,
safari and random unchanged.
---
 common/tls/utls_client.go |  7 +++++-
 common/tls/utls_spec.go   | 51 ++++++++++++++++++++++++++++++++++++---
 2 files changed, 54 insertions(+), 4 deletions(-)

diff --git a/common/tls/utls_client.go b/common/tls/utls_client.go
index f8ece50d1..097bfd2ea 100644
--- a/common/tls/utls_client.go
+++ b/common/tls/utls_client.go
@@ -365,7 +365,12 @@ func init() {
 	weights := utls.DefaultWeights
 	weights.TLSVersMax_Set_VersionTLS13 = 1
 	weights.FirstKeyShare_Set_CurveP256 = 0
-	randomizedFingerprint = utls.HelloRandomized
+	// X25519MLKEM768 always offered: REALITY servers since Xray-core v26.9.8 refuse a
+	// Client Hello without it (its key share: randomizedSpec).
+	weights.CurveIDs_Append_X25519 = 1
+	// ALPN always sent, as Xray-core does: without it gRPC and HTTP/2 transports cannot
+	// agree on h2, for as long as the process keeps the seed.
+	randomizedFingerprint = utls.HelloRandomizedALPN
 	randomizedFingerprint.Seed, _ = utls.NewPRNGSeed()
 	randomizedFingerprint.Weights = &weights
 }
diff --git a/common/tls/utls_spec.go b/common/tls/utls_spec.go
index 92d474f1e..51c1068b7 100644
--- a/common/tls/utls_spec.go
+++ b/common/tls/utls_spec.go
@@ -4,6 +4,7 @@ package tls
 
 import (
 	"net"
+	"slices"
 
 	utls "github.com/metacubex/utls"
 	"github.com/metacubex/utls/dicttls"
@@ -20,11 +21,17 @@ var (
 
 func newUClient(conn net.Conn, config *utls.Config, id utls.ClientHelloID) (*utls.UConn, error) {
 	var spec *utls.ClientHelloSpec
-	switch id {
-	case helloFirefox148:
+	switch {
+	case id == helloFirefox148:
 		spec = firefox148Spec()
-	case helloSafari26_3:
+	case id == helloSafari26_3:
 		spec = safari26_3Spec()
+	case id.Client == utls.HelloRandomizedALPN.Client:
+		var err error
+		spec, err = randomizedSpec(id, config.NextProtos)
+		if err != nil {
+			return nil, err
+		}
 	default:
 		return utls.UClient(conn, config, id), nil
 	}
@@ -39,6 +46,44 @@ func newUClient(conn net.Conn, config *utls.Config, id utls.ClientHelloID) (*utl
 	return uConn, nil
 }
 
+// randomizedSpec is the "randomized" Client Hello of this process, as uTLS builds it from
+// the seed, with the X25519MLKEM768 key share sent exactly when the group is offered (as
+// proposed in refraction-networking/utls#415). uTLS draws the two independently: a group
+// offered without its key share makes servers preferring it (Cloudflare, Google) send a
+// HelloRetryRequest that uTLS cannot answer for X25519MLKEM768 ("CurvePreferences includes
+// unsupported curve"), a key share without the group is refused as an illegal parameter
+// (GitHub, Apple, Microsoft); REALITY passes either reply on from its target.
+func randomizedSpec(id utls.ClientHelloID, nextProtos []string) (*utls.ClientHelloSpec, error) {
+	spec, err := utls.UTLSIdToSpec(id)
+	if err != nil {
+		return nil, err
+	}
+	var offered bool
+	for _, extension := range spec.Extensions {
+		if curves, isCurves := extension.(*utls.SupportedCurvesExtension); isCurves {
+			offered = slices.Contains(curves.Curves, utls.X25519MLKEM768)
+		}
+	}
+	for _, extension := range spec.Extensions {
+		switch ext := extension.(type) {
+		case *utls.KeyShareExtension:
+			ext.KeyShares = slices.DeleteFunc(ext.KeyShares, func(share utls.KeyShare) bool {
+				return share.Group == utls.X25519MLKEM768
+			})
+			if offered {
+				ext.KeyShares = append([]utls.KeyShare{{Group: utls.X25519MLKEM768}}, ext.KeyShares...)
+			}
+		case *utls.ALPNExtension:
+			// UTLSIdToSpec does not know the configured protocols and offers h2 and http/1.1
+			// (kept when none are configured, as for the fixed fingerprints)
+			if len(nextProtos) > 0 {
+				ext.AlpnProtocols = slices.Clone(nextProtos)
+			}
+		}
+	}
+	return &spec, nil
+}
+
 // reuseHybridX25519KeyShare makes the X25519 key share reuse the X25519 part of
 // X25519MLKEM768, as Firefox does (refraction-networking/utls ReuseHybridAndClassicalKeyShares).
 func reuseHybridX25519KeyShare(uConn *utls.UConn) {
