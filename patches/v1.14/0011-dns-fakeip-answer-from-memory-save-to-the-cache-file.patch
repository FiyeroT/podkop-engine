+	storage.fail = true
+	storage.access.Unlock()
+	second := mustCreate(t, store, "b.test")
+	time.Sleep(100 * time.Millisecond)
+	require.Equal(t, "", storage.domainOf(second))
+	storage.access.Lock()
+	storage.fail = false
