From 21492d08df1403e878fb4becff9f23afbe65734b Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Wed, 30 Sep 2026 23:36:29 +0300
Subject: [PATCH 12/24] route: exchange DNS of a NAT session off the reading
 loop

udpnat calls the packet handler of an existing session from the reading loop
of the inbound, and dnsmasq reuses its source ports (in the lab 80% of its
queries came from a port it used in the last 10 s). An exchange that waits -
a new FakeIP address written to the cache file, a DoT connection being set up
- held up every DNS query of the router: with 150 new FakeIP names per second
a known name waited 1.6 s. The exchange now runs in a goroutine of its own, as
in sing-box 1.13; the goroutine lives as long as ExchangeAsync, and goroutines
and memory under load stay as they were.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 route/dns_nat.go | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/route/dns_nat.go b/route/dns_nat.go
index 557a49290..19ea50f3d 100644
--- a/route/dns_nat.go
+++ b/route/dns_nat.go
@@ -49,7 +49,11 @@ func (h *dnsNatHandler) NewPacketEx(buffer *buf.Buffer, destination M.Socksaddr)
 		return
 	}
 	metadata := h.metadata
-	h.router.dns.ExchangeAsync(adapter.WithContext(h.ctx, &metadata), &message, adapter.DNSQueryOptions{}, func(response *mDNS.Msg, exchangeErr error) {
+	// Not on the caller: udpnat calls NewPacketEx from the reading loop of the inbound,
+	// which serves every session, and an exchange can wait (a new FakeIP address is
+	// written to the cache file, a DoT connection is being set up). The goroutine lives as
+	// long as ExchangeAsync itself, not for the session.
+	go h.router.dns.ExchangeAsync(adapter.WithContext(h.ctx, &metadata), &message, adapter.DNSQueryOptions{}, func(response *mDNS.Msg, exchangeErr error) {
 		if exchangeErr == nil {
 			exchangeErr = h.router.writeDNSPacketResponse(&message, response, h.conn, destination)
 		}
