From 91f7e46e353d17dbeb7cf23391fe628c744950bf Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Fri, 2 Oct 2026 07:03:12 +0300
Subject: [PATCH 14/88] listener: an output queue of 1024 packets for UDP
 instead of 64

Packets written to a UDP inbound pass through a queue to the one goroutine
that writes them to the socket; a packet that finds the queue full is
dropped (a trace log line). The packets are made on every core at once,
and the queue has to hold what they make while that goroutine wakes up or
is busy with a write. It held 64: less than a resolver in front has in
flight (dnsmasq: 150) and less than the kernel hands the listener in one go
(the receive buffer of the socket holds a few hundred small packets). A
burst of 70 answers of a DNS inbound already lost some, and a client whose
answer is lost waits for its timeout, seconds.

The queue holds 1024 packets now. Writers still do not wait for room, as
they did until sing-box 1.11: under a flood of queries the waiting writers
are a queue without a bound.

Lab (podkop, sing-box 1.13 and 1.14; queries for 1000 known FakeIP names
sent in bursts, 90 000 queries for every burst size). With 64, bursts of
100 lose 140-160 answers, of 150 - 510-550, of 200 - 670-770. With 1024
none are lost in bursts up to 200, and in bursts of 500 and 1000 only what
the kernel drops at the full receive buffer of the socket. A flood of 1.4
million queries per second for 5 s: 90-170 MB of memory at most; with
writers waiting for room 360-400 MB, where the OOM killer of the lab
container (512 MB) ended it.
---
 common/listener/listener.go          |   2 +-
 common/listener/listener_udp.go      |  11 +++
 common/listener/listener_udp_test.go | 127 +++++++++++++++++++++++++++
 3 files changed, 139 insertions(+), 1 deletion(-)
 create mode 100644 common/listener/listener_udp_test.go

diff --git a/common/listener/listener.go b/common/listener/listener.go
index 7a58015c8..b739b3480 100644
--- a/common/listener/listener.go
+++ b/common/listener/listener.go
@@ -92,7 +92,7 @@ func (l *Listener) Start() error {
 			return err
 		}
 		l.packetOutboundClosed = make(chan struct{})
-		l.packetOutbound = make(chan *N.PacketBuffer, 64)
+		l.packetOutbound = make(chan *N.PacketBuffer, udpOutputQueueSize)
 		go l.loopUDPIn()
 		if !l.disablePacketOutput {
 			go l.loopUDPOut()
diff --git a/common/listener/listener_udp.go b/common/listener/listener_udp.go
index fab87cbc8..9292de3f5 100644
--- a/common/listener/listener_udp.go
+++ b/common/listener/listener_udp.go
@@ -21,6 +21,17 @@ import (
 
 const udpOutputBatchSize = 128
 
+// udpOutputQueueSize is how many packets may wait for the output loop, the one goroutine
+// that writes them to the socket; a packet that finds the queue full is dropped. Packets
+// are made on every core at once, so the queue has to hold what they make while the output
+// loop wakes up or is busy with a write. It held 64: less than a resolver in front has in
+// flight (dnsmasq: 150) and less than the kernel hands the listener in one go (its receive
+// buffer holds a few hundred small packets), so a burst of 70 DNS answers already lost
+// some, and a lost DNS answer costs the client its timeout, seconds. Writers do not wait
+// for room instead: under a flood of queries the waiting writers would be a queue without
+// a bound.
+const udpOutputQueueSize = 1024
+
 func (l *Listener) ListenUDP() (net.PacketConn, error) {
 	return l.ListenUDPWithConfig(net.ListenConfig{})
 }
diff --git a/common/listener/listener_udp_test.go b/common/listener/listener_udp_test.go
new file mode 100644
index 000000000..d0e60f662
--- /dev/null
+++ b/common/listener/listener_udp_test.go
@@ -0,0 +1,127 @@
+package listener
+
+import (
+	"context"
+	"net"
+	"net/netip"
+	"os"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common/buf"
+	"github.com/sagernet/sing/common/json/badoption"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+
+	"github.com/stretchr/testify/require"
+)
+
+const testWait = 5 * time.Second
+
+func testPacket() *buf.Buffer {
+	buffer := buf.NewSize(16)
+	buffer.WriteString("answer")
+	return buffer
+}
+
+// The queue holds a burst of udpOutputQueueSize packets while the output loop does not
+// run. One more is dropped at once: a writer never waits, and what waits for the output is
+// bounded.
+func TestPacketWriterQueue(t *testing.T) {
+	t.Parallel()
+	writer := (*packetWriter)(&Listener{
+		logger:               log.NewNOPFactory().NewLogger("test"),
+		packetOutbound:       make(chan *N.PacketBuffer, udpOutputQueueSize),
+		packetOutboundClosed: make(chan struct{}),
+	})
+	destination := M.ParseSocksaddr("127.0.0.1:53")
+	for range udpOutputQueueSize {
+		require.NoError(t, writer.WritePacket(testPacket(), destination))
+	}
+	require.Len(t, writer.packetOutbound, udpOutputQueueSize)
+	dropped := make(chan error, 1)
+	go func() {
+		dropped <- writer.WritePacket(testPacket(), destination)
+	}()
+	select {
+	case err := <-dropped:
+		require.NoError(t, err)
+	case <-time.After(testWait):
+		t.Fatal("a writer waits on a full queue")
+	}
+	require.Len(t, writer.packetOutbound, udpOutputQueueSize)
+	writer.shutdown.Store(true)
+	require.ErrorIs(t, writer.WritePacket(testPacket(), destination), os.ErrClosed)
+}
+
+type testPacketHandler struct {
+	writer  func() N.PacketWriter
+	answers int
+}
+
+func (h *testPacketHandler) NewPacket(buffer *buf.Buffer, source M.Socksaddr) {
+	// on the reading loop, as fast as packets can be made
+	writer := h.writer()
+	for range h.answers {
+		_ = writer.WritePacket(testPacket(), source)
+	}
+}
+
+func (h *testPacketHandler) NewPacketEx(buffer *buf.Buffer, source M.Socksaddr) {
+	h.NewPacket(buffer, source)
+}
+
+// A started listener: bursts of answers written at one instant, more than a resolver in
+// front has in flight (and than the queue held before, 64), all reach their clients.
+func TestListenerBurst(t *testing.T) {
+	t.Parallel()
+	const (
+		clients = 6
+		answers = 150 // each client: within what its socket holds unread
+	)
+	listenAddr := badoption.Addr(netip.AddrFrom4([4]byte{127, 0, 0, 1}))
+	handler := &testPacketHandler{answers: answers}
+	listener := New(Options{
+		Context:       context.Background(),
+		Logger:        log.NewNOPFactory().NewLogger("test"),
+		Network:       []string{N.NetworkUDP},
+		Listen:        option.ListenOptions{Listen: &listenAddr},
+		PacketHandler: handler,
+	})
+	handler.writer = listener.PacketWriter
+	require.NoError(t, listener.Start())
+	require.Equal(t, udpOutputQueueSize, cap(listener.packetOutbound))
+	require.GreaterOrEqual(t, udpOutputQueueSize, clients*answers)
+	serverAddr := listener.UDPConn().LocalAddr().(*net.UDPAddr)
+	conns := make([]*net.UDPConn, clients)
+	for i := range conns {
+		conn, err := net.DialUDP("udp4", nil, serverAddr)
+		require.NoError(t, err)
+		defer conn.Close()
+		require.NoError(t, conn.SetReadBuffer(1<<20))
+		conns[i] = conn
+	}
+	for range 3 {
+		for _, conn := range conns {
+			_, err := conn.Write([]byte("query"))
+			require.NoError(t, err)
+		}
+		for index, conn := range conns {
+			require.NoError(t, conn.SetReadDeadline(time.Now().Add(testWait)))
+			packet := make([]byte, 64)
+			for received := range answers {
+				n, err := conn.Read(packet)
+				require.NoError(t, err, "client %d: answer %d of %d", index, received+1, answers)
+				require.Equal(t, "answer", string(packet[:n]))
+			}
+		}
+	}
+	require.NoError(t, listener.Close())
+	select {
+	case <-listener.packetOutboundClosed:
+	case <-time.After(testWait):
+		t.Fatal("the reading loop did not stop")
+	}
+}
