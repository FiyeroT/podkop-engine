From 49a57e78aea7f55788fe05f8220566f0f81afc96 Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Sat, 3 Oct 2026 11:27:47 +0300
Subject: [PATCH 17/88] transport: a failed HTTP/2 dial frees the handshake
 write, with its error

The gRPC-lite and HTTP/2 transports send the request body through a pipe
and run RoundTrip in the background. When RoundTrip failed (the server
cannot be dialled), nothing read the pipe any more, and the first write
of the handshake blocked for ever with its goroutine and socket: one
leaked per connection attempt to a dead or blocked server.

The request goroutine now closes the read end of the pipe with the error,
which releases the write with that error itself, and cancels the request.
On 1.13 Read and Close no longer take the reader before setup has set it
(a race 1.14 fixed upstream).
---
 transport/v2raygrpclite/client.go    |  8 +++-
 transport/v2raygrpclite/conn.go      |  7 ++++
 transport/v2raygrpclite/conn_test.go | 61 ++++++++++++++++++++++++++++
 transport/v2rayhttp/client.go        |  8 +++-
 transport/v2rayhttp/conn_test.go     | 61 ++++++++++++++++++++++++++++
 5 files changed, 143 insertions(+), 2 deletions(-)
 create mode 100644 transport/v2raygrpclite/conn_test.go
 create mode 100644 transport/v2rayhttp/conn_test.go

diff --git a/transport/v2raygrpclite/client.go b/transport/v2raygrpclite/client.go
index 7a42cf415..c5618fb35 100644
--- a/transport/v2raygrpclite/client.go
+++ b/transport/v2raygrpclite/client.go
@@ -115,10 +115,16 @@ func (c *Client) DialContext(ctx context.Context) (net.Conn, error) {
 			if handshakeTimedOut.Load() {
 				err = os.ErrDeadlineExceeded
 			}
+			// RoundTrip failed, so the request never established and nothing will ever read
+			// the request-body pipe: closing its read end with the error releases a Write
+			// blocked on it (the synchronous first write of the handshake) with that error
+			pipeInReader.CloseWithError(err)
 			conn.setup(nil, err)
 		} else if response.StatusCode != 200 {
 			response.Body.Close()
-			conn.setup(nil, E.New("v2ray-grpc: unexpected status: ", response.Status))
+			err = E.New("v2ray-grpc: unexpected status: ", response.Status)
+			pipeInReader.CloseWithError(err)
+			conn.setup(nil, err)
 		} else {
 			conn.setup(response.Body, nil)
 		}
diff --git a/transport/v2raygrpclite/conn.go b/transport/v2raygrpclite/conn.go
index 896183b98..e3cec0222 100644
--- a/transport/v2raygrpclite/conn.go
+++ b/transport/v2raygrpclite/conn.go
@@ -55,6 +55,13 @@ func (c *GunConn) setup(reader io.Reader, err error) {
 		c.reader = std_bufio.NewReader(reader)
 	}
 	c.err = err
+	if err != nil {
+		// the client has closed the request-body pipe with the error; cancel the request
+		// too, so that the transport lets its goroutine go
+		if c.cancel != nil {
+			c.cancel()
+		}
+	}
 	close(c.create)
 }
 
diff --git a/transport/v2raygrpclite/conn_test.go b/transport/v2raygrpclite/conn_test.go
new file mode 100644
index 000000000..d74a1b348
--- /dev/null
+++ b/transport/v2raygrpclite/conn_test.go
@@ -0,0 +1,61 @@
+package v2raygrpclite
+
+import (
+	"context"
+	"io"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+// When RoundTrip fails (the server cannot be dialled), the request never establishes and
+// nothing reads the request-body pipe. A Write that started before the failure must not
+// block for ever: the client closes the read end of the pipe with the error, so the write
+// returns that error. Without the fix this test hangs and the goroutine and socket of every
+// such attempt leak.
+func TestLateGunConnWriteUnblocksOnSetupError(t *testing.T) {
+	t.Parallel()
+	pipeReader, pipeWriter := io.Pipe()
+	defer pipeReader.Close()
+	_, cancel := context.WithCancel(context.Background())
+	conn := newLateGunConn(pipeWriter, cancel)
+
+	writeErr := make(chan error, 1)
+	go func() {
+		_, err := conn.Write([]byte("handshake"))
+		writeErr <- err
+	}()
+
+	// the write is now blocked on the pipe that nobody reads
+	select {
+	case <-writeErr:
+		t.Fatal("write returned before the request failed")
+	case <-time.After(100 * time.Millisecond):
+	}
+
+	pipeReader.CloseWithError(syscall.ECONNREFUSED)
+	conn.setup(nil, syscall.ECONNREFUSED)
+
+	// the blocked write returns the dial error itself instead of hanging (the field case: the
+	// server refuses or is blackholed)
+	select {
+	case err := <-writeErr:
+		require.ErrorIs(t, err, syscall.ECONNREFUSED)
+	case <-time.After(5 * time.Second):
+		t.Fatal("write still blocked after setup failed: the goroutine and socket would leak")
+	}
+
+	// a write after the failure also returns at once, it does not block
+	done := make(chan struct{})
+	go func() {
+		conn.Write([]byte("after"))
+		close(done)
+	}()
+	select {
+	case <-done:
+	case <-time.After(5 * time.Second):
+		t.Fatal("a write after the failure blocked")
+	}
+}
