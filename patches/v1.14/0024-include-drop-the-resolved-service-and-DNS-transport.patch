From 3768c0ca813454026f9f5150340478ff768fbb83 Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Sat, 3 Oct 2026 10:46:09 +0300
Subject: [PATCH 024/118] include: drop the resolved service and DNS transport

They are the systemd-resolved D-Bus service, which OpenWrt does not run
and podkop never configures. Its D-Bus export makes the linker keep every
exported method of every type, so dropping it shrinks the package build
by about 15 % (1.14: 32.6 -> 27.8 MiB, 1.13: 28.2 -> 24.0 MiB on x86_64,
the same share on arm64, armv7 and mipsle). A config with a "resolved"
service or DNS server is now refused as an unknown type.
---
 include/registry.go | 3 ---
 1 file changed, 3 deletions(-)

diff --git a/include/registry.go b/include/registry.go
index e6d721b73..53a2dbc92 100644
--- a/include/registry.go
+++ b/include/registry.go
@@ -38,7 +38,6 @@ import (
 	"github.com/sagernet/sing-box/protocol/vless"
 	"github.com/sagernet/sing-box/protocol/vmess"
 	originca "github.com/sagernet/sing-box/service/origin_ca"
-	"github.com/sagernet/sing-box/service/resolved"
 	"github.com/sagernet/sing-box/service/ssmapi"
 	E "github.com/sagernet/sing/common/exceptions"
 )
@@ -127,7 +126,6 @@ func DNSTransportRegistry() *dns.TransportRegistry {
 	local.RegisterTransport(registry)
 	mdns.RegisterTransport(registry)
 	fakeip.RegisterTransport(registry)
-	resolved.RegisterTransport(registry)
 
 	registerQUICTransports(registry)
 	registerDHCPTransport(registry)
@@ -142,7 +140,6 @@ func ServiceRegistry() *service.Registry {
 	registry := service.NewRegistry()
 
 	registerAPIService(registry)
-	resolved.RegisterService(registry)
 	ssmapi.RegisterService(registry)
 
 	registerQUICServices(registry)
