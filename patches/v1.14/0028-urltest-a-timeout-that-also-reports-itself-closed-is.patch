From 25fbcb48aff8b91d70825026e253b9d102c2bfc5 Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Sat, 3 Oct 2026 18:18:20 +0300
Subject: [PATCH 28/68] urltest: a timeout that also reports itself closed is
 the member's failure

The dial failure of a member was not judged when the error matched
net.ErrClosed, a close the caller made. quic-go reports its idle and handshake
timeouts that way, so a Hysteria2 or TUIC server that went silent never counted:
on 1.13 the group stayed on it until the periodic URL test. A timeout now counts
even when it also matches net.ErrClosed.
---
 protocol/group/urltest_failure.go      |  8 ++++++--
 protocol/group/urltest_failure_test.go | 25 +++++++++++++++++++++++++
 2 files changed, 31 insertions(+), 2 deletions(-)

diff --git a/protocol/group/urltest_failure.go b/protocol/group/urltest_failure.go
index d97e0dcd2..2ad93ef02 100644
--- a/protocol/group/urltest_failure.go
+++ b/protocol/group/urltest_failure.go
@@ -58,8 +58,12 @@ func serverOnlyDial(outbound adapter.Outbound) bool {
 // write (start is zero).
 func (g *URLTestGroup) memberFailed(ctx context.Context, member adapter.Outbound, network string, err error, start time.Time) {
 	// A reset, an EOF, a closed pipe or a timeout are the member's: E.IsClosedOrCanceled
-	// counts them as closed, which suits a copy loop, not this.
-	if ctx.Err() != nil || errors.Is(err, net.ErrClosed) || errors.Is(err, os.ErrClosed) {
+	// counts them as closed, which suits a copy loop, not this. A timeout stays the
+	// member's even when it also reports itself closed: the idle and handshake timeouts of
+	// quic-go (Hysteria2, TUIC) match net.ErrClosed.
+	var netErr net.Error
+	timeout := errors.As(err, &netErr) && netErr.Timeout()
+	if ctx.Err() != nil || !timeout && (errors.Is(err, net.ErrClosed) || errors.Is(err, os.ErrClosed)) {
 		return
 	}
 	tag := RealTag(g.outbound, member)
diff --git a/protocol/group/urltest_failure_test.go b/protocol/group/urltest_failure_test.go
index bbfb13e72..726468644 100644
--- a/protocol/group/urltest_failure_test.go
+++ b/protocol/group/urltest_failure_test.go
@@ -110,6 +110,31 @@ func TestURLTestDialTimeoutSwitches(t *testing.T) {
 	waitSelected(t, group, "spare")
 }
 
+// quicIdleTimeout is the error quic-go gives when the server went silent: a timeout that
+// also matches net.ErrClosed.
+type quicIdleTimeout struct{}
+
+func (quicIdleTimeout) Error() string        { return "timeout: no recent network activity" }
+func (quicIdleTimeout) Timeout() bool        { return true }
+func (quicIdleTimeout) Temporary() bool      { return false }
+func (quicIdleTimeout) Is(target error) bool { return target == net.ErrClosed }
+
+// A Hysteria2 or TUIC server went silent: the QUIC connection times out and the dial fails
+// with an error that also reports itself closed. It is the server's failure, not a close
+// the caller made.
+func TestURLTestQUICTimeoutSwitches(t *testing.T) {
+	link, _ := testURL(t, 0)
+	silent := newTestMember(C.TypeHysteria2, "silent", func(context.Context, string, M.Socksaddr) (net.Conn, error) {
+		return nil, quicIdleTimeout{}
+	})
+	spare := newTestMember(C.TypeHysteria2, "spare", dialWorking)
+	urlTest, group := newTestURLTest(t, link, silent, spare)
+
+	_, err := urlTest.DialContext(context.Background(), N.NetworkTCP, M.ParseSocksaddr("1.2.3.4:443"))
+	require.ErrorIs(t, err, net.ErrClosed)
+	waitSelected(t, group, "spare")
+}
+
 // A socks member failed to reach one destination but works: one URL test proves it, the
 // group keeps it and its test result (the periodic test keeps its schedule), and the test
 // is not repeated for every failed connection. Each false alarm doubles the pause before
