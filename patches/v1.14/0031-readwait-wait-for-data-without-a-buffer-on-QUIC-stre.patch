+// (podkop-engine, see common/readwait).
+func (s *StreamWrapper) CreateReadWaiter() (N.ReadWaiter, bool) {
+	peekBuffer := make([]byte, 1)
+	return readwait.NewPeekWaiter(s, func() error {
+		_, err := s.Stream.Peek(peekBuffer)
+		return err
+	}), true
+}
