diff --git a/common/readwait/peek.go b/common/readwait/peek.go
new file mode 100644
index 000000000..2b11e2c6e
--- /dev/null
+++ b/common/readwait/peek.go
@@ -0,0 +1,101 @@
+// Package readwait lets connections that can wait for data without consuming it wait
+// without a buffer (podkop-engine).
+//
+// The copy loop of sing takes a pool buffer before every blocking read of a source that has
+// no read waiter, so an idle proxied connection held a 32 KiB buffer (64 KiB after 512 KB)
+// for as long as its server stayed silent. A connection that can wait for data without
+// consuming it (a quic-go stream, a bufio reader) gets a read waiter here: it waits first,
+// then takes the buffer and reads through the connection's own Read, so the framing and the
+// errors stay the connection's.
+package readwait
+
+import (
+	"io"
+	"net"
+
+	"github.com/sagernet/sing/common/buf"
+	N "github.com/sagernet/sing/common/network"
+)
+
+type PeekWaiter struct {
+	reader  io.Reader
+	wait    func() error
+	options N.ReadWaitOptions
+	pending error
+}
+
+// NewPeekWaiter returns a read waiter that calls wait until data can be read, then reads
+// from reader. wait must not consume anything; its error is left to the read, which
+// reports it the way the connection does.
+func NewPeekWaiter(reader io.Reader, wait func() error) *PeekWaiter {
+	return &PeekWaiter{reader: reader, wait: wait}
+}
+
+func (w *PeekWaiter) InitializeReadWaiter(options N.ReadWaitOptions) (needCopy bool) {
+	w.options = options
+	return false
+}
+
+func (w *PeekWaiter) WaitReadBuffer() (*buf.Buffer, error) {
+	if w.pending != nil {
+		err := w.pending
+		w.pending = nil
+		return nil, err
+	}
+	for {
+		waitErr := w.wait()
+		buffer := w.options.NewBuffer()
+		n, err := w.reader.Read(buffer.FreeBytes())
+		if n > 0 {
+			buffer.Truncate(n)
+			w.options.PostReturn(buffer)
+			w.pending = err // delivered with the next call, as io.Reader allows
+			return buffer, nil
+		}
+		buffer.Release()
+		if err != nil {
+			return nil, err
+		}
+		if waitErr != nil {
+			return nil, waitErr
+		}
+		// an empty read (an empty frame): wait again without holding the buffer
+	}
+}
+
+type quicStream interface {
+	Peek(b []byte) (int, error)
+}
+
+// QUICStreamConn is a connection over a quic-go stream: Peek blocks until data arrives
+// (or the stream ends, fails, or reaches its read deadline) and consumes nothing.
+type QUICStreamConn struct {
+	net.Conn
+	stream     quicStream
+	peekBuffer [1]byte
+}
+
+// NewQUICStreamConn gives conn a read waiter when it is a quic-go stream with Peek, as the
+// TCP connections of Hysteria2 and TUIC are; other connections are returned as they are.
+func NewQUICStreamConn(conn net.Conn) net.Conn {
+	stream, isStream := conn.(quicStream)
+	if !isStream {
+		return conn
+	}
+	return &QUICStreamConn{Conn: conn, stream: stream}
+}
+
+func (c *QUICStreamConn) CreateReadWaiter() (N.ReadWaiter, bool) {
+	return NewPeekWaiter(c.Conn, func() error {
+		_, err := c.stream.Peek(c.peekBuffer[:])
+		return err
+	}), true
+}
+
+func (c *QUICStreamConn) Upstream() any {
+	return c.Conn
+}
+
+func (c *QUICStreamConn) WriterReplaceable() bool {
+	return true
+}
diff --git a/common/readwait/peek_test.go b/common/readwait/peek_test.go
new file mode 100644
index 000000000..9a56976d5
--- /dev/null
+++ b/common/readwait/peek_test.go
@@ -0,0 +1,146 @@
+package readwait
+
+import (
+	"bufio"
+	"bytes"
+	"errors"
+	"io"
+	"net"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	sbufio "github.com/sagernet/sing/common/bufio"
+	N "github.com/sagernet/sing/common/network"
+
+	"github.com/stretchr/testify/require"
+)
+
+// fakeStream is a stream with a quic-go style Peek over a pipe. A Read that has to wait
+// for data counts as a failure: the read waiter must call Read only once data is there.
+type fakeStream struct {
+	net.Conn
+	reader      *bufio.Reader
+	earlyReads  atomic.Int32
+	peeks       atomic.Int32
+	readLengths []int
+}
+
+func newFakeStream(conn net.Conn) *fakeStream {
+	return &fakeStream{Conn: conn, reader: bufio.NewReader(conn)}
+}
+
+func (s *fakeStream) Peek(b []byte) (int, error) {
+	s.peeks.Add(1)
+	peeked, err := s.reader.Peek(len(b))
+	return copy(b, peeked), err
+}
+
+func (s *fakeStream) Read(b []byte) (int, error) {
+	buffered := s.reader.Buffered()
+	s.readLengths = append(s.readLengths, len(b))
+	n, err := s.reader.Read(b)
+	if buffered == 0 && n > 0 {
+		s.earlyReads.Add(1) // the read had to wait for this data
+	}
+	return n, err
+}
+
+// The copy loop of sing finds the read waiter, waits with Peek and reads only once data has
+// arrived, with the full buffer; the bytes arrive intact and in order.
+func TestQUICStreamConnCopy(t *testing.T) {
+	remote, local := net.Pipe()
+	stream := newFakeStream(local)
+	conn := NewQUICStreamConn(stream)
+	_, isCreator := conn.(N.ReadWaitCreator)
+	require.True(t, isCreator)
+
+	var output bytes.Buffer
+	done := make(chan error, 1)
+	go func() {
+		_, err := sbufio.Copy(&output, conn)
+		done <- err
+	}()
+	var sent bytes.Buffer
+	for i := 0; i < 5; i++ {
+		chunk := bytes.Repeat([]byte{byte('a' + i)}, 100*(i+1))
+		sent.Write(chunk)
+		_, err := remote.Write(chunk)
+		require.NoError(t, err)
+		time.Sleep(20 * time.Millisecond) // the copy loop waits in between
+	}
+	remote.Close()
+	require.NoError(t, <-done)
+	require.Equal(t, sent.Bytes(), output.Bytes())
+	require.Zero(t, stream.earlyReads.Load(), "a read waited for data while holding the buffer")
+	require.Greater(t, stream.peeks.Load(), int32(0))
+	for _, length := range stream.readLengths {
+		require.GreaterOrEqual(t, length, 4096, "the read did not get the copy loop's buffer")
+	}
+}
+
+// A connection without Peek is returned as it is.
+func TestQUICStreamConnWithoutPeek(t *testing.T) {
+	side, peer := net.Pipe()
+	defer side.Close()
+	defer peer.Close()
+	require.Equal(t, side, NewQUICStreamConn(side))
+}
+
+type scriptedReader struct {
+	results []readResult
+}
+
+type readResult struct {
+	data string
+	err  error
+}
+
+func (r *scriptedReader) Read(b []byte) (int, error) {
+	if len(r.results) == 0 {
+		return 0, io.EOF
+	}
+	result := r.results[0]
+	r.results = r.results[1:]
+	return copy(b, result.data), result.err
+}
+
+// Data that comes with an error is delivered first, the error with the next call; empty
+// reads (empty frames) are skipped; a failed wait with an empty read ends the waiting.
+func TestPeekWaiterResults(t *testing.T) {
+	failure := errors.New("reset")
+	reader := &scriptedReader{results: []readResult{{"", nil}, {"data", failure}}}
+	waiter := NewPeekWaiter(reader, func() error { return nil })
+	waiter.InitializeReadWaiter(N.ReadWaitOptions{})
+	buffer, err := waiter.WaitReadBuffer()
+	require.NoError(t, err)
+	require.Equal(t, "data", string(buffer.Bytes()))
+	buffer.Release()
+	_, err = waiter.WaitReadBuffer()
+	require.ErrorIs(t, err, failure)
+
+	waitFailure := errors.New("deadline")
+	reader = &scriptedReader{results: []readResult{{"", nil}}}
+	waiter = NewPeekWaiter(reader, func() error { return waitFailure })
+	waiter.InitializeReadWaiter(N.ReadWaitOptions{})
+	_, err = waiter.WaitReadBuffer()
+	require.ErrorIs(t, err, waitFailure)
+}
+
+// The same stream without the read waiter: sing's copy loop reads with its buffer before the
+// data is there, which is what the read waiter avoids (and what the check above detects).
+func TestCopyWithoutReadWaiterHoldsBuffer(t *testing.T) {
+	remote, local := net.Pipe()
+	stream := newFakeStream(local)
+	done := make(chan error, 1)
+	go func() {
+		_, err := sbufio.Copy(io.Discard, stream)
+		done <- err
+	}()
+	time.Sleep(20 * time.Millisecond)
+	_, err := remote.Write([]byte("data"))
+	require.NoError(t, err)
+	remote.Close()
+	require.NoError(t, <-done)
+	require.Positive(t, stream.earlyReads.Load())
+}
