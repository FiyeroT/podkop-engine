diff --git a/transport/v2rayxhttp/reality_stub.go b/transport/v2rayxhttp/reality_stub.go
new file mode 100644
index 000000000..298c74af5
--- /dev/null
+++ b/transport/v2rayxhttp/reality_stub.go
@@ -0,0 +1,9 @@
+//go:build !with_utls
+
+package v2rayxhttp
+
+import "github.com/sagernet/sing-box/common/tls"
+
+func isReality(config tls.Config) bool {
+	return false
+}
diff --git a/transport/v2rayxhttp/request.go b/transport/v2rayxhttp/request.go
new file mode 100644
index 000000000..9f9d666a9
--- /dev/null
+++ b/transport/v2rayxhttp/request.go
@@ -0,0 +1,220 @@
+package v2rayxhttp
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"encoding/base64"
+	"io"
+	"math"
+	"net/http"
+	"net/url"
+	"strconv"
+	"strings"
+
+	"golang.org/x/net/http2/hpack"
+)
+
+// The request layout follows Xray-core transport/internet/splithttp
+// (config.go, xpadding.go, v26.9.9): where the session ID, the sequence
+// number, the padding and packet-up data go is set by the leg's config.
+
+func (c *requestConfig) baseURL(scheme string) *url.URL {
+	return &url.URL{
+		Scheme:   scheme,
+		Host:     c.host,
+		Path:     c.normalizedPath(),
+		RawQuery: c.rawQuery,
+	}
+}
+
+// newStreamRequest builds a download GET (body == nil) or the request whose
+// body streams the upload (stream-up, stream-one).
+func (c *requestConfig) newStreamRequest(ctx context.Context, scheme string, sessionID string, body io.ReadCloser) *http.Request {
+	method := http.MethodGet
+	if body != nil {
+		method = c.uplinkHTTPMethod
+	}
+	request := c.newRequest(ctx, method, scheme)
+	if body != nil {
+		request.Body = body
+		// The length is unknown: chunked on HTTP/1.1, DATA frames until
+		// END_STREAM on HTTP/2 and 3.
+		request.ContentLength = -1
+	}
+	c.applyPadding(request)
+	c.applyMeta(request, sessionID, "")
+	if body != nil && !c.noGRPCHeader {
+		// Reverse proxies and CDNs stream a response without buffering when they
+		// see gRPC; Xray sends this unless no_grpc_header is set.
+		request.Header.Set("Content-Type", "application/grpc")
+	}
+	return request
+}
+
+// newPacketRequest builds one packet-up upload carrying data.
+func (c *requestConfig) newPacketRequest(ctx context.Context, scheme string, sessionID string, seq string, data []byte) *http.Request {
+	request := c.newRequest(ctx, c.uplinkHTTPMethod, scheme)
+	switch c.uplinkDataPlacement {
+	case placementHeader:
+		encoded := base64.RawURLEncoding.EncodeToString(data)
+		for i := 0; len(encoded) > 0; i++ {
+			size := min(c.chunkSize(), len(encoded))
+			request.Header.Set(c.uplinkDataKey+"-"+strconv.Itoa(i), encoded[:size])
+			encoded = encoded[size:]
+		}
+	case placementCookie:
+		encoded := base64.RawURLEncoding.EncodeToString(data)
+		for i := 0; len(encoded) > 0; i++ {
+			size := min(c.chunkSize(), len(encoded))
+			request.AddCookie(&http.Cookie{Name: c.uplinkDataKey + "_" + strconv.Itoa(i), Value: encoded[:size]})
+			encoded = encoded[size:]
+		}
+	default:
+		request.Body = io.NopCloser(bytes.NewReader(data))
+		request.ContentLength = int64(len(data))
+		// HTTP/2 replays a request the server refused with GOAWAY before it was
+		// processed; without GetBody it cannot (Xray dffc7ada).
+		request.GetBody = func() (io.ReadCloser, error) {
+			return io.NopCloser(bytes.NewReader(data)), nil
+		}
+	}
+	c.applyPadding(request)
+	c.applyMeta(request, sessionID, seq)
+	return request
+}
+
+func (c *requestConfig) newRequest(ctx context.Context, method string, scheme string) *http.Request {
+	request := &http.Request{
+		Method:     method,
+		URL:        c.baseURL(scheme),
+		Proto:      "HTTP/1.1",
+		ProtoMajor: 1,
+		ProtoMinor: 1,
+		// The options' header map is shared by all requests: each request gets
+		// its own copy, so that nothing written below reaches another request.
+		Header: c.header.Clone(),
+		Host:   c.host,
+	}
+	if request.Header == nil {
+		request.Header = make(http.Header)
+	}
+	return request.WithContext(ctx)
+}
+
+func appendToPath(path string, value string) string {
+	if strings.HasSuffix(path, "/") {
+		return path + value
+	}
+	return path + "/" + value
+}
+
+func (c *requestConfig) applyMeta(request *http.Request, sessionID string, seq string) {
+	if sessionID != "" {
+		c.place(request, c.sessionPlacement, c.sessionKey, sessionID)
+	}
+	if seq != "" {
+		c.place(request, c.seqPlacement, c.seqKey, seq)
+	}
+}
+
+func (c *requestConfig) place(request *http.Request, placement string, key string, value string) {
+	switch placement {
+	case placementPath:
+		request.URL.Path = appendToPath(request.URL.Path, value)
+	case placementQuery:
+		query := request.URL.Query()
+		query.Set(key, value)
+		request.URL.RawQuery = query.Encode()
+	case placementHeader:
+		request.Header.Set(key, value)
+	case placementCookie:
+		request.AddCookie(&http.Cookie{Name: key, Value: value})
+	}
+}
+
+// applyPadding adds the random padding. It is computed from the URL before the
+// session ID and sequence number are placed, as Xray does.
+func (c *requestConfig) applyPadding(request *http.Request) {
+	length := int(c.paddingBytes.rand())
+	placement, key, header, method := placementQueryInHeader, "x_padding", "Referer", paddingMethodRepeatX
+	if c.paddingObfsMode {
+		placement, key, header, method = c.paddingPlacement, c.paddingKey, c.paddingHeader, c.paddingMethod
+	}
+	padding := generatePadding(method, length)
+	switch placement {
+	case placementHeader:
+		request.Header.Set(header, padding)
+	case placementQueryInHeader:
+		paddedURL := *request.URL
+		paddedURL.RawQuery = key + "=" + padding
+		request.Header.Set(header, paddedURL.String())
+	case placementCookie:
+		request.AddCookie(&http.Cookie{Name: key, Value: padding, Path: "/"})
+	case placementQuery:
+		query := request.URL.Query()
+		query.Set(key, padding)
+		request.URL.RawQuery = query.Encode()
+	}
+}
+
+const base62Characters = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
+
+// generatePadding returns length bytes of padding as they will travel in
+// HPACK/QPACK: 'X' (and 'Z') take 8 bits in the static Huffman table, so
+// repeat-x keeps its length on the wire; tokenish is random base62 sized by
+// its Huffman length, give or take 2.
+func generatePadding(method string, length int) string {
+	if length <= 0 {
+		return ""
+	}
+	if method == paddingMethodTokenish {
+		if padding := tokenishPadding(length); padding != "" {
+			return padding
+		}
+	}
+	return strings.Repeat("X", length)
+}
+
+func tokenishPadding(target int) string {
+	// Base62 averages 0.8 Huffman bytes per character.
+	n := max(1, int(math.Ceil(float64(target)/0.8)))
+	padding := make([]byte, 0, n+16)
+	random := make([]byte, 256)
+	limit := byte(256 - 256%len(base62Characters))
+	for len(padding) < n {
+		if _, err := rand.Read(random); err != nil {
+			return ""
+		}
+		for _, b := range random {
+			if b >= limit {
+				continue
+			}
+			padding = append(padding, base62Characters[int(b)%len(base62Characters)])
+			if len(padding) == n {
+				break
+			}
+		}
+	}
+	adjust := byte('X')
+	for iteration := 0; iteration < 150; iteration++ {
+		diff := int(hpack.HuffmanEncodeLength(string(padding))) - target
+		if diff >= -2 && diff <= 2 {
+			break
+		}
+		if diff < 0 {
+			padding = append(padding, adjust)
+			if adjust == 'X' {
+				adjust = 'Z'
+			} else {
+				adjust = 'X'
+			}
+		} else {
+			if len(padding) <= 1 {
+				break
+			}
+			padding = padding[:len(padding)-1]
+		}
+	}
+	return string(padding)
+}
diff --git a/transport/v2rayxhttp/server_test.go b/transport/v2rayxhttp/server_test.go
new file mode 100644
index 000000000..a635c4373
--- /dev/null
+++ b/transport/v2rayxhttp/server_test.go
@@ -0,0 +1,333 @@
+package v2rayxhttp
+
+import (
+	"encoding/base64"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+)
+
+// testServer is an XHTTP server for the tests, after Xray's hub.go: it reads the
+// session ID, the sequence number and packet-up data where config places them,
+// checks the padding, puts packet-up uploads back in order and echoes every
+// session's upload on its download.
+type testServer struct {
+	t      *testing.T
+	config *requestConfig
+	server *httptest.Server
+
+	// holdDownload makes a download wait for the first upload of its session,
+	// as an Xray server behind a CDN effectively does.
+	holdDownload   bool
+	downloadStatus int
+	uploadStatus   int
+	// abortUploads resets every upload request (RST_STREAM on HTTP/2).
+	abortUploads bool
+
+	access   sync.Mutex
+	sessions map[string]*testSession
+	requests map[string]int
+}
+
+type testSession struct {
+	access    sync.Mutex
+	nextSeq   int64
+	buffered  map[int64][]byte
+	echo      chan []byte
+	firstData chan struct{}
+	firstOnce sync.Once
+}
+
+func newTestServer(t *testing.T, config *requestConfig, mode string) *testServer {
+	s := &testServer{
+		t:        t,
+		config:   config,
+		sessions: make(map[string]*testSession),
+		requests: make(map[string]int),
+	}
+	s.server = httptest.NewUnstartedServer(http.HandlerFunc(s.serveHTTP))
+	switch mode {
+	case "h2":
+		s.server.EnableHTTP2 = true
+		s.server.StartTLS()
+	case "h1-tls":
+		s.server.StartTLS()
+	default:
+		s.server.Start()
+	}
+	t.Cleanup(s.server.Close)
+	return s
+}
+
+func (s *testServer) session(id string) *testSession {
+	s.access.Lock()
+	defer s.access.Unlock()
+	session := s.sessions[id]
+	if session == nil {
+		session = &testSession{
+			buffered:  make(map[int64][]byte),
+			echo:      make(chan []byte, 1024),
+			firstData: make(chan struct{}),
+		}
+		s.sessions[id] = session
+	}
+	return session
+}
+
+func (s *testServer) count(kind string) {
+	s.access.Lock()
+	s.requests[kind]++
+	s.access.Unlock()
+}
+
+func (s *testServer) requestCount(kind string) int {
+	s.access.Lock()
+	defer s.access.Unlock()
+	return s.requests[kind]
+}
+
+func (ts *testSession) push(data []byte) {
+	ts.firstOnce.Do(func() { close(ts.firstData) })
+	if len(data) > 0 {
+		ts.echo <- data
+	}
+}
+
+// pushPacket queues one packet-up upload and releases those now in order.
+func (ts *testSession) pushPacket(seq int64, data []byte) {
+	ts.access.Lock()
+	ts.buffered[seq] = data
+	var ready [][]byte
+	for {
+		next, loaded := ts.buffered[ts.nextSeq]
+		if !loaded {
+			break
+		}
+		delete(ts.buffered, ts.nextSeq)
+		ts.nextSeq++
+		ready = append(ready, next)
+	}
+	ts.access.Unlock()
+	for _, data := range ready {
+		ts.push(data)
+	}
+}
+
+func (s *testServer) checkPadding(r *http.Request) bool {
+	c := s.config
+	var padding string
+	if !c.paddingObfsMode {
+		referer, err := url.Parse(r.Header.Get("Referer"))
+		if err != nil {
+			return false
+		}
+		padding = referer.Query().Get("x_padding")
+	} else {
+		switch c.paddingPlacement {
+		case placementHeader:
+			padding = r.Header.Get(c.paddingHeader)
+		case placementQueryInHeader:
+			value, err := url.Parse(r.Header.Get(c.paddingHeader))
+			if err != nil {
+				return false
+			}
+			padding = value.Query().Get(c.paddingKey)
+		case placementCookie:
+			cookie, err := r.Cookie(c.paddingKey)
+			if err != nil {
+				return false
+			}
+			padding = cookie.Value
+		case placementQuery:
+			padding = r.URL.Query().Get(c.paddingKey)
+		}
+	}
+	if c.paddingObfsMode && c.paddingMethod == paddingMethodTokenish {
+		// tokenish is sized by its Huffman length, within 2.
+		return len(padding) > 0
+	}
+	return len(padding) >= int(c.paddingBytes.from) && len(padding) <= int(c.paddingBytes.to)
+}
+
+// meta reads the session ID and the sequence number as Xray's
+// ExtractMetaFromRequest does.
+func (s *testServer) meta(r *http.Request) (string, string) {
+	c := s.config
+	var parts []string
+	if c.sessionPlacement == placementPath || c.seqPlacement == placementPath {
+		parts = strings.Split(strings.TrimPrefix(r.URL.Path, c.normalizedPath()), "/")
+	}
+	index := 0
+	read := func(placement string, key string) string {
+		switch placement {
+		case placementPath:
+			if index < len(parts) {
+				index++
+				return parts[index-1]
+			}
+		case placementQuery:
+			return r.URL.Query().Get(key)
+		case placementHeader:
+			return r.Header.Get(key)
+		case placementCookie:
+			if cookie, err := r.Cookie(key); err == nil {
+				return cookie.Value
+			}
+		}
+		return ""
+	}
+	sessionID := read(c.sessionPlacement, c.sessionKey)
+	seq := read(c.seqPlacement, c.seqKey)
+	return sessionID, seq
+}
+
+func (s *testServer) packetData(r *http.Request) ([]byte, error) {
+	c := s.config
+	switch c.uplinkDataPlacement {
+	case placementHeader:
+		var encoded strings.Builder
+		for i := 0; ; i++ {
+			value := r.Header.Get(c.uplinkDataKey + "-" + strconv.Itoa(i))
+			if value == "" {
+				break
+			}
+			encoded.WriteString(value)
+		}
+		return base64.RawURLEncoding.DecodeString(encoded.String())
+	case placementCookie:
+		var encoded strings.Builder
+		for i := 0; ; i++ {
+			cookie, err := r.Cookie(c.uplinkDataKey + "_" + strconv.Itoa(i))
+			if err != nil {
+				break
+			}
+			encoded.WriteString(cookie.Value)
+		}
+		return base64.RawURLEncoding.DecodeString(encoded.String())
+	default:
+		return io.ReadAll(r.Body)
+	}
+}
+
+func (s *testServer) serveHTTP(w http.ResponseWriter, r *http.Request) {
+	if !strings.HasPrefix(r.URL.Path, s.config.normalizedPath()) {
+		s.count("not-found")
+		w.WriteHeader(http.StatusNotFound)
+		return
+	}
+	if !s.checkPadding(r) {
+		s.count("bad-padding")
+		w.WriteHeader(http.StatusBadRequest)
+		return
+	}
+	sessionID, seq := s.meta(r)
+	isUpload := r.Method != http.MethodGet || seq != ""
+	switch {
+	case sessionID == "":
+		s.count("stream-one")
+		s.serveStreamOne(w, r)
+	case !isUpload:
+		s.count("download")
+		s.serveDownload(w, r, s.session(sessionID))
+	case seq != "":
+		s.count("packet")
+		if s.abortUploads {
+			panic(http.ErrAbortHandler)
+		}
+		if s.uploadStatus != 0 {
+			w.WriteHeader(s.uploadStatus)
+			return
+		}
+		number, err := strconv.ParseInt(seq, 10, 64)
+		if err != nil {
+			w.WriteHeader(http.StatusBadRequest)
+			return
+		}
+		data, err := s.packetData(r)
+		if err != nil {
+			w.WriteHeader(http.StatusBadRequest)
+			return
+		}
+		s.session(sessionID).pushPacket(number, data)
+		w.WriteHeader(http.StatusOK)
+	default:
+		s.count("stream-up")
+		if s.abortUploads {
+			panic(http.ErrAbortHandler)
+		}
+		if s.uploadStatus != 0 {
+			w.WriteHeader(s.uploadStatus)
+			return
+		}
+		session := s.session(sessionID)
+		http.NewResponseController(w).EnableFullDuplex()
+		w.WriteHeader(http.StatusOK)
+		w.(http.Flusher).Flush()
+		buffer := make([]byte, 32*1024)
+		for {
+			n, err := r.Body.Read(buffer)
+			if n > 0 {
+				session.push(append([]byte(nil), buffer[:n]...))
+			}
+			if err != nil {
+				return
+			}
+		}
+	}
+}
+
+func (s *testServer) serveDownload(w http.ResponseWriter, r *http.Request, session *testSession) {
+	if s.holdDownload {
+		select {
+		case <-session.firstData:
+		case <-r.Context().Done():
+			return
+		}
+	}
+	if s.downloadStatus != 0 {
+		w.WriteHeader(s.downloadStatus)
+		return
+	}
+	w.Header().Set("Content-Type", "text/event-stream")
+	w.WriteHeader(http.StatusOK)
+	w.(http.Flusher).Flush()
+	for {
+		select {
+		case data := <-session.echo:
+			if _, err := w.Write(data); err != nil {
+				return
+			}
+			w.(http.Flusher).Flush()
+		case <-r.Context().Done():
+			return
+		}
+	}
+}
+
+func (s *testServer) serveStreamOne(w http.ResponseWriter, r *http.Request) {
+	if s.downloadStatus != 0 {
+		w.WriteHeader(s.downloadStatus)
+		return
+	}
+	http.NewResponseController(w).EnableFullDuplex()
+	w.WriteHeader(http.StatusOK)
+	w.(http.Flusher).Flush()
+	buffer := make([]byte, 32*1024)
+	for {
+		n, err := r.Body.Read(buffer)
+		if n > 0 {
+			if _, writeErr := w.Write(buffer[:n]); writeErr != nil {
+				return
+			}
+			w.(http.Flusher).Flush()
+		}
+		if err != nil {
+			return
+		}
+	}
+}
diff --git a/transport/v2rayxhttp/upload.go b/transport/v2rayxhttp/upload.go
new file mode 100644
index 000000000..509e776a3
--- /dev/null
+++ b/transport/v2rayxhttp/upload.go
@@ -0,0 +1,198 @@
+package v2rayxhttp
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptrace"
+	"strconv"
+	"sync"
+	"time"
+
+	E "github.com/sagernet/sing/common/exceptions"
+)
+
+// maxUploadBacklog bounds what a packet-up session buffers before its writes
+// wait: Xray buffers up to sc_max_each_post_bytes, a megabyte by default, and
+// on a router a megabyte per uploading connection adds up.
+const maxUploadBacklog = 1024 * 1024
+
+// uploader sends the writes of a packet-up session as numbered requests. Writes
+// are batched while a request is on its way, so that each request carries what
+// accumulated meanwhile, up to the request size drawn for the session.
+type uploader struct {
+	session   *session
+	client    *Client
+	sessionID string
+	maxSize   int
+	backlog   int
+
+	access   sync.Mutex
+	pending  []byte
+	err      error
+	readable chan struct{}
+	writable chan struct{}
+	done     chan struct{}
+	doneOnce sync.Once
+
+	// current is the client the uploads go through until it runs out of its
+	// request budget; the uploader holds it (one running count).
+	current *poolClient
+}
+
+func newUploader(s *session, client *Client, sessionID string, current *poolClient) *uploader {
+	maxSize := int(client.up.maxEachPostBytes.rand())
+	return &uploader{
+		session:   s,
+		client:    client,
+		sessionID: sessionID,
+		maxSize:   maxSize,
+		backlog:   min(maxSize, maxUploadBacklog),
+		readable:  make(chan struct{}, 1),
+		writable:  make(chan struct{}, 1),
+		done:      make(chan struct{}),
+		current:   current,
+	}
+}
+
+func notify(channel chan struct{}) {
+	select {
+	case channel <- struct{}{}:
+	default:
+	}
+}
+
+func (u *uploader) write(b []byte) (int, error) {
+	var n int
+	for len(b) > 0 {
+		u.access.Lock()
+		if u.err != nil {
+			err := u.err
+			u.access.Unlock()
+			return n, err
+		}
+		space := u.backlog - len(u.pending)
+		if space > 0 {
+			take := min(space, len(b))
+			u.pending = append(u.pending, b[:take]...)
+			b = b[take:]
+			n += take
+			u.access.Unlock()
+			notify(u.readable)
+			continue
+		}
+		u.access.Unlock()
+		select {
+		case <-u.writable:
+		case <-u.done:
+		}
+	}
+	return n, nil
+}
+
+// interrupt stops the uploader: writes fail with err from then on.
+func (u *uploader) interrupt(err error) {
+	u.access.Lock()
+	if u.err == nil {
+		u.err = err
+	}
+	u.pending = nil
+	u.access.Unlock()
+	u.doneOnce.Do(func() { close(u.done) })
+}
+
+func (u *uploader) run() {
+	defer func() {
+		if u.current != nil {
+			u.current.release()
+		}
+	}()
+	var (
+		seq      int64
+		lastPost time.Time
+	)
+	for {
+		select {
+		case <-u.readable:
+		case <-u.done:
+			return
+		}
+		u.access.Lock()
+		// The backlog never exceeds the request size, so all of it fits in one
+		// request and is handed over without a copy.
+		data := u.pending
+		u.pending = nil
+		u.access.Unlock()
+		if len(data) == 0 {
+			continue
+		}
+		notify(u.writable)
+		if interval := u.client.up.minPostsIntervalMs.rand(); interval > 0 {
+			wait := time.Duration(interval)*time.Millisecond - time.Since(lastPost)
+			if wait > 0 {
+				timer := time.NewTimer(wait)
+				select {
+				case <-timer.C:
+				case <-u.done:
+					timer.Stop()
+					return
+				}
+			}
+		}
+		lastPost = time.Now()
+		client, err := u.nextClient()
+		if err != nil {
+			u.session.fail(E.Cause(err, "xhttp: upload"))
+			return
+		}
+		wrote := make(chan struct{})
+		go u.post(client, strconv.FormatInt(seq, 10), data, wrote)
+		seq++
+		// The next request goes once this one is written, not answered.
+		select {
+		case <-wrote:
+		case <-u.done:
+			return
+		}
+	}
+}
+
+// nextClient returns the client for the next upload with one running count
+// for that upload: the current one while it has request budget, otherwise a
+// new one from the pool, which becomes current.
+func (u *uploader) nextClient() (*poolClient, error) {
+	if u.current != nil && u.current.usable() {
+		u.current.running.Add(1)
+		return u.current, nil
+	}
+	client, err := u.client.upPool.get()
+	if err != nil {
+		return nil, err
+	}
+	if u.current != nil {
+		u.current.release()
+	}
+	client.running.Add(1)
+	u.current = client
+	return client, nil
+}
+
+func (u *uploader) post(client *poolClient, seq string, data []byte, wrote chan struct{}) {
+	defer client.release()
+	var once sync.Once
+	written := func() { once.Do(func() { close(wrote) }) }
+	defer written()
+	ctx := context.WithValue(u.session.ctx, packetRequestKey{}, true)
+	ctx = httptrace.WithClientTrace(ctx, &httptrace.ClientTrace{
+		WroteRequest: func(httptrace.WroteRequestInfo) { written() },
+	})
+	request := u.client.up.newPacketRequest(ctx, u.client.upScheme, u.sessionID, seq, data)
+	response, err := client.roundTrip(request)
+	if err != nil {
+		u.session.fail(E.Cause(err, "xhttp: upload"))
+		return
+	}
+	discardBody(response.Body)
+	if response.StatusCode != http.StatusOK {
+		u.session.fail(E.New("xhttp: upload: unexpected status ", response.Status))
+	}
+}
