From acf623fa1add5c440456402833e904f17e38de3c Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Mon, 5 Oct 2026 11:40:39 +0300
Subject: [PATCH 48/88] xhttp: a small default request size for uploads carried
 in headers or cookies

---
 transport/v2rayxhttp/config.go      | 8 ++++++++
 transport/v2rayxhttp/config_test.go | 8 ++++++++
 2 files changed, 16 insertions(+)

diff --git a/transport/v2rayxhttp/config.go b/transport/v2rayxhttp/config.go
index cf7d92f3a..c8ac881e9 100644
--- a/transport/v2rayxhttp/config.go
+++ b/transport/v2rayxhttp/config.go
@@ -31,6 +31,7 @@ const (
 
 	maxPaddingBytes    = 64 * 1024
 	maxSessionIDLength = 1024
+	headerUploadSize   = 4096
 )
 
 // valueRange is an inclusive range a value is drawn from at random; the zero
@@ -248,6 +249,13 @@ func newRequestConfig(options option.V2RayXHTTPBaseOptions, mode string) (*reque
 	c.maxEachPostBytes = newValueRange(options.ScMaxEachPostBytes)
 	if c.maxEachPostBytes.to == 0 {
 		c.maxEachPostBytes = valueRange{1000000, 1000000}
+		if c.uplinkDataPlacement == placementHeader || c.uplinkDataPlacement == placementCookie {
+			// Unlike Xray: its megabyte per request, carried in headers or
+			// cookies, is far over the 8 KiB of headers servers accept, so a
+			// bulk upload failed. 4 KiB fits with the default padding (lab:
+			// 4 KiB passed, 6 KiB did not).
+			c.maxEachPostBytes = valueRange{headerUploadSize, headerUploadSize}
+		}
 	} else if c.maxEachPostBytes.from <= 0 {
 		// Xray panics at the dial on this value.
 		return nil, E.New("sc_max_each_post_bytes must be greater than 0")
diff --git a/transport/v2rayxhttp/config_test.go b/transport/v2rayxhttp/config_test.go
index cdfe3f2cb..2f744002a 100644
--- a/transport/v2rayxhttp/config_test.go
+++ b/transport/v2rayxhttp/config_test.go
@@ -85,6 +85,14 @@ func TestXHTTPConfigDefaults(t *testing.T) {
 	require.Equal(t, valueRange{30, 30}, config.minPostsIntervalMs)
 	require.Equal(t, xmuxConfig{maxConnections: valueRange{3, 3}, hMaxRequestTimes: valueRange{600, 900}, hMaxReusableSecs: valueRange{1800, 3000}}, config.xmux)
 	require.Equal(t, "/", config.normalizedPath())
+	for _, placement := range []string{placementHeader, placementCookie} {
+		config, err = newRequestConfig(option.V2RayXHTTPBaseOptions{UplinkDataPlacement: placement}, modePacketUp)
+		require.NoError(t, err)
+		require.Equal(t, valueRange{4096, 4096}, config.maxEachPostBytes, placement)
+		config, err = newRequestConfig(option.V2RayXHTTPBaseOptions{UplinkDataPlacement: placement, ScMaxEachPostBytes: xrange(2048, 2048)}, modePacketUp)
+		require.NoError(t, err)
+		require.Equal(t, valueRange{2048, 2048}, config.maxEachPostBytes, placement)
+	}
 	// Setting any XMUX field drops all its defaults, as with Xray.
 	config, err = newRequestConfig(option.V2RayXHTTPBaseOptions{Xmux: &option.V2RayXHTTPXmuxOptions{HKeepAlivePeriod: 30}}, modeAuto)
 	require.NoError(t, err)
-- 
