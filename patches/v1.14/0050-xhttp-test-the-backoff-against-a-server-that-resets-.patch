From 5e2313f4ab127ebf2aa53b45eb9159886a6f9dc7 Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Mon, 5 Oct 2026 12:23:53 +0300
Subject: [PATCH 50/88] xhttp: test the backoff against a server that resets
 every upload

---
 transport/v2rayxhttp/client_test.go | 24 ++++++++++++++++++++++++
 transport/v2rayxhttp/server_test.go | 14 ++++++++++++++
 2 files changed, 38 insertions(+)

diff --git a/transport/v2rayxhttp/client_test.go b/transport/v2rayxhttp/client_test.go
index cac128bc6..781e04d3c 100644
--- a/transport/v2rayxhttp/client_test.go
+++ b/transport/v2rayxhttp/client_test.go
@@ -518,3 +518,27 @@ func TestXHTTPPoolIdleRetire(t *testing.T) {
 		})
 	}
 }
+
+// A server (or a CDN) that resets every upload must not be redialled as fast
+// as the client reconnects: each young connection that fails delays the next
+// (sing-box-lx SPEC 076 saw both cores of a router spin on this).
+func TestXHTTPResetStorm(t *testing.T) {
+	client, server := newTestPair(t, option.V2RayXHTTPOptions{Mode: modeStreamUp}, "h2", func(s *testServer) {
+		s.abortUploads = true
+	})
+	deadline := time.Now().Add(3 * time.Second)
+	var dials, refused int
+	for time.Now().Before(deadline) {
+		dials++
+		conn, err := client.DialContext(context.Background())
+		if err != nil {
+			refused++
+			continue
+		}
+		conn.Write([]byte("x"))
+		conn.Read(make([]byte, 1))
+		conn.Close()
+	}
+	t.Logf("%d dials in 3 s, %d refused during the backoff, %d connections to the server", dials, refused, server.connections())
+	require.LessOrEqual(t, server.connections(), 10)
+}
diff --git a/transport/v2rayxhttp/server_test.go b/transport/v2rayxhttp/server_test.go
index a635c4373..e4c4fd011 100644
--- a/transport/v2rayxhttp/server_test.go
+++ b/transport/v2rayxhttp/server_test.go
@@ -32,6 +32,7 @@ type testServer struct {
 	access   sync.Mutex
 	sessions map[string]*testSession
 	requests map[string]int
+	remotes  map[string]struct{}
 }
 
 type testSession struct {
@@ -85,6 +86,13 @@ func (s *testServer) count(kind string) {
 	s.access.Unlock()
 }
 
+// connections is the number of client connections requests came on.
+func (s *testServer) connections() int {
+	s.access.Lock()
+	defer s.access.Unlock()
+	return len(s.remotes)
+}
+
 func (s *testServer) requestCount(kind string) int {
 	s.access.Lock()
 	defer s.access.Unlock()
@@ -215,6 +223,12 @@ func (s *testServer) packetData(r *http.Request) ([]byte, error) {
 }
 
 func (s *testServer) serveHTTP(w http.ResponseWriter, r *http.Request) {
+	s.access.Lock()
+	if s.remotes == nil {
+		s.remotes = make(map[string]struct{})
+	}
+	s.remotes[r.RemoteAddr] = struct{}{}
+	s.access.Unlock()
 	if !strings.HasPrefix(r.URL.Path, s.config.normalizedPath()) {
 		s.count("not-found")
 		w.WriteHeader(http.StatusNotFound)
-- 
