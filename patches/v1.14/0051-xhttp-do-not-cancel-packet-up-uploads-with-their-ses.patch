From 1044b1063d9d7240859a15b8201241e7fb9f4199 Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Mon, 5 Oct 2026 12:48:02 +0300
Subject: [PATCH 51/88] xhttp: do not cancel packet-up uploads with their
 session

net/http hands an HTTP/1.1 connection back to its pool before it delivers a
response without a body; an upload cancelled in between closed that
connection under the next upload, which failed with "context canceled" (1 to
3 sessions in 4000 when sessions closed at once). As with Xray, uploads are not
cancelled; a timeout bounds one to a server that went silent.
---
 transport/v2rayxhttp/churn_test.go | 50 ++++++++++++++++++++++++++++++
 transport/v2rayxhttp/upload.go     | 13 +++++++-
 2 files changed, 62 insertions(+), 1 deletion(-)
 create mode 100644 transport/v2rayxhttp/churn_test.go

diff --git a/transport/v2rayxhttp/churn_test.go b/transport/v2rayxhttp/churn_test.go
new file mode 100644
index 000000000..e03062870
--- /dev/null
+++ b/transport/v2rayxhttp/churn_test.go
@@ -0,0 +1,50 @@
+package v2rayxhttp
+
+import (
+	"context"
+	"io"
+	"sync"
+	"sync/atomic"
+	"testing"
+
+	"github.com/sagernet/sing-box/option"
+
+	"github.com/stretchr/testify/require"
+)
+
+// Sessions opened and closed many at a time all work: on HTTP/1.1 a cancelled
+// upload request used to close the connection the next upload had taken.
+func TestXHTTPChurn(t *testing.T) {
+	for _, version := range []string{"h1", "h1-tls", "h2"} {
+		t.Run(version, func(t *testing.T) {
+			client, _ := newTestPair(t, option.V2RayXHTTPOptions{Mode: modePacketUp}, version, nil)
+			var failures atomic.Int32
+			var first sync.Once
+			var wg sync.WaitGroup
+			for worker := 0; worker < 20; worker++ {
+				wg.Add(1)
+				go func() {
+					defer wg.Done()
+					for i := 0; i < 200; i++ {
+						conn, err := client.DialContext(context.Background())
+						if err == nil {
+							_, err = conn.Write([]byte("0123456789abcdef"))
+						}
+						if err == nil {
+							_, err = io.ReadFull(conn, make([]byte, 16))
+						}
+						if conn != nil {
+							conn.Close()
+						}
+						if err != nil {
+							failures.Add(1)
+							first.Do(func() { t.Log("first failure: ", err) })
+						}
+					}
+				}()
+			}
+			wg.Wait()
+			require.Zero(t, failures.Load(), "sessions failed")
+		})
+	}
+}
diff --git a/transport/v2rayxhttp/upload.go b/transport/v2rayxhttp/upload.go
index 5584cd2b5..33f1a2420 100644
--- a/transport/v2rayxhttp/upload.go
+++ b/transport/v2rayxhttp/upload.go
@@ -16,6 +16,9 @@ import (
 // on a router a megabyte per uploading connection adds up.
 const maxUploadBacklog = 1024 * 1024
 
+// uploadTimeout bounds one packet-up upload request.
+const uploadTimeout = 60 * time.Second
+
 // uploader sends the writes of a packet-up session as numbered requests. Writes
 // are batched while a request is on its way, so that each request carries what
 // accumulated meanwhile, up to the request size drawn for the session.
@@ -181,7 +184,15 @@ func (u *uploader) post(client *poolClient, seq string, data []byte, wrote chan
 	var once sync.Once
 	written := func() { once.Do(func() { close(wrote) }) }
 	defer written()
-	ctx := context.WithValue(u.session.ctx, packetRequestKey{}, true)
+	// An upload is not cancelled with its session, as with Xray: net/http hands
+	// a connection back to its pool before it delivers a response without a
+	// body, and a request cancelled in between closes that connection under the
+	// next request, which then fails with "context canceled" (HTTP/1.1: 1 to 3
+	// uploads in 4000 when sessions closed at once). The timeout bounds an
+	// upload to a server that went silent.
+	ctx, cancel := context.WithTimeout(context.WithoutCancel(u.session.ctx), uploadTimeout)
+	defer cancel()
+	ctx = context.WithValue(ctx, packetRequestKey{}, true)
 	ctx = httptrace.WithClientTrace(ctx, &httptrace.ClientTrace{
 		WroteRequest: func(httptrace.WroteRequestInfo) { written() },
 	})
