Subject: [PATCH 52/88] xhttp: the transport in the option schema

---
 option/v2ray_transport.go    |  3 ++-
 option/v2ray_xhttp_schema.go | 12 ++++++++++++
 option/v2ray_xhttp_test.go   | 11 +++++++++++
 3 files changed, 25 insertions(+), 1 deletion(-)
 create mode 100644 option/v2ray_xhttp_schema.go

diff --git a/option/v2ray_transport.go b/option/v2ray_transport.go
index 8e8fdc8fd..9059c215c 100644
--- a/option/v2ray_transport.go
+++ b/option/v2ray_transport.go
@@ -12,7 +12,7 @@ import (
 )
 
 type _V2RayTransportOptions struct {
-	Type               string                  `json:"type" enum:"http,ws,quic,grpc,httpupgrade"`
+	Type               string                  `json:"type" enum:"http,ws,quic,grpc,httpupgrade,xhttp"`
 	HTTPOptions        V2RayHTTPOptions        `json:"-"`
 	WebsocketOptions   V2RayWebsocketOptions   `json:"-"`
 	QUICOptions        V2RayQUICOptions        `json:"-"`
@@ -83,6 +83,7 @@ func (o V2RayTransportOptions) DescribeSchema(builder schema.Builder) (*schema.N
 			{Value: C.V2RayTransportTypeQUIC, StructType: reflect.TypeFor[V2RayQUICOptions]()},
 			{Value: C.V2RayTransportTypeGRPC, StructType: reflect.TypeFor[V2RayGRPCOptions]()},
 			{Value: C.V2RayTransportTypeHTTPUpgrade, StructType: reflect.TypeFor[V2RayHTTPUpgradeOptions]()},
+			{Value: C.V2RayTransportTypeXHTTP, StructType: reflect.TypeFor[V2RayXHTTPOptions]()},
 		}, nil)
 	})
 }
diff --git a/option/v2ray_xhttp_schema.go b/option/v2ray_xhttp_schema.go
new file mode 100644
index 000000000..a5443e45f
--- /dev/null
+++ b/option/v2ray_xhttp_schema.go
@@ -0,0 +1,12 @@
+package option
+
+import "github.com/sagernet/sing-box/schema"
+
+func (r V2RayXHTTPRange) DescribeSchema(builder schema.Builder) (*schema.Node, error) {
+	return builder.Define("V2RayXHTTPRange", func() (*schema.Node, error) {
+		object := schema.StrictObject()
+		object.Properties.Put("from", schema.IntegerNode())
+		object.Properties.Put("to", schema.IntegerNode())
+		return schema.AnyOf(&schema.Node{Type: "string", Pattern: `^(-?[0-9]+(--?[0-9]+)?)?$`}, schema.IntegerNode(), object), nil
+	})
+}
diff --git a/option/v2ray_xhttp_test.go b/option/v2ray_xhttp_test.go
index c16014324..b17246da8 100644
--- a/option/v2ray_xhttp_test.go
+++ b/option/v2ray_xhttp_test.go
@@ -1,9 +1,12 @@
 package option
 
 import (
+	"context"
+	"reflect"
 	"testing"
 
 	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/schema"
 	"github.com/sagernet/sing/common/json"
 
 	"github.com/stretchr/testify/require"
@@ -123,3 +126,11 @@ func TestV2RayXHTTPUnknownFields(t *testing.T) {
 		require.Error(t, json.Unmarshal([]byte(input), &options), input)
 	}
 }
+
+func TestV2RayXHTTPSchema(t *testing.T) {
+	content, err := schema.Generate(context.Background(), reflect.TypeFor[V2RayTransportOptions]())
+	require.NoError(t, err)
+	for _, expected := range []string{`"xhttp"`, `"V2RayXHTTPRange"`, `"sc_max_each_post_bytes"`, `"session_id_table"`, `"download"`, `"h_keep_alive_period"`} {
+		require.Contains(t, string(content), expected)
+	}
+}
