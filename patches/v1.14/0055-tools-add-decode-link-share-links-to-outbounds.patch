@@ -0,0 +1,79 @@
+package main
+
+import (
+	"bufio"
+	"os"
+	"strings"
+
+	"github.com/sagernet/sing-box/common/sharelink"
+	"github.com/sagernet/sing-box/log"
+	E "github.com/sagernet/sing/common/exceptions"
+	F "github.com/sagernet/sing/common/format"
+	"github.com/sagernet/sing/common/json"
+
+	"github.com/spf13/cobra"
+)
+
+var commandDecodeLinkFlagCompact bool
+
+var commandDecodeLink = &cobra.Command{
+	Use:   "decode-link [link ...]",
+	Short: "Convert share links (vless://, trojan://) to outbounds",
+	Long: "Convert share links (vless://, trojan://) to outbounds.\n\n" +
+		"The links are the arguments or, with no arguments, the lines of the standard input.\n" +
+		"The output has one outbound for each link, in the same order; nothing is printed\n" +
+		"unless every link is read. What a link asks for and the outbound cannot do is\n" +
+		"reported to the standard error.",
+	Run: func(cmd *cobra.Command, args []string) {
+		err := decodeLinks(args)
+		if err != nil {
+			log.Fatal(err)
+		}
+	},
+}
+
+func init() {
+	commandDecodeLink.Flags().BoolVar(&commandDecodeLinkFlagCompact, "compact", false, "Print each outbound on one line")
+	commandTools.AddCommand(commandDecodeLink)
+}
+
+func decodeLinks(links []string) error {
+	if len(links) == 0 {
+		scanner := bufio.NewScanner(os.Stdin)
+		scanner.Buffer(make([]byte, 64*1024), 1024*1024)
+		for scanner.Scan() {
+			if line := strings.TrimSpace(scanner.Text()); line != "" {
+				links = append(links, line)
+			}
+		}
+		if err := scanner.Err(); err != nil {
+			return E.Cause(err, "read links")
+		}
+		if len(links) == 0 {
+			return E.New("no links")
+		}
+	}
+	outbounds := make([]*sharelink.Outbound, 0, len(links))
+	for i, link := range links {
+		// a link is a secret: it is named by its position only
+		outbound, warnings, err := sharelink.Decode(link)
+		if err != nil {
+			return E.Cause(err, "link ", i+1)
+		}
+		for _, warning := range warnings {
+			os.Stderr.WriteString(F.ToString("link ", i+1, ": ", warning, "\n"))
+		}
+		outbounds = append(outbounds, outbound)
+	}
+	encoder := json.NewEncoder(os.Stdout)
+	if !commandDecodeLinkFlagCompact {
+		encoder.SetIndent("", "  ")
+	}
+	for _, outbound := range outbounds {
+		err := encoder.Encode(outbound)
+		if err != nil {
+			return E.Cause(err, "encode outbound")
+		}
+	}
+	return nil
+}
diff --git a/common/sharelink/link.go b/common/sharelink/link.go
new file mode 100644
index 000000000..5d6c03bc1
--- /dev/null
+++ b/common/sharelink/link.go
@@ -0,0 +1,353 @@
+// Package sharelink turns share links of proxy servers ("vless://...") into
+// the options of sing-box outbounds.
+//
+// There is no single specification of these links. The VLESS and Trojan forms
+// follow the proposal the Xray project keeps (XTLS/Xray-core discussion #716)
+// and the links the common panels generate; where the generators disagree, the
+// behaviour of Xray-core decides.
+package sharelink
+
+import (
+	"net/url"
+	"strconv"
+	"strings"
+
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/option"
+	E "github.com/sagernet/sing/common/exceptions"
+	"github.com/sagernet/sing/common/json/badjson"
+	"github.com/sagernet/sing/common/json/badoption"
+)
+
+// Outbound is a decoded link: an outbound of the given type with its options,
+// tagged with the name the link carries.
+type Outbound struct {
+	Type    string
+	Tag     string
+	Options any
+}
+
+type outboundHeader struct {
+	Type string `json:"type"`
+	Tag  string `json:"tag,omitempty"`
+}
+
+func (o Outbound) MarshalJSON() ([]byte, error) {
+	return badjson.MarshallObjects(outboundHeader{o.Type, o.Tag}, o.Options)
+}
+
+// Decode reads one share link. The warnings name what the link asks for and
+// the outbound cannot do, where the connection is still expected to work.
+func Decode(link string) (*Outbound, []string, error) {
+	link = strings.TrimSpace(link)
+	scheme, rest, found := strings.Cut(link, "://")
+	if !found || scheme == "" {
+		return nil, nil, E.New("not a share link")
+	}
+	var tag string
+	if index := strings.IndexByte(rest, '#'); index >= 0 {
+		tag = rest[index+1:]
+		// a name is free text, often with a stray "%"
+		if decoded, err := url.PathUnescape(tag); err == nil {
+			tag = decoded
+		}
+		rest = rest[:index]
+	}
+	var rawQuery string
+	if index := strings.IndexByte(rest, '?'); index >= 0 {
+		rawQuery = rest[index+1:]
+		rest = rest[:index]
+	}
+	query, err := parseQuery(rawQuery)
+	if err != nil {
+		return nil, nil, err
+	}
+	d := &decoder{query: query}
+	var options any
+	scheme = strings.ToLower(scheme)
+	switch scheme {
+	case C.TypeVLESS:
+		options, err = d.vless(rest)
+	case C.TypeTrojan:
+		options, err = d.trojan(rest)
+	default:
+		return nil, nil, E.New("unsupported link type: ", scheme)
+	}
+	if err != nil {
+		return nil, nil, err
+	}
+	return &Outbound{Type: scheme, Tag: strings.TrimSpace(tag), Options: options}, d.warnings, nil
+}
+
+type decoder struct {
+	query    map[string]string
+	warnings []string
+}
+
+func (d *decoder) warn(message ...any) {
+	d.warnings = append(d.warnings, E.New(message...).Error())
+}
+
+// parseQuery splits the query of a link. "+" is a space: the generators that
+// use form encoding (3x-ui, Marzban) write spaces that way, and those that
+// follow the proposal escape a real "+". The first of repeated keys wins.
+func parseQuery(rawQuery string) (map[string]string, error) {
+	values := make(map[string]string)
+	for _, pair := range strings.Split(rawQuery, "&") {
+		if pair == "" {
+			continue
+		}
+		rawKey, rawValue, _ := strings.Cut(pair, "=")
+		key, err := url.QueryUnescape(rawKey)
+		if err != nil {
+			return nil, E.New("invalid escape in the name of a link parameter")
+		}
+		value, err := url.QueryUnescape(rawValue)
+		if err != nil {
+			return nil, E.New("invalid escape in link parameter ", key)
+		}
+		if _, exists := values[key]; !exists {
+			values[key] = value
+		}
+	}
+	return values, nil
+}
+
+// parseServer reads "userinfo@host:port", with anything after the port ignored.
+func parseServer(authority string) (string, option.ServerOptions, error) {
+	if index := strings.IndexByte(authority, '/'); index >= 0 {
+		authority = authority[:index]
+	}
+	index := strings.LastIndexByte(authority, '@')
+	if index < 0 {
+		return "", option.ServerOptions{}, E.New("missing user in the link")
+	}
+	userinfo, err := url.PathUnescape(authority[:index])
+	if err != nil {
+		return "", option.ServerOptions{}, E.New("invalid escape in the user of the link")
+	}
+	if userinfo == "" {
+		return "", option.ServerOptions{}, E.New("missing user in the link")
+	}
+	hostPort := authority[index+1:]
+	var host, port string
+	if strings.HasPrefix(hostPort, "[") {
+		end := strings.IndexByte(hostPort, ']')
+		if end < 0 {
+			return "", option.ServerOptions{}, E.New("invalid server address")
+		}
+		host = hostPort[1:end]
+		port = strings.TrimPrefix(hostPort[end+1:], ":")
+	} else {
+		host, port, _ = strings.Cut(hostPort, ":")
+	}
+	if host == "" || strings.ContainsAny(host, " \t@?#") {
+		return "", option.ServerOptions{}, E.New("invalid server address")
+	}
+	if port == "" {
+		return "", option.ServerOptions{}, E.New("missing server port")
+	}
+	portNumber, err := strconv.ParseUint(port, 10, 16)
+	if err != nil || portNumber == 0 {
+		return "", option.ServerOptions{}, E.New("invalid server port: ", port)
+	}
+	return userinfo, option.ServerOptions{Server: host, ServerPort: uint16(portNumber)}, nil
+}
+
+func (d *decoder) vless(authority string) (any, error) {
+	uuid, server, err := parseServer(authority)
+	if err != nil {
+		return nil, err
+	}
+	// VLESS Encryption (anything but "none") changes the protocol itself
+	if encryption := d.query["encryption"]; encryption != "" && encryption != "none" {
+		return nil, E.New("VLESS encryption is not supported")
+	}
+	options := option.VLESSOutboundOptions{
+		ServerOptions: server,
+		UUID:          uuid,
+		Flow:          d.query["flow"],
+	}
+	if packetEncoding, exists := d.query["packetEncoding"]; exists && packetEncoding != "" {
+		if packetEncoding == "none" {
+			packetEncoding = ""
+		}
+		options.PacketEncoding = &packetEncoding
+	}
+	options.TLS, err = d.security("none")
+	if err != nil {
+		return nil, err
+	}
+	options.Transport, err = d.transport()
+	if err != nil {
+		return nil, err
+	}
+	return options, nil
+}
+
+func (d *decoder) trojan(authority string) (any, error) {
+	password, server, err := parseServer(authority)
+	if err != nil {
+		return nil, err
+	}
+	options := option.TrojanOutboundOptions{
+		ServerOptions: server,
+		Password:      password,
+	}
+	options.TLS, err = d.security("tls")
+	if err != nil {
+		return nil, err
+	}
+	options.Transport, err = d.transport()
+	if err != nil {
+		return nil, err
+	}
+	return options, nil
+}
+
+func isTrue(value string) bool {
+	return value == "1" || strings.EqualFold(value, "true")
+}
+
+func splitList(value string) []string {
+	var list []string
+	for _, item := range strings.Split(value, ",") {
+		if item = strings.TrimSpace(item); item != "" {
+			list = append(list, item)
+		}
+	}
+	return list
+}
+
+func (d *decoder) security(defaultSecurity string) (*option.OutboundTLSOptions, error) {
+	security := d.query["security"]
+	if security == "" {
+		security = defaultSecurity
+	}
+	switch security {
+	case "none":
+		return nil, nil
+	case "tls", "reality":
+	default:
+		return nil, E.New("unsupported security: ", security)
+	}
+	tlsOptions := &option.OutboundTLSOptions{
+		Enabled:    true,
+		ServerName: d.query["sni"],
+		Insecure:   isTrue(d.query["allowInsecure"]) || isTrue(d.query["insecure"]),
+		ALPN:       splitList(d.query["alpn"]),
+	}
+	fingerprint := d.query["fp"]
+	if security == "reality" {
+		if d.query["pbk"] == "" {
+			return nil, E.New("missing REALITY public key (pbk)")
+		}
+		tlsOptions.Reality = &option.OutboundRealityOptions{
+			Enabled:   true,
+			PublicKey: d.query["pbk"],
+			ShortID:   d.query["sid"],
+		}
+		// REALITY needs uTLS; Xray's default fingerprint is Chrome's
+		if fingerprint == "" {
+			fingerprint = "chrome"
+		}
+		if d.query["pqv"] != "" {
+			d.warn("pqv (the ML-DSA-65 check of the REALITY server) is not supported, the server is not verified with it")
+		}
+	}
+	if fingerprint != "" {
+		tlsOptions.UTLS = &option.OutboundUTLSOptions{Enabled: true, Fingerprint: fingerprint}
+	}
+	for _, key := range []string{"ech", "pcs", "vcn", "cs"} {
+		if d.query[key] != "" {
+			d.warn(key, " is not supported and is ignored")
+		}
+	}
+	return tlsOptions, nil
+}
+
+func (d *decoder) transport() (*option.V2RayTransportOptions, error) {
+	if d.query["fm"] != "" {
+		d.warn("fm (finalmask) is not supported, the connection may not work")
+	}
+	network := d.query["type"]
+	switch network {
+	case "", "tcp", "raw":
+		if headerType := d.query["headerType"]; headerType != "" && headerType != "none" {
+			return nil, E.New("unsupported header type of the TCP transport: ", headerType)
+		}
+		return nil, nil
+	case "ws":
+		path, earlyData, err := splitEarlyData(d.query["path"], d.query["ed"])
+		if err != nil {
+			return nil, err
+		}
+		options := option.V2RayWebsocketOptions{Path: path, MaxEarlyData: earlyData}
+		if earlyData > 0 {
+			// the only form Xray speaks
+			options.EarlyDataHeaderName = "Sec-WebSocket-Protocol"
+		}
+		if host := d.query["host"]; host != "" {
+			options.Headers = badoption.HTTPHeader{"Host": {host}}
+		}
+		return &option.V2RayTransportOptions{Type: C.V2RayTransportTypeWebsocket, WebsocketOptions: options}, nil
+	case "grpc":
+		if mode := d.query["mode"]; mode != "" && mode != "gun" {
+			return nil, E.New("unsupported gRPC mode: ", mode)
+		}
+		if d.query["authority"] != "" {
+			d.warn("the gRPC authority is not supported and is ignored")
+		}
+		return &option.V2RayTransportOptions{
+			Type:        C.V2RayTransportTypeGRPC,
+			GRPCOptions: option.V2RayGRPCOptions{ServiceName: d.query["serviceName"]},
+		}, nil
+	case "http", "h2":
+		return &option.V2RayTransportOptions{
+			Type:        C.V2RayTransportTypeHTTP,
+			HTTPOptions: option.V2RayHTTPOptions{Host: splitList(d.query["host"]), Path: d.query["path"]},
+		}, nil
+	case "httpupgrade":
+		return &option.V2RayTransportOptions{
+			Type:               C.V2RayTransportTypeHTTPUpgrade,
+			HTTPUpgradeOptions: option.V2RayHTTPUpgradeOptions{Host: d.query["host"], Path: d.query["path"]},
+		}, nil
+	case "xhttp", "splithttp":
+		options, err := d.xhttp()
+		if err != nil {
+			return nil, err
+		}
+		return &option.V2RayTransportOptions{Type: C.V2RayTransportTypeXHTTP, XHTTPOptions: *options}, nil
+	default:
+		return nil, E.New("unsupported transport: ", network)
+	}
+}
+
+// splitEarlyData takes the size of WebSocket early data from the "ed"
+// parameter of the link or, the usual place, from "?ed=" in the path, which
+// is not a part of the path the server sees.
+func splitEarlyData(path string, linkValue string) (string, uint32, error) {
+	value := linkValue
+	if base, pathQuery, found := strings.Cut(path, "?"); found {
+		var kept []string
+		for _, pair := range strings.Split(pathQuery, "&") {
+			if strings.HasPrefix(pair, "ed=") {
+				value = pair[len("ed="):]
+			} else if pair != "" {
+				kept = append(kept, pair)
+			}
+		}
+		path = base
+		if len(kept) > 0 {
+			path += "?" + strings.Join(kept, "&")
+		}
+	}
+	if value == "" {
+		return path, 0, nil
+	}
+	earlyData, err := strconv.ParseUint(value, 10, 32)
+	if err != nil {
+		return "", 0, E.New("invalid size of WebSocket early data: ", value)
+	}
+	return path, uint32(earlyData), nil
+}
diff --git a/common/sharelink/link_test.go b/common/sharelink/link_test.go
new file mode 100644
index 000000000..4ccf8a926
--- /dev/null
+++ b/common/sharelink/link_test.go
@@ -0,0 +1,289 @@
+package sharelink
+
+import (
+	"net/url"
+	"strings"
+	"testing"
+
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common/json"
+
+	"github.com/stretchr/testify/require"
+)
+
+const testUUID = "6f1c9a0e-3b52-4c1e-9a55-2d4a1b0f7c11"
+
+func decodeJSON(t *testing.T, link string) (string, []string) {
+	t.Helper()
+	outbound, warnings, err := Decode(link)
+	require.NoError(t, err)
+	content, err := json.Marshal(outbound)
+	require.NoError(t, err)
+	return string(content), warnings
+}
+
+// uriComponent encodes as JavaScript's encodeURIComponent does: no "+".
+func uriComponent(value string) string {
+	return strings.ReplaceAll(url.QueryEscape(value), "+", "%20")
+}
+
+func xhttpLink(extra string, encode func(string) string, more string) string {
+	return "vless://" + testUUID + "@example.org:443?type=xhttp&security=tls&sni=example.org&fp=chrome&alpn=h2%2Chttp%2F1.1" +
+		"&path=%2Fapi%2F&host=cdn.example.org&mode=auto" + more + "&extra=" + encode(extra) + "#name"
+}
+
+func TestVLESSXHTTP(t *testing.T) {
+	t.Parallel()
+	extra := `{"xPaddingBytes":"100-1000","scMaxEachPostBytes":1000000,"scMinPostsIntervalMs":"30","noGRPCHeader":true,` +
+		`"headers":{"X-Test":"a b"},"xmux":{"maxConcurrency":"16-32","hMaxRequestTimes":"600-900","hMaxReusableSecs":"1800-3000","hKeepAlivePeriod":0},` +
+		`"scMaxBufferedPosts":30,"noSSEHeader":false,"mode":"packet-up","host":"other","path":"/other"}`
+	content, warnings := decodeJSON(t, xhttpLink(extra, url.QueryEscape, ""))
+	require.Empty(t, warnings)
+	require.JSONEq(t, `{
+		"type": "vless", "tag": "name", "server": "example.org", "server_port": 443, "uuid": "`+testUUID+`",
+		"tls": {"enabled": true, "server_name": "example.org", "alpn": ["h2", "http/1.1"], "utls": {"enabled": true, "fingerprint": "chrome"}},
+		"transport": {
+			"type": "xhttp", "mode": "auto", "host": "cdn.example.org", "path": "/api/",
+			"headers": {"X-Test": "a b"},
+			"x_padding_bytes": "100-1000", "sc_max_each_post_bytes": "1000000", "sc_min_posts_interval_ms": "30",
+			"no_grpc_header": true, "sc_max_buffered_posts": 30,
+			"xmux": {"max_concurrency": "16-32", "h_max_request_times": "600-900", "h_max_reusable_secs": "1800-3000"}
+		}
+	}`, content)
+}
+
+// Every way the generators encode "extra" gives the same outbound.
+func TestExtraEncodings(t *testing.T) {
+	t.Parallel()
+	compact := `{"xPaddingBytes":"100-1000","headers":{"User-Agent":"Mozilla/5.0 (X11; Linux) a+b"}}`
+	spaced := `{"xPaddingBytes": "100-1000", "headers": {"User-Agent": "Mozilla/5.0 (X11; Linux) a+b"}}`
+	want, _ := decodeJSON(t, xhttpLink(compact, url.QueryEscape, ""))
+	require.Contains(t, want, `Mozilla/5.0 (X11; Linux) a+b`)
+	for name, link := range map[string]string{
+		"encodeURIComponent": xhttpLink(compact, uriComponent, ""),
+		// Marzban: json.dumps with spaces, form encoding
+		"spaces as plus":  xhttpLink(spaced, url.QueryEscape, ""),
+		"spaces as %20":   xhttpLink(spaced, uriComponent, ""),
+		"slash unescaped": xhttpLink(compact, func(s string) string { return strings.ReplaceAll(uriComponent(s), "%2F", "/") }, ""),
+	} {
+		content, warnings := decodeJSON(t, link)
+		require.Empty(t, warnings, name)
+		require.JSONEq(t, want, content, name)
+	}
+}
+
+func transportOf(t *testing.T, link string) (option.V2RayXHTTPOptions, []string) {
+	t.Helper()
+	outbound, warnings, err := Decode(link)
+	require.NoError(t, err)
+	transport := outbound.Options.(option.VLESSOutboundOptions).Transport
+	require.NotNil(t, transport)
+	require.Equal(t, "xhttp", transport.Type)
+	return transport.XHTTPOptions, warnings
+}
+
+func TestXHTTPDetails(t *testing.T) {
+	t.Parallel()
+	t.Run("legacy session names", func(t *testing.T) {
+		options, warnings := transportOf(t, xhttpLink(`{"sessionPlacement":"header","sessionKey":"X-S"}`, url.QueryEscape, ""))
+		require.Empty(t, warnings)
+		require.Equal(t, "header", options.SessionPlacement)
+		require.Equal(t, "X-S", options.SessionKey)
+	})
+	t.Run("new session names win", func(t *testing.T) {
+		options, _ := transportOf(t, xhttpLink(`{"sessionPlacement":"header","sessionIDPlacement":"query","sessionIDKey":"s","sessionKey":"X-S"}`, url.QueryEscape, ""))
+		require.Equal(t, "query", options.SessionPlacement)
+		require.Equal(t, "s", options.SessionKey)
+	})
+	t.Run("flat padding of 3x-ui", func(t *testing.T) {
+		options, _ := transportOf(t, xhttpLink(`{}`, url.QueryEscape, "&x_padding_bytes=200-300"))
+		require.Equal(t, &option.V2RayXHTTPRange{From: 200, To: 300}, options.XPaddingBytes)
+		options, _ = transportOf(t, xhttpLink(`{"xPaddingBytes":"5-6"}`, url.QueryEscape, "&x_padding_bytes=200-300"))
+		require.Equal(t, &option.V2RayXHTTPRange{From: 5, To: 6}, options.XPaddingBytes)
+	})
+	t.Run("zero is the default", func(t *testing.T) {
+		options, _ := transportOf(t, xhttpLink(`{"xPaddingBytes":0,"scMaxEachPostBytes":"","xmux":{"maxConcurrency":0},"uplinkChunkSize":null}`, url.QueryEscape, ""))
+		require.Nil(t, options.XPaddingBytes)
+		require.Nil(t, options.ScMaxEachPostBytes)
+		require.Nil(t, options.UplinkChunkSize)
+		require.Nil(t, options.Xmux)
+	})
+	t.Run("unknown and obsolete keys", func(t *testing.T) {
+		options, warnings := transportOf(t, xhttpLink(`{"scMaxConcurrentPosts":100,"keepAlivePeriod":30,"future":1,"another":{}}`, url.QueryEscape, ""))
+		require.Equal(t, []string{"extra: another is not supported and is ignored", "extra: future is not supported and is ignored"}, warnings)
+		require.Equal(t, "/api/", options.Path)
+	})
+	t.Run("host among the headers", func(t *testing.T) {
+		link := "vless://" + testUUID + "@example.org:443?type=xhttp&extra=" + url.QueryEscape(`{"headers":{"host":"h.example.org","A":"b"}}`)
+		options, warnings := transportOf(t, link)
+		require.Empty(t, warnings)
+		require.Equal(t, "h.example.org", options.Host)
+		require.Len(t, options.Headers, 1)
+	})
+	t.Run("no extra, splithttp", func(t *testing.T) {
+		options, warnings := transportOf(t, "vless://"+testUUID+"@[2001:db8::1]:8443?type=splithttp&path=%2Fp&mode=packet-up")
+		require.Empty(t, warnings)
+		require.Equal(t, option.V2RayXHTTPOptions{Mode: "packet-up", V2RayXHTTPBaseOptions: option.V2RayXHTTPBaseOptions{Path: "/p"}}, options)
+	})
+}
+
+func TestXHTTPDownload(t *testing.T) {
