+		`"xhttpSettings":{"path":"/d","xPaddingBytes":"1-2","extra":{"xPaddingBytes":"7-8","path":"/ignored","xmux":{"maxConnections":2}}}}}`
+	options, warnings = transportOf(t, xhttpLink(extra, url.QueryEscape, ""))
