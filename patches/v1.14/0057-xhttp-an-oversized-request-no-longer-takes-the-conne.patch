From 177ca4f1841bd8010cb549432705c6d3895b8365 Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Mon, 5 Oct 2026 20:28:39 +0300
Subject: [PATCH 57/88] xhttp: an oversized request no longer takes the
 connection down

With upload data in headers or cookies a request can exceed the header limit
of the server (8 KiB with Xray's defaults). The HTTP/2 client then refuses to
send it, and the pool took that for a failed connection: two such uploads put
the outbound into backoff, and for its duration every other session failed
(lab: 0 of 50 small requests beside one 200 KB upload, 50 of 50 with the Xray
client). The connection now stays in service.

The error, and that of a 431 or 413 answer, names the setting to lower.
---
 transport/v2rayxhttp/pool.go        | 18 +++++++++---
 transport/v2rayxhttp/review_test.go | 43 +++++++++++++++++++++++++++++
 transport/v2rayxhttp/server_test.go | 12 ++++++++
 transport/v2rayxhttp/upload.go      | 15 +++++++++-
 4 files changed, 83 insertions(+), 5 deletions(-)

diff --git a/transport/v2rayxhttp/pool.go b/transport/v2rayxhttp/pool.go
index 02a0933af..dde32abbe 100644
--- a/transport/v2rayxhttp/pool.go
+++ b/transport/v2rayxhttp/pool.go
@@ -7,6 +7,7 @@ import (
 	"math/rand/v2"
 	"net"
 	"net/http"
+	"strings"
 	"sync"
 	"sync/atomic"
 	"time"
@@ -232,11 +233,20 @@ func (c *poolClient) roundTrip(request *http.Request) (*http.Response, error) {
 	return response, err
 }
 
-// fail takes the client out of service after a failed request, as Xray does.
-// A request we cancelled ourselves (a session closed, a dial given up) says
-// nothing about the server.
+// headersTooLarge tells the error of a request the HTTP/2 client did not send:
+// its headers are larger than the server said it takes. (The error value is
+// not exported by golang.org/x/net/http2.)
+func headersTooLarge(err error) bool {
+	return err != nil && strings.Contains(err.Error(), "request header list larger than peer's advertised limit")
+}
+
+// fail takes the client out of service after a failed request, as Xray does
+// after a failed download or packet. A request we cancelled ourselves (a
+// session closed, a dial given up) says nothing about the server, and neither
+// does one that was never sent for the size of its headers: the connection is
+// as good as it was, and other sessions go on using it.
 func (c *poolClient) fail(ctx context.Context, err error) {
-	if errors.Is(ctx.Err(), context.Canceled) || errors.Is(err, context.Canceled) || errors.Is(err, net.ErrClosed) {
+	if errors.Is(ctx.Err(), context.Canceled) || errors.Is(err, context.Canceled) || errors.Is(err, net.ErrClosed) || headersTooLarge(err) {
 		return
 	}
 	if c.broken.Swap(true) {
diff --git a/transport/v2rayxhttp/review_test.go b/transport/v2rayxhttp/review_test.go
index e3db4c2d2..b84b7669a 100644
--- a/transport/v2rayxhttp/review_test.go
+++ b/transport/v2rayxhttp/review_test.go
@@ -143,3 +143,46 @@ func TestXHTTPCloseReachesRetiredClients(t *testing.T) {
 	second.Close()
 	first.Close()
 }
+
+// An upload whose headers are larger than the server takes fails its own
+// session, with the setting named, and nothing else: the connection stays in
+// service and other sessions of the outbound are not made to wait.
+func TestXHTTPHeadersTooLarge(t *testing.T) {
+	size := option.V2RayXHTTPRange{From: 16384, To: 16384}
+	options := option.V2RayXHTTPOptions{Mode: modePacketUp, V2RayXHTTPBaseOptions: option.V2RayXHTTPBaseOptions{
+		UplinkDataPlacement: placementHeader,
+		ScMaxEachPostBytes:  &size,
+	}}
+	for name, test := range map[string]struct {
+		version   string
+		configure func(*testServer)
+	}{
+		// the HTTP/2 client refuses to send the request
+		"advertised limit": {"h2-8k", nil},
+		// a proxy that does not announce its limit answers
+		"status 431": {"h2", func(s *testServer) { s.maxPacket = 6000 }},
+	} {
+		t.Run(name, func(t *testing.T) {
+			client, server := newTestPair(t, options, test.version, test.configure)
+			for round := 0; round < 3; round++ {
+				conn, err := client.DialContext(context.Background())
+				require.NoError(t, err, "round %d", round)
+				_, err = conn.Write(randomBytes(16384))
+				if err == nil {
+					_, err = conn.Read(make([]byte, 1))
+				}
+				require.ErrorContains(t, err, "sc_max_each_post_bytes")
+				conn.Close()
+			}
+			// small uploads of other sessions pass at once, through the same connection
+			connections := server.connections()
+			for i := 0; i < 5; i++ {
+				conn, err := client.DialContext(context.Background())
+				require.NoError(t, err)
+				echo(t, conn, 1000)
+				conn.Close()
+			}
+			require.Equal(t, connections, server.connections())
+		})
+	}
+}
diff --git a/transport/v2rayxhttp/server_test.go b/transport/v2rayxhttp/server_test.go
index 21a76db15..d4be858fd 100644
--- a/transport/v2rayxhttp/server_test.go
+++ b/transport/v2rayxhttp/server_test.go
@@ -29,6 +29,9 @@ type testServer struct {
 	// endlessErrorBody makes the body of an error answer never end.
 	endlessErrorBody bool
 	uploadStatus     int
+	// maxPacket makes the server refuse larger packets as a proxy with a
+	// limit on request headers does, with status 431.
+	maxPacket int
 	// abortUploads resets every upload request (RST_STREAM on HTTP/2).
 	abortUploads bool
 
@@ -59,6 +62,11 @@ func newTestServer(t *testing.T, config *requestConfig, mode string) *testServer
 	case "h2":
 		s.server.EnableHTTP2 = true
 		s.server.StartTLS()
+	case "h2-8k":
+		// the header limit of an Xray server with its defaults
+		s.server.Config.MaxHeaderBytes = 8192
+		s.server.EnableHTTP2 = true
+		s.server.StartTLS()
 	case "h1-tls":
 		s.server.StartTLS()
 	default:
@@ -270,6 +278,10 @@ func (s *testServer) serveHTTP(w http.ResponseWriter, r *http.Request) {
 			w.WriteHeader(http.StatusBadRequest)
 			return
 		}
+		if s.maxPacket > 0 && len(data) > s.maxPacket {
+			w.WriteHeader(http.StatusRequestHeaderFieldsTooLarge)
+			return
+		}
 		s.session(sessionID).pushPacket(number, data)
 		w.WriteHeader(http.StatusOK)
 	default:
diff --git a/transport/v2rayxhttp/upload.go b/transport/v2rayxhttp/upload.go
index e65a540d1..e0495ec61 100644
--- a/transport/v2rayxhttp/upload.go
+++ b/transport/v2rayxhttp/upload.go
@@ -207,11 +207,24 @@ func (u *uploader) post(client *poolClient, seq string, data []byte, wrote chan
 	request := u.client.up.newPacketRequest(ctx, u.client.upScheme, u.sessionID, seq, data)
 	response, err := client.roundTrip(request)
 	if err != nil {
+		if headersTooLarge(err) {
+			err = E.Cause(err, tooLargeHint)
+		}
 		u.session.fail(E.Cause(err, "xhttp: upload"))
 		return
 	}
 	discardBody(response.Body)
-	if response.StatusCode != http.StatusOK {
+	switch response.StatusCode {
+	case http.StatusOK:
+	case http.StatusRequestHeaderFieldsTooLarge, http.StatusRequestEntityTooLarge:
+		u.session.fail(E.New("xhttp: upload: ", tooLargeHint, ": unexpected status ", response.Status))
+	default:
 		u.session.fail(E.New("xhttp: upload: unexpected status ", response.Status))
 	}
 }
+
+// tooLargeHint names the setting behind a request the server (or a proxy in
+// front of it) refused for its size. With the data in headers or cookies the
+// limit is that of the request headers: 8 KiB with Xray's defaults, which
+// about 4 KiB of data fit in.
+const tooLargeHint = "the request is larger than the server takes, lower sc_max_each_post_bytes"
-- 
