+					client, server := newTestPair(t, option.V2RayXHTTPOptions{Mode: mode}, version, nil)
+					baseline := settledGoroutines()
+					const sessions = 10
+					for i := 0; i < sessions; i++ {
+						conn, err := client.DialContext(context.Background())
+						require.NoError(t, err)
