From 69ba59582e47142093a7c1e2c107c2bcc6be3d02 Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Mon, 5 Oct 2026 22:36:13 +0300
Subject: [PATCH 59/88] xhttp: the backoff holds back connections, not sessions

During the backoff after failed connections a dial was refused whenever the
pool wanted one more connection, also when it had a working one. A request
that makes a proxy drop the connection (nginx answers headers larger than its
buffers with GOAWAY) so cut the outbound off for every other session, for as
long as the request was retried: 0 of 50 small requests beside such an upload,
44 of 50 with the Xray client. A working connection now goes on taking
sessions; only without one is the dial refused.
---
 transport/v2rayxhttp/pool.go        | 34 +++++++++++++++++++----------
 transport/v2rayxhttp/review_test.go | 31 ++++++++++++++++++++++++++
 2 files changed, 54 insertions(+), 11 deletions(-)

diff --git a/transport/v2rayxhttp/pool.go b/transport/v2rayxhttp/pool.go
index dde32abbe..550b54a54 100644
--- a/transport/v2rayxhttp/pool.go
+++ b/transport/v2rayxhttp/pool.go
@@ -136,10 +136,8 @@ func (p *pool) take(session bool) (*poolClient, []*poolClient, error) {
 			i++
 		}
 	}
-	var client *poolClient
-	switch {
-	case len(p.clients) == 0, p.connections > 0 && len(p.clients) < int(p.connections):
-	default:
+	// pick takes one of the pooled clients that has room for a session.
+	pick := func() *poolClient {
 		candidates := p.clients
 		if p.concurrency > 0 {
 			candidates = make([]*poolClient, 0, len(p.clients))
@@ -149,18 +147,32 @@ func (p *pool) take(session bool) (*poolClient, []*poolClient, error) {
 				}
 			}
 		}
-		if len(candidates) > 0 {
-			client = candidates[rand.IntN(len(candidates))]
-			if client.leftUsage > 0 {
-				client.leftUsage--
-			}
+		if len(candidates) == 0 {
+			return nil
 		}
+		picked := candidates[rand.IntN(len(candidates))]
+		if picked.leftUsage > 0 {
+			picked.leftUsage--
+		}
+		return picked
+	}
+	var client *poolClient
+	wantMore := len(p.clients) == 0 || (p.connections > 0 && len(p.clients) < int(p.connections))
+	if !wantMore {
+		client = pick()
 	}
 	if client == nil {
 		if now.Before(p.retryAt) {
-			return nil, removed, E.Cause(p.lastErr, "xhttp: server failed ", p.failures, " connections in a row, next try in ", p.retryAt.Sub(now).Round(time.Millisecond))
+			// No new connection for now. The backoff is about connecting: a
+			// connection that works goes on serving, also when the pool would
+			// rather have opened one more.
+			client = pick()
+			if client == nil {
+				return nil, removed, E.Cause(p.lastErr, "xhttp: server failed ", p.failures, " connections in a row, next try in ", p.retryAt.Sub(now).Round(time.Millisecond))
+			}
+		} else {
+			client = p.newClient(now)
 		}
-		client = p.newClient(now)
 	}
 	client.acquire()
 	if session {
diff --git a/transport/v2rayxhttp/review_test.go b/transport/v2rayxhttp/review_test.go
index 8aba1fff5..40b1dcc1b 100644
--- a/transport/v2rayxhttp/review_test.go
+++ b/transport/v2rayxhttp/review_test.go
@@ -9,6 +9,7 @@ import (
 	"time"
 
 	"github.com/sagernet/sing-box/option"
+	E "github.com/sagernet/sing/common/exceptions"
 	F "github.com/sagernet/sing/common/format"
 	M "github.com/sagernet/sing/common/metadata"
 	N "github.com/sagernet/sing/common/network"
@@ -241,3 +242,33 @@ func TestXHTTPCloseDoesNotWaitForAFailedSession(t *testing.T) {
 	client.Close()
 	waitGoroutines(t, baseline)
 }
+
+// The backoff holds back new connections, not the sessions a working
+// connection can take: one user's request that makes a proxy drop connections
+// must not cut the outbound off for everyone.
+func TestXHTTPBackoffKeepsWorkingConnections(t *testing.T) {
+	client, _ := newTestPair(t, option.V2RayXHTTPOptions{Mode: modePacketUp}, "h2", nil)
+	// a working connection, held by an open session
+	held, err := client.DialContext(context.Background())
+	require.NoError(t, err)
+	defer held.Close()
+	echo(t, held, 100)
+	// the pool in backoff, as after two young connections failed
+	client.upPool.access.Lock()
+	client.upPool.failures = 2
+	client.upPool.lastErr = E.New("test")
+	client.upPool.retryAt = time.Now().Add(time.Minute)
+	clients := len(client.upPool.clients)
+	client.upPool.access.Unlock()
+	require.Equal(t, 1, clients)
+	for i := 0; i < 5; i++ {
+		conn, err := client.DialContext(context.Background())
+		require.NoError(t, err)
+		echo(t, conn, 100)
+		conn.Close()
+	}
+	client.upPool.access.Lock()
+	clients = len(client.upPool.clients)
+	client.upPool.access.Unlock()
+	require.Equal(t, 1, clients, "no new connection during the backoff")
+}
