From 2b15d8377cd117e0466ceda3e1a5fb49e6cd9845 Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Tue, 6 Oct 2026 02:09:09 +0300
Subject: [PATCH 63/88] xhttp: no time limit on an upload a watched connection
 carries

The server answers a packet-up request once it has queued the data, and with
its queue full that is once the destination has read some. The 60 s limit on
the answer so cut off an upload to a destination that stayed busy: one that
read nothing for four minutes got 4 of 60 MB (with the Xray client, all 60).

The limit is gone where the connection notices a silent server by itself:
HTTP/2 with its pings, HTTP/3. It stays on HTTP/1.1 and on HTTP/2 with the
pings turned off, where nothing else would end a request to a dead server.
---
 transport/v2rayxhttp/client.go |  8 ++++++--
 transport/v2rayxhttp/pool.go   | 12 ++++++++----
 transport/v2rayxhttp/upload.go | 25 ++++++++++++++++++-------
 3 files changed, 32 insertions(+), 13 deletions(-)

diff --git a/transport/v2rayxhttp/client.go b/transport/v2rayxhttp/client.go
index dc23fd30b..4261ae114 100644
--- a/transport/v2rayxhttp/client.go
+++ b/transport/v2rayxhttp/client.go
@@ -162,7 +162,9 @@ func newLeg(legDialer N.Dialer, serverAddr M.Socksaddr, config *requestConfig, t
 		if err != nil {
 			return "", nil, err
 		}
-		return "https", newPool(config.xmux, newConnection), nil
+		pool := newPool(config.xmux, newConnection)
+		pool.watched = true
+		return "https", pool, nil
 	case "1.1":
 		scheme := "http"
 		var tlsDialer tls.Dialer
@@ -192,7 +194,9 @@ func newLeg(legDialer N.Dialer, serverAddr M.Socksaddr, config *requestConfig, t
 		newConnection = func() pooledConnection {
 			return newHTTP2Connection(tlsDialer, serverAddr, keepAlivePeriod)
 		}
-		return "https", newPool(config.xmux, newConnection), nil
+		pool := newPool(config.xmux, newConnection)
+		pool.watched = keepAlivePeriod > 0
+		return "https", pool, nil
 	}
 }
 
diff --git a/transport/v2rayxhttp/pool.go b/transport/v2rayxhttp/pool.go
index 761abf0db..cbf9ef134 100644
--- a/transport/v2rayxhttp/pool.go
+++ b/transport/v2rayxhttp/pool.go
@@ -49,10 +49,14 @@ type pooledConnection interface {
 
 type pool struct {
 	newConnection func() pooledConnection
-	config        xmuxConfig
-	idleTimeout   time.Duration
-	concurrency   int32
-	connections   int32
+	// watched: the connections notice a server that went silent by themselves
+	// (HTTP/2 pings, the idle timeout and keep-alive of QUIC) and fail the
+	// requests on them.
+	watched     bool
+	config      xmuxConfig
+	idleTimeout time.Duration
+	concurrency int32
+	connections int32
 
 	access  sync.Mutex
 	clients []*poolClient
diff --git a/transport/v2rayxhttp/upload.go b/transport/v2rayxhttp/upload.go
index 051f3c42e..c2478a405 100644
--- a/transport/v2rayxhttp/upload.go
+++ b/transport/v2rayxhttp/upload.go
@@ -18,7 +18,8 @@ import (
 // on a router a megabyte per uploading connection adds up.
 const maxUploadBacklog = 1024 * 1024
 
-// uploadTimeout bounds one packet-up upload request.
+// uploadTimeout bounds one packet-up upload request on a connection that
+// does not check on its server by itself.
 const uploadTimeout = 60 * time.Second
 
 // uploader sends the writes of a packet-up session as numbered requests. Writes
@@ -249,12 +250,22 @@ func (u *uploader) post(client *poolClient, seq string, data []byte, wrote chan
 	// a connection back to its pool before it delivers a response without a
 	// body, and a request cancelled in between closes that connection under the
 	// next request, which then fails with "context canceled" (HTTP/1.1: 1 to 3
-	// uploads in 4000 when sessions closed at once). The timeout bounds an
-	// upload to a server that went silent.
-	// It allows for writing the data at 64 kbit/s on top of the wait.
-	timeout := uploadTimeout + time.Duration(len(data))*time.Second/(8*1024)
-	ctx, cancel := context.WithTimeout(context.WithoutCancel(u.session.ctx), timeout)
-	defer cancel()
+	// uploads in 4000 when sessions closed at once).
+	//
+	// The server answers an upload once it has queued the data, and with its
+	// queue full that is once the destination has read some: an answer may
+	// take as long as the destination stays busy, and a time limit on it cut
+	// off a slow upload that a TCP connection, and Xray, carry through (lab:
+	// a destination idle for four minutes got 4 of 60 MB). So there is none
+	// where the connection itself notices a server that went silent. Where
+	// nothing does (HTTP/1.1, HTTP/2 with its pings turned off) the limit
+	// stays: the wait, and the data written at 64 kbit/s.
+	ctx := context.WithoutCancel(u.session.ctx)
+	if !u.client.upPool.watched {
+		var cancel context.CancelFunc
+		ctx, cancel = context.WithTimeout(ctx, uploadTimeout+time.Duration(len(data))*time.Second/(8*1024))
+		defer cancel()
+	}
 	ctx = context.WithValue(ctx, packetRequestKey{}, true)
 	ctx = httptrace.WithClientTrace(ctx, &httptrace.ClientTrace{
 		WroteRequest: func(httptrace.WroteRequestInfo) { written() },
-- 
