From aa73b3b518fbe0dc39983ccda44bfde04ab848a2 Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Tue, 6 Oct 2026 23:55:40 +0300
Subject: [PATCH 72/88] xhttp: refuse an uplink_http_method that is not a token

The method was only put in upper case. A value with a space or another byte a method
cannot have passed "sing-box check" and the decoder of share links, and failed at the
first dial instead: the HTTP/1.1 and HTTP/3 clients refuse such a request, the HTTP/2
client sends it and the server answers with an error. It is checked with the other
options now, for the upload and the download leg.
---
 transport/v2rayxhttp/config.go      | 6 ++++++
 transport/v2rayxhttp/config_test.go | 8 ++++++++
 2 files changed, 14 insertions(+)

diff --git a/transport/v2rayxhttp/config.go b/transport/v2rayxhttp/config.go
index 994fa9c25..43253a9d3 100644
--- a/transport/v2rayxhttp/config.go
+++ b/transport/v2rayxhttp/config.go
@@ -227,6 +227,12 @@ func newRequestConfig(options option.V2RayXHTTPBaseOptions, mode string) (*reque
 	if c.uplinkHTTPMethod == "" {
 		c.uplinkHTTPMethod = http.MethodPost
 	}
+	// A method is a token, as a header name is. One that is not is refused by
+	// the HTTP/1.1 and HTTP/3 clients at the first request and sent as it is
+	// by the HTTP/2 client.
+	if !httpguts.ValidHeaderFieldName(c.uplinkHTTPMethod) {
+		return nil, E.New("invalid uplink_http_method: ", options.UplinkHTTPMethod)
+	}
 	if c.uplinkHTTPMethod == http.MethodGet && mode != modePacketUp {
 		return nil, E.New("uplink_http_method can be GET only in packet-up mode")
 	}
diff --git a/transport/v2rayxhttp/config_test.go b/transport/v2rayxhttp/config_test.go
index ba1b6b0e0..6e654ea22 100644
--- a/transport/v2rayxhttp/config_test.go
+++ b/transport/v2rayxhttp/config_test.go
@@ -61,6 +61,13 @@ func TestXHTTPConfigErrors(t *testing.T) {
 			o.Download = &option.V2RayXHTTPDownloadOptions{ServerOptions: option.ServerOptions{Server: "127.0.0.1", ServerPort: 1}}
 			o.Download.XPaddingBytes = xrange(0, 10)
 		},
+		"method with a space":   func(o *option.V2RayXHTTPOptions) { o.Mode, o.UplinkHTTPMethod = modePacketUp, "P OST" },
+		"method with a newline": func(o *option.V2RayXHTTPOptions) { o.UplinkHTTPMethod = "POST\r\nX: y" },
+		"method not ASCII":      func(o *option.V2RayXHTTPOptions) { o.UplinkHTTPMethod = "ПОСТ" },
+		"download method": func(o *option.V2RayXHTTPOptions) {
+			o.Download = &option.V2RayXHTTPDownloadOptions{ServerOptions: option.ServerOptions{Server: "127.0.0.1", ServerPort: 1}}
+			o.Download.UplinkHTTPMethod = "P OST"
+		},
 	}
 	for name, configure := range cases {
 		options := option.V2RayXHTTPOptions{}
@@ -76,6 +83,7 @@ func TestXHTTPConfigDefaults(t *testing.T) {
 		"zero post size is default": func(o *option.V2RayXHTTPOptions) { o.ScMaxEachPostBytes = xrange(0, 0) },
 		"negative interval":         func(o *option.V2RayXHTTPOptions) { o.ScMinPostsIntervalMs = xrange(-1, -1) },
 		"GET upload in packet-up":   func(o *option.V2RayXHTTPOptions) { o.Mode, o.UplinkHTTPMethod = modePacketUp, "GET" },
+		"method in lower case":      func(o *option.V2RayXHTTPOptions) { o.UplinkHTTPMethod = "put" },
 		"server-side settings": func(o *option.V2RayXHTTPOptions) {
 			o.NoSSEHeader, o.ScMaxBufferedPosts, o.ScStreamUpServerSecs, o.ServerMaxHeaderBytes = true, 30, xrange(20, 80), 8192
 		},
