From 61d818deffde14743f4bd71b99f19ad8f53534f2 Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Tue, 6 Oct 2026 23:57:23 +0300
Subject: [PATCH 73/88] xhttp: one check of the options, and a download server
 needs its port

CheckOptions, which the decoder of share links calls, repeated the validation of
NewClient line by line, and the two could drift apart. Both go through one function now.

It also refuses download without server_port. An address without a port counts as valid,
so such a configuration passed "sing-box check" and every dial of the download failed.
---
 transport/v2rayxhttp/client.go      | 63 ++++++++++++++---------------
 transport/v2rayxhttp/config_test.go |  9 +++++
 2 files changed, 39 insertions(+), 33 deletions(-)

diff --git a/transport/v2rayxhttp/client.go b/transport/v2rayxhttp/client.go
index 2c50a8dfe..93f779ae3 100644
--- a/transport/v2rayxhttp/client.go
+++ b/transport/v2rayxhttp/client.go
@@ -46,46 +46,49 @@ type Client struct {
 // with nothing dialed: for tools that build the options, such as the decoder
 // of share links.
 func CheckOptions(options option.V2RayXHTTPOptions) error {
-	mode := options.Mode
+	_, _, _, err := checkOptions(options)
+	return err
+}
+
+// checkOptions is the one check of the options, for CheckOptions and
+// NewClient: the configured mode ("auto" for none) and the request shape of
+// the upload leg and, when download is set, of the download leg.
+func checkOptions(options option.V2RayXHTTPOptions) (mode string, up *requestConfig, down *requestConfig, err error) {
+	mode = options.Mode
 	switch mode {
 	case "":
 		mode = modeAuto
 	case modeAuto, modePacketUp, modeStreamUp, modeStreamOne:
 	default:
-		return E.New("unsupported mode: ", mode)
+		return "", nil, nil, E.New("unsupported mode: ", mode)
 	}
 	if options.Download != nil && mode == modeStreamOne {
-		return E.New("download can't be used in stream-one mode")
+		return "", nil, nil, E.New("download can't be used in stream-one mode")
 	}
-	_, err := newRequestConfig(options.V2RayXHTTPBaseOptions, mode)
+	up, err = newRequestConfig(options.V2RayXHTTPBaseOptions, mode)
 	if err != nil {
-		return err
+		return "", nil, nil, err
 	}
-	if options.Download != nil {
-		if options.Download.Server == "" {
-			return E.New("download: missing server")
-		}
-		_, err = newRequestConfig(options.Download.V2RayXHTTPBaseOptions, mode)
-		if err != nil {
-			return E.Cause(err, "download")
-		}
+	if options.Download == nil {
+		return mode, up, nil, nil
 	}
-	return nil
+	if options.Download.Server == "" {
+		return "", nil, nil, E.New("download: missing server")
+	}
+	// Without a port the address still counts as valid, and every dial of the
+	// download would fail instead.
+	if options.Download.ServerPort == 0 {
+		return "", nil, nil, E.New("download: missing server_port")
+	}
+	down, err = newRequestConfig(options.Download.V2RayXHTTPBaseOptions, mode)
+	if err != nil {
+		return "", nil, nil, E.Cause(err, "download")
+	}
+	return mode, up, down, nil
 }
 
 func NewClient(ctx context.Context, outboundDialer N.Dialer, serverAddr M.Socksaddr, options option.V2RayXHTTPOptions, tlsConfig tls.Config) (adapter.V2RayClientTransport, error) {
-	mode := options.Mode
-	switch mode {
-	case "":
-		mode = modeAuto
-	case modeAuto, modePacketUp, modeStreamUp, modeStreamOne:
-	default:
-		return nil, E.New("unsupported mode: ", mode)
-	}
-	if options.Download != nil && mode == modeStreamOne {
-		return nil, E.New("download can't be used in stream-one mode")
-	}
-	up, err := newRequestConfig(options.V2RayXHTTPBaseOptions, mode)
+	mode, up, down, err := checkOptions(options)
 	if err != nil {
 		return nil, err
 	}
@@ -108,13 +111,7 @@ func NewClient(ctx context.Context, outboundDialer N.Dialer, serverAddr M.Socksa
 		return client, nil
 	}
 	download := options.Download
-	if download.Server == "" {
-		return nil, E.New("download: missing server")
-	}
-	client.down, err = newRequestConfig(download.V2RayXHTTPBaseOptions, mode)
-	if err != nil {
-		return nil, E.Cause(err, "download")
-	}
+	client.down = down
 	downDialer := outboundDialer
 	if download.Detour != "" {
 		downDialer, err = dialer.New(ctx, option.DialerOptions{Detour: download.Detour}, M.IsDomainName(download.Server))
diff --git a/transport/v2rayxhttp/config_test.go b/transport/v2rayxhttp/config_test.go
index 6e654ea22..ca4ffd383 100644
--- a/transport/v2rayxhttp/config_test.go
+++ b/transport/v2rayxhttp/config_test.go
@@ -61,6 +61,9 @@ func TestXHTTPConfigErrors(t *testing.T) {
 			o.Download = &option.V2RayXHTTPDownloadOptions{ServerOptions: option.ServerOptions{Server: "127.0.0.1", ServerPort: 1}}
 			o.Download.XPaddingBytes = xrange(0, 10)
 		},
+		"download without port": func(o *option.V2RayXHTTPOptions) {
+			o.Download = &option.V2RayXHTTPDownloadOptions{ServerOptions: option.ServerOptions{Server: "127.0.0.1"}}
+		},
 		"method with a space":   func(o *option.V2RayXHTTPOptions) { o.Mode, o.UplinkHTTPMethod = modePacketUp, "P OST" },
 		"method with a newline": func(o *option.V2RayXHTTPOptions) { o.UplinkHTTPMethod = "POST\r\nX: y" },
 		"method not ASCII":      func(o *option.V2RayXHTTPOptions) { o.UplinkHTTPMethod = "ПОСТ" },
@@ -74,6 +77,8 @@ func TestXHTTPConfigErrors(t *testing.T) {
 		configure(&options)
 		_, err := NewClient(context.Background(), N.SystemDialer, M.ParseSocksaddr("127.0.0.1:443"), options, nil)
 		require.Error(t, err, name)
+		// the check without a client refuses the same options, in the same words
+		require.EqualError(t, CheckOptions(options), err.Error(), name)
 	}
 }
 
@@ -84,6 +89,9 @@ func TestXHTTPConfigDefaults(t *testing.T) {
 		"negative interval":         func(o *option.V2RayXHTTPOptions) { o.ScMinPostsIntervalMs = xrange(-1, -1) },
 		"GET upload in packet-up":   func(o *option.V2RayXHTTPOptions) { o.Mode, o.UplinkHTTPMethod = modePacketUp, "GET" },
 		"method in lower case":      func(o *option.V2RayXHTTPOptions) { o.UplinkHTTPMethod = "put" },
+		"download": func(o *option.V2RayXHTTPOptions) {
+			o.Download = &option.V2RayXHTTPDownloadOptions{ServerOptions: option.ServerOptions{Server: "127.0.0.1", ServerPort: 8443}}
+		},
 		"server-side settings": func(o *option.V2RayXHTTPOptions) {
 			o.NoSSEHeader, o.ScMaxBufferedPosts, o.ScStreamUpServerSecs, o.ServerMaxHeaderBytes = true, 30, xrange(20, 80), 8192
 		},
@@ -94,6 +102,7 @@ func TestXHTTPConfigDefaults(t *testing.T) {
 		transport, err := NewClient(context.Background(), N.SystemDialer, M.ParseSocksaddr("127.0.0.1:443"), options, nil)
 		require.NoError(t, err, name)
 		transport.Close()
+		require.NoError(t, CheckOptions(options), name)
 	}
 	config, err := newRequestConfig(option.V2RayXHTTPBaseOptions{}, modeAuto)
 	require.NoError(t, err)
