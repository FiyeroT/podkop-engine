From 015f962dc475f9e6ae84451db7e6c81627aad0fd Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Tue, 6 Oct 2026 23:40:13 +0300
Subject: [PATCH 078/106] dns: take the first query to a server off the
 goroutine that reads client queries

The first query to a DNS server decides whether the provider fallback applies to it and,
when it does, reads the provider's servers: an exec of ubus, bounded by 3 s.
exchangeTransportAsync, the path of queries hijacked from clients, took that decision
before it started its goroutine, so the exec ran on the goroutine of the DNS inbound
that reads the packets of the client, and the next queries of that session waited for
it.

While the decision is not taken, run it together with the exchange on the goroutine.
The first query still waits for the list, since it may need it, but on its own
goroutine. Once the decision is known, a server without the fallback keeps the
transport's own asynchronous exchange as before, with no goroutine added.
---
 dns/client_fallback.go               |  15 +++-
 dns/client_fallback_exchange_test.go | 122 ++++++++++++++++++++++++++-
 2 files changed, 133 insertions(+), 4 deletions(-)

diff --git a/dns/client_fallback.go b/dns/client_fallback.go
index 527367122..47e372f15 100644
--- a/dns/client_fallback.go
+++ b/dns/client_fallback.go
@@ -8,6 +8,7 @@ import (
 	"reflect"
 	"strings"
 	"sync"
+	"sync/atomic"
 	"time"
 
 	"github.com/sagernet/sing-box/adapter"
@@ -71,6 +72,7 @@ type fallbackServer struct {
 	options option.RemoteDNSServerOptions
 
 	decideOnce sync.Once
+	decided    atomic.Bool // eligible is set
 	eligible   bool
 	dialer     N.Dialer
 
@@ -181,6 +183,7 @@ func probeServer(ctx context.Context, logger logger.ContextLogger, transport ada
 // of the box.
 func (s *fallbackServer) decide(ctx context.Context, logger logger.ContextLogger, tag string) bool {
 	s.decideOnce.Do(func() {
+		defer s.decided.Store(true)
 		var reason string
 		if ctx == nil {
 			reason = "no context"
@@ -431,11 +434,17 @@ func (c *Client) exchangeTransport(ctx context.Context, transport adapter.DNSTra
 }
 
 // exchangeTransportAsync is the path of queries hijacked from clients. Servers without
-// the fallback keep the transport's own asynchronous exchange.
+// the fallback keep the transport's own asynchronous exchange. The caller reads the next
+// queries of the client and must not wait: the first query to a server, which decides
+// and reads the provider's servers (an exec of ubus), does it on the goroutine too.
 func (c *Client) exchangeTransportAsync(ctx context.Context, transport adapter.DNSTransport, message *mDNS.Msg, callback func(response *mDNS.Msg, err error)) {
-	if state := fallbackFor(transport); state != nil && state.decide(c.ctx, c.logger, transport.Tag()) {
+	if state := fallbackFor(transport); state != nil && (!state.decided.Load() || state.eligible) {
 		go func() {
-			callback(exchangeWithFallback(ctx, c.ctx, c.logger, transport, state, message))
+			if state.decide(c.ctx, c.logger, transport.Tag()) {
+				callback(exchangeWithFallback(ctx, c.ctx, c.logger, transport, state, message))
+			} else {
+				transport.ExchangeAsync(ctx, message, callback)
+			}
 		}()
 		return
 	}
diff --git a/dns/client_fallback_exchange_test.go b/dns/client_fallback_exchange_test.go
index d3fd9d7fe..8ec0ea28c 100644
--- a/dns/client_fallback_exchange_test.go
+++ b/dns/client_fallback_exchange_test.go
@@ -94,7 +94,7 @@ func newFallbackTest(providers ...M.Socksaddr) (*fallbackTestTransport, *fallbac
 			readAt:  time.Now(),
 		},
 	}
-	state.decideOnce.Do(func() {})
+	state.decideOnce.Do(func() { state.decided.Store(true) })
 	transport := &fallbackTestTransport{
 		TransportAdapter: TransportAdapter{transportType: "test", transportTag: "dns-server", fallback: state},
 		handler:          fallbackTestAnswers,
@@ -646,3 +646,123 @@ func TestProviderListRereadAfterMiss(t *testing.T) {
 		t.Errorf("the list was read %d times, want 2: a reset reads it at the next use", reads.Load())
 	}
 }
+
+// The first query to a server decides whether the fallback applies and reads the
+// provider's servers. A hijacked query does not wait for that on the goroutine of its
+// caller, which reads the next queries of the client.
+func TestExchangeTransportAsyncFirstQuery(t *testing.T) {
+	t.Parallel()
+	read := make(chan struct{})
+	state := &fallbackServer{
+		options: option.RemoteDNSServerOptions{DNSServerAddressOptions: option.DNSServerAddressOptions{Server: "77.88.8.8"}},
+		providers: &providerSet{read: func(ctx context.Context) ([]netifdInterface, error) {
+			<-read
+			return nil, E.New("no ubus in tests")
+		}},
+	}
+	transport := &fallbackTestTransport{
+		TransportAdapter: TransportAdapter{transportType: "test", transportTag: "dns-server", fallback: state},
+		handler:          fallbackTestAnswers,
+	}
+	client := &Client{ctx: context.Background()}
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	results := make(chan error, 4)
+	returned := make(chan struct{})
+	go func() {
+		client.exchangeTransportAsync(ctx, transport, freshTestQuery(), func(response *mDNS.Msg, err error) {
+			results <- err
+		})
+		close(returned)
+	}()
+	select {
+	case <-returned:
+	case <-time.After(2 * time.Second):
+		t.Error("exchangeTransportAsync waits for the read of the provider's servers")
+	}
+	close(read)
+	<-returned
+	for i := 0; i < 2; i++ {
+		select {
+		case err := <-results:
+			if err != nil {
+				t.Errorf("query %d: %v", i, err)
+			}
+		case <-ctx.Done():
+			t.Fatalf("query %d: the callback was not called", i)
+		}
+		if !state.eligible {
+			t.Fatal("the server does not qualify: its first query read no provider list")
+		}
+		if i == 0 { // the decision is taken now
+			client.exchangeTransportAsync(ctx, transport, freshTestQuery(), func(response *mDNS.Msg, err error) {
+				results <- err
+			})
+		}
+	}
+	select {
+	case <-results:
+		t.Error("a callback was called twice")
+	case <-time.After(200 * time.Millisecond):
+	}
+}
+
+// The first hijacked query to a server that turns out not to qualify is decided on the
+// goroutine as well and is then answered by the server alone, once; the provider's
+// servers are not read for it.
+func TestExchangeTransportAsyncFirstQueryNoFallback(t *testing.T) {
+	t.Parallel()
+	reads := new(atomic.Int32)
+	state := &fallbackServer{
+		options: option.RemoteDNSServerOptions{DNSServerAddressOptions: option.DNSServerAddressOptions{Server: "192.168.1.1"}},
+		providers: &providerSet{read: func(ctx context.Context) ([]netifdInterface, error) {
+			reads.Add(1)
+			return nil, E.New("no ubus in tests")
+		}},
+	}
+	transport := &fallbackTestTransport{
+		TransportAdapter: TransportAdapter{transportType: "test", transportTag: "dns-server", fallback: state},
+		handler:          fallbackTestAnswers,
+	}
+	client := &Client{ctx: context.Background()}
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	type result struct {
+		response *mDNS.Msg
+		err      error
+	}
+	results := make(chan result, 4)
+	// the first query takes the decision, the second finds it taken, the third fails
+	for i, want := range []string{"server", "server", ""} {
+		var wantErr error
+		if want == "" {
+			transport.serve(fallbackTestFails)
+			wantErr = errFallbackTestServer
+		}
+		client.exchangeTransportAsync(ctx, transport, freshTestQuery(), func(response *mDNS.Msg, err error) {
+			results <- result{response, err}
+		})
+		select {
+		case answer := <-results:
+			if got, err := fallbackTestAnswer(answer.response, answer.err); got != want || err != wantErr {
+				t.Errorf("query %d: answered by %q (%v), want %q (%v)", i, got, err, want, wantErr)
+			}
+		case <-ctx.Done():
+			t.Fatalf("query %d: the callback was not called", i)
+		}
+		if !state.decided.Load() || state.eligible {
+			t.Fatalf("query %d: decided %v, want a server that does not qualify", i, state.decided.Load())
+		}
+	}
+	select {
+	case <-results:
+		t.Error("a callback was called twice")
+	case <-time.After(200 * time.Millisecond):
+	}
+	if asked := transport.asked(); asked != 3 {
+		t.Errorf("server asked %d times, want 3", asked)
+	}
+	if reads.Load() != 0 {
+		t.Errorf("the provider's servers were read %d times for a server without the fallback", reads.Load())
+	}
+}
