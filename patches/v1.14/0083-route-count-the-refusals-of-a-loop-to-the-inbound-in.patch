From 45797a01199285aab73efbfbf55d6f6d5008fdcb Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Tue, 6 Oct 2026 23:55:22 +0300
Subject: [PATCH 83/88] route: count the refusals of a loop to the inbound
 instead of logging each

A connection that the direct outbound would dial back to the inbound it came in on is
refused, and every refusal was an error line. What reaches the listen address of an
inbound without being hijacked (a DNS response or anything that is not a query sent to a
DNS inbound) usually keeps coming, and every datagram is a session of its own: a local
sender in a loop filled the log, which on a router is a small ring buffer.

The first refusal of an inbound is logged as before; while they go on, one line every
10 seconds gives the number of refusals in between and the last one, as the DNS client
does for a server that fails.
---
 route/route.go          |  9 ++++-
 route/route_log_test.go | 86 +++++++++++++++++++++++++++++++++++++++++
 route/route_loop_log.go | 71 ++++++++++++++++++++++++++++++++++
 route/router.go         |  1 +
 4 files changed, 165 insertions(+), 2 deletions(-)
 create mode 100644 route/route_loop_log.go

diff --git a/route/route.go b/route/route.go
index 42e93844f..ed9c6ecff 100644
--- a/route/route.go
+++ b/route/route.go
@@ -162,7 +162,7 @@ func (r *Router) routeConnection(ctx context.Context, conn net.Conn, metadata ad
 
 	if r.wouldLoopToInbound(&metadata, selectedOutbound) {
 		buf.ReleaseMulti(buffers)
-		return E.New("refused connection to the address of inbound ", metadata.Inbound, " (", metadata.Destination, "): not hijacked, would loop")
+		return &inboundLoopError{metadata.Inbound, E.New("refused connection to the address of inbound ", metadata.Inbound, " (", metadata.Destination, "): not hijacked, would loop")}
 	}
 	for _, buffer := range buffers {
 		conn = bufio.NewCachedConn(conn, buffer)
@@ -297,7 +297,7 @@ func (r *Router) routePacketConnection(ctx context.Context, conn N.PacketConn, m
 	}
 	if r.wouldLoopToInbound(&metadata, selectedOutbound) {
 		N.ReleaseMultiPacketBuffer(packetBuffers)
-		return E.New("refused packet to the address of inbound ", metadata.Inbound, " (", metadata.Destination, "): not hijacked, would loop")
+		return &inboundLoopError{metadata.Inbound, E.New("refused packet to the address of inbound ", metadata.Inbound, " (", metadata.Destination, "): not hijacked, would loop")}
 	}
 	for _, buffer := range packetBuffers {
 		conn = bufio.NewCachedPacketConn(conn, buffer.Buffer, buffer.Destination)
@@ -564,6 +564,11 @@ func (r *Router) logRefused(ctx context.Context, destination M.Socksaddr, err er
 		r.logger.WarnContext(ctx, "connection to ", destination, " refused: no fakeip record (the address was given out shortly before a crash, was flushed, or was unused for a long time); the client gets a new one when it resolves the name again")
 		return true
 	}
+	var loop *inboundLoopError
+	if errors.As(err, &loop) {
+		r.loopRefusals.refused(ctx, r.logger, loop)
+		return true
+	}
 	return false
 }
 
