diff --git a/common/sniff/sniff.go b/common/sniff/sniff.go
index d76552ef4..a4f61dd14 100644
--- a/common/sniff/sniff.go
+++ b/common/sniff/sniff.go
@@ -29,14 +29,31 @@ var ErrNeedMoreData = E.New("need more data")
 // connection instead of the process.
 var ErrSnifferPanicked = E.New("sniffer panicked")
 
+// SnifferPanicError is what a sniffer that panicked returns; errors.Is finds
+// ErrSnifferPanicked in it. Its text is one line: it stays in the metadata of the
+// connection, which trackers keep, and such connections can come by the hundred. The stack
+// is apart, for whoever logs the bug.
+type SnifferPanicError struct {
+	Value string // the panic
+	Stack []byte
+}
+
+func (e *SnifferPanicError) Error() string {
+	return ErrSnifferPanicked.Error() + ": " + e.Value
+}
+
+func (e *SnifferPanicError) Unwrap() error {
+	return ErrSnifferPanicked
+}
+
 // recovered runs a sniffer. On a panic it restores the metadata the sniffer may have set
-// and returns ErrSnifferPanicked with the panic and its stack.
+// and returns a SnifferPanicError with the panic and its stack.
 func recovered(metadata *adapter.InboundContext, sniff func() error) (err error) {
 	protocol, domain, client, sniffContext := metadata.Protocol, metadata.Domain, metadata.Client, metadata.SniffContext
 	defer func() {
 		if panicked := recover(); panicked != nil {
 			metadata.Protocol, metadata.Domain, metadata.Client, metadata.SniffContext = protocol, domain, client, sniffContext
-			err = fmt.Errorf("%w: %v\n%s", ErrSnifferPanicked, panicked, debug.Stack())
+			err = &SnifferPanicError{Value: fmt.Sprint(panicked), Stack: debug.Stack()}
 		}
 	}()
 	return sniff()
diff --git a/route/route.go b/route/route.go
index ed9c6ecff..ab9d477a1 100644
--- a/route/route.go
+++ b/route/route.go
@@ -6,6 +6,7 @@ import (
 	"net"
 	"net/netip"
 	"strings"
+	"sync"
 	"time"
 
 	"github.com/sagernet/sing-box/adapter"
@@ -818,10 +819,40 @@ match:
 // ClientHellos browsers send, with a post-quantum key share, take two.
 const maxSniffPackets = 16
 
+// A sniffer that panics on what a client sends panics for every such connection. The stack
+// is logged for the first one and then once per snifferPanicLogInterval, with the number
+// of panics in between; those are left to the debug level.
+var snifferPanicLogInterval = time.Minute
+
+type snifferPanicLog struct {
+	access  sync.Mutex
+	logged  time.Time // the last stack
+	skipped int       // panics since then
+}
+
 // logSnifferPanic logs a sniffer that panicked, with its stack: a bug to report.
 func (r *Router) logSnifferPanic(ctx context.Context, err error) {
-	if errors.Is(err, sniff.ErrSnifferPanicked) {
-		r.logger.ErrorContext(ctx, err)
+	var panicked *sniff.SnifferPanicError
+	if !errors.As(err, &panicked) {
+		return
+	}
+	// the error stays in the metadata of the connection: the stack does not
+	stack := panicked.Stack
+	panicked.Stack = nil
+	r.snifferPanics.access.Lock()
+	if !r.snifferPanics.logged.IsZero() && time.Since(r.snifferPanics.logged) < snifferPanicLogInterval {
+		r.snifferPanics.skipped++
+		r.snifferPanics.access.Unlock()
+		r.logger.DebugContext(ctx, panicked)
+		return
+	}
+	skipped := r.snifferPanics.skipped
+	r.snifferPanics.logged, r.snifferPanics.skipped = time.Now(), 0
+	r.snifferPanics.access.Unlock()
+	if skipped > 0 {
+		r.logger.ErrorContext(ctx, panicked, " (", skipped, " more since the last stack was logged)\n", string(stack))
+	} else {
+		r.logger.ErrorContext(ctx, panicked, "\n", string(stack))
 	}
 }
 
