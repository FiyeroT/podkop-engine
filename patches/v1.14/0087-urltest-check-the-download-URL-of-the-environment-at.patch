From db0570d08c837469bfddfa223b780add655e5446 Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Tue, 6 Oct 2026 23:37:27 +0300
Subject: [PATCH 087/106] urltest: check the download URL of the environment at
 start

A download_url the test cannot use is refused as a configuration error, while the value
of SING_BOX_URLTEST_DOWNLOAD_URL was taken as it is: a value without a scheme or a host
was found only by the download test, which dialed the member for nothing and warned at
every switch of the group.

The value now passes the same check as download_url when the group is created. An
unusable one does not stop the start, since it comes from outside the configuration: the
group warns once and works without the download test.
---
 protocol/group/urltest.go               |  7 ++
 protocol/group/urltest_download.go      | 18 ++++-
 protocol/group/urltest_download_test.go | 91 +++++++++++++++++++++++++
 3 files changed, 113 insertions(+), 3 deletions(-)

diff --git a/protocol/group/urltest.go b/protocol/group/urltest.go
index b25c34006..b8ac03af1 100644
--- a/protocol/group/urltest.go
+++ b/protocol/group/urltest.go
@@ -92,6 +92,13 @@ func NewURLTest(ctx context.Context, router adapter.Router, logger log.ContextLo
 	if err != nil {
 		return nil, err
 	}
+	if options.DownloadURL == nil && outbound.downloadLink != "" {
+		err = checkDownloadLink("SING_BOX_URLTEST_DOWNLOAD_URL", outbound.downloadLink)
+		if err != nil {
+			logger.Warn("download test is off: ", err)
+			outbound.downloadLink = ""
+		}
+	}
 	return outbound, nil
 }
 
diff --git a/protocol/group/urltest_download.go b/protocol/group/urltest_download.go
index 8ded7c0d7..fa39caef3 100644
--- a/protocol/group/urltest_download.go
+++ b/protocol/group/urltest_download.go
@@ -31,6 +31,8 @@ import (
 // The test URL is the group's download_url; a group without the option takes
 // SING_BOX_URLTEST_DOWNLOAD_URL (the init script sets it from /etc/config/sing-box), and an
 // empty download_url turns the test off for the group. Without either nothing changes.
+// An environment value the test could not use is no reason to refuse the start: the
+// group warns once and goes without the test.
 
 var (
 	downloadTestLink    = os.Getenv("SING_BOX_URLTEST_DOWNLOAD_URL")
@@ -48,14 +50,24 @@ func groupDownloadLink(downloadURL *string) (string, error) {
 	if link == "" {
 		return "", nil
 	}
+	err := checkDownloadLink("download_url", link)
+	if err != nil {
+		return "", err
+	}
+	return link, nil
+}
+
+// checkDownloadLink tells whether the download test can use link, the value of the
+// setting name.
+func checkDownloadLink(name string, link string) error {
 	linkURL, err := url.Parse(link)
 	if err != nil {
-		return "", E.Cause(err, "parse download_url")
+		return E.Cause(err, "parse ", name)
 	}
 	if (linkURL.Scheme != "http" && linkURL.Scheme != "https") || linkURL.Hostname() == "" {
-		return "", E.New("download_url: an http or https URL with a host expected: ", link)
+		return E.New(name, ": an http or https URL with a host expected: ", link)
 	}
-	return link, nil
+	return nil
 }
 
 // selectTested chooses the TCP member as Select does, except that a member the group would
diff --git a/protocol/group/urltest_download_test.go b/protocol/group/urltest_download_test.go
index 501ea3a53..4ab56fc2a 100644
--- a/protocol/group/urltest_download_test.go
+++ b/protocol/group/urltest_download_test.go
@@ -2,11 +2,14 @@ package group
 
 import (
 	"context"
+	"io"
 	"net"
 	"net/http"
 	"net/http/httptest"
 	"runtime"
 	"strconv"
+	"strings"
+	"sync"
 	"sync/atomic"
 	"syscall"
 	"testing"
@@ -387,3 +390,91 @@ func TestURLTestDownloadURLOption(t *testing.T) {
 		})
 	}
 }
+
+type warnLog struct {
+	access sync.Mutex
+	lines  []string
+}
+
+func (l *warnLog) WriteMessage(level log.Level, message string) {
+	if level != log.LevelWarn {
+		return
+	}
+	l.access.Lock()
+	defer l.access.Unlock()
+	l.lines = append(l.lines, message)
+}
+
+func (l *warnLog) take() []string {
+	l.access.Lock()
+	defer l.access.Unlock()
+	lines := l.lines
+	l.lines = nil
+	return lines
+}
+
+// A download test URL from the environment that the test could not use does not stop the
+// start, as a download_url does: the group warns once, when it is created, and works
+// without the download test.
+func TestURLTestDownloadURLEnvironmentUnusable(t *testing.T) {
+	environment := downloadTestLink
+	t.Cleanup(func() { downloadTestLink = environment })
+	for _, testCase := range []struct {
+		name string
+		link string
+		warn bool
+	}{
+		{"usable", "/full", false}, // on the test server
+		{"unset", "", false},
+		{"no scheme", "environment.test/64k", true},
+		{"not http", "ftp://environment.test/64k", true},
+		{"no host", "https:///64k", true},
+		{"unparsable", "://environment.test", true},
+	} {
+		t.Run(testCase.name, func(t *testing.T) {
+			writer := &warnLog{}
+			factory := log.NewDefaultFactory(context.Background(), log.Formatter{BaseTime: time.Now()}, io.Discard, "", writer, false)
+			factory.SetLevel(log.LevelDebug)
+			require.NoError(t, factory.Start())
+			defer factory.Close()
+
+			working := newDownloadServer(t, "full")
+			link := testCase.link
+			if strings.HasPrefix(link, "/") {
+				link = working.URL + link
+			}
+			downloadTestLink = link
+			a := newTestMember(C.TypeVLESS, "a", dialTo(working))
+			b := newTestMember(C.TypeVLESS, "b", dialTo(working))
+			history := urltest.NewHistoryStorage()
+			history.StoreURLTestHistory("a", &adapter.URLTestHistory{Time: time.Now(), Delay: 10})
+			history.StoreURLTestHistory("b", &adapter.URLTestHistory{Time: time.Now(), Delay: 110})
+			ctx := service.ContextWithPtr(context.Background(), history)
+			manager := &testOutboundManager{members: map[string]adapter.Outbound{"a": a, "b": b}}
+			ctx = service.ContextWith[adapter.OutboundManager](ctx, manager)
+			created, err := NewURLTest(ctx, nil, factory.NewLogger("urltest"), "auto", option.URLTestOutboundOptions{
+				Outbounds: []string{"a", "b"},
+				URL:       working.URL,
+			})
+			require.NoError(t, err)
+			urlTest := created.(*URLTest)
+			require.NoError(t, urlTest.Start())
+			lines := writer.take()
+			if !testCase.warn {
+				require.Empty(t, lines)
+				require.Equal(t, link, urlTest.group.downloadLink)
+				return
+			}
+			require.Len(t, lines, 1)
+			require.Contains(t, lines[0], "SING_BOX_URLTEST_DOWNLOAD_URL")
+			require.Contains(t, lines[0], "download test is off")
+			require.Empty(t, urlTest.group.downloadLink)
+
+			// the group selects a member without a download and says nothing more of the URL
+			urlTest.group.performUpdateCheck()
+			require.Equal(t, "a", urlTest.group.selectedOutboundTCP.Load().Tag())
+			require.Empty(t, writer.take())
+			require.Equal(t, int32(0), working.gets.Load())
+		})
+	}
+}
