From ac6b789e520a4d68fcdf042e393d02b1e8552300 Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Thu, 8 Oct 2026 15:05:53 +0300
Subject: [PATCH 089/125] rule-set: read and drop the rules of a local set
 under its lock

The file watcher swaps the rules of a local rule-set from its own goroutine
while connections match them, and Cleanup and Close reset them without the
lock: a torn slice header is an index panic on the routing path. A list
manager that rewrites the file under traffic reloads the set many times in
a row.

Read the rules under the read lock, drop them under the write lock, and
ignore a reload that the watcher had already started when the set closed.
The same as the remote rule-set already does.
---
 route/rule/rule_set_local.go           | 35 ++++++++++++---
 route/rule/rule_set_local_race_test.go | 61 ++++++++++++++++++++++++++
 2 files changed, 91 insertions(+), 5 deletions(-)
 create mode 100644 route/rule/rule_set_local_race_test.go

diff --git a/route/rule/rule_set_local.go b/route/rule/rule_set_local.go
index 9d5d21e83..02a4e491d 100644
--- a/route/rule/rule_set_local.go
+++ b/route/rule/rule_set_local.go
@@ -31,6 +31,7 @@ type LocalRuleSet struct {
 	tag        string
 	access     sync.RWMutex
 	rules      []adapter.HeadlessRule
+	closed     bool
 	metadata   adapter.RuleSetMetadata
 	fileFormat string
 	watcher    *fswatch.Watcher
@@ -82,7 +83,22 @@ func (s *LocalRuleSet) Name() string {
 }
 
 func (s *LocalRuleSet) String() string {
-	return strings.Join(F.MapToString(s.rules), " ")
+	return strings.Join(F.MapToString(s.currentRules()), " ")
+}
+
+// currentRules reads the rules under the lock that reloadRules swaps them under: the file
+// watcher reloads a local set while connections match it.
+func (s *LocalRuleSet) currentRules() []adapter.HeadlessRule {
+	s.access.RLock()
+	defer s.access.RUnlock()
+	return s.rules
+}
+
+// dropRules forgets the rules, under the same lock.
+func (s *LocalRuleSet) dropRules() {
+	s.access.Lock()
+	s.rules = nil
+	s.access.Unlock()
 }
 
 func (s *LocalRuleSet) StartContext(ctx context.Context, startContext *adapter.HTTPStartContext) error {
@@ -143,6 +159,11 @@ func (s *LocalRuleSet) reloadRules(headlessRules []option.HeadlessRule) error {
 		return err
 	}
 	s.access.Lock()
+	if s.closed {
+		// a reload the watcher had already started when the set was closed
+		s.access.Unlock()
+		return nil
+	}
 	s.rules = rules
 	s.metadata = metadata
 	callbacks := s.callbacks.Array()
@@ -177,7 +198,7 @@ func (s *LocalRuleSet) DecRef() {
 
 func (s *LocalRuleSet) Cleanup() {
 	if s.refs.Load() == 0 {
-		s.rules = nil
+		s.dropRules()
 	}
 }
 
@@ -194,14 +215,18 @@ func (s *LocalRuleSet) UnregisterCallback(element *list.Element[adapter.RuleSetU
 }
 
 func (s *LocalRuleSet) Close() error {
+	err := common.Close(common.PtrOrNil(s.watcher))
+	s.access.Lock()
+	s.closed = true
 	s.rules = nil
-	return common.Close(common.PtrOrNil(s.watcher))
+	s.access.Unlock()
+	return err
 }
 
 func (s *LocalRuleSet) Match(metadata *adapter.InboundContext) bool {
-	return matchAnyHeadlessRule(s.rules, metadata)
+	return matchAnyHeadlessRule(s.currentRules(), metadata)
 }
 
 func (s *LocalRuleSet) mergeableRule() *DefaultHeadlessRule {
-	return mergeableRuleIn(s.rules)
+	return mergeableRuleIn(s.currentRules())
 }
diff --git a/route/rule/rule_set_local_race_test.go b/route/rule/rule_set_local_race_test.go
new file mode 100644
index 000000000..21f95d2b9
--- /dev/null
+++ b/route/rule/rule_set_local_race_test.go
@@ -0,0 +1,61 @@
+package rule
+
+import (
+	"context"
+	"sync"
+	"testing"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common/json"
+	M "github.com/sagernet/sing/common/metadata"
+
+	"github.com/stretchr/testify/require"
+)
+
+// The file watcher swaps the rules of a local set while connections match it: a list
+// manager that rewrites the file (podkop does, once per thousand entries) reloads the set
+// under traffic. Run with -race.
+func TestLocalRuleSetMatchWhileReloading(t *testing.T) {
+	s := &LocalRuleSet{ctx: context.Background(), tag: "test"}
+	rules := func(content string) []option.HeadlessRule {
+		plain, err := json.UnmarshalExtended[option.PlainRuleSetCompat]([]byte(content))
+		require.NoError(t, err)
+		upgraded, err := plain.Upgrade()
+		require.NoError(t, err)
+		return upgraded.Rules
+	}
+	one := rules(`{"version":3,"rules":[{"domain_suffix":["example.com"]}]}`)
+	two := rules(`{"version":3,"rules":[{"domain_suffix":["example.com"]},{"domain_suffix":["example.org"]}]}`)
+	require.NoError(t, s.reloadRules(one))
+	var wg sync.WaitGroup
+	stop := make(chan struct{})
+	for range 4 {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for {
+				select {
+				case <-stop:
+					return
+				default:
+				}
+				metadata := adapter.InboundContext{Domain: "www.example.com", Destination: M.ParseSocksaddr("1.2.3.4:443")}
+				s.Match(&metadata)
+				_ = s.String()
+				_ = s.mergeableRule()
+			}
+		}()
+	}
+	for i := range 50 {
+		if i%2 == 0 {
+			require.NoError(t, s.reloadRules(two))
+		} else {
+			require.NoError(t, s.reloadRules(one))
+		}
+		s.Cleanup()
+	}
+	require.NoError(t, s.Close())
+	close(stop)
+	wg.Wait()
+}
