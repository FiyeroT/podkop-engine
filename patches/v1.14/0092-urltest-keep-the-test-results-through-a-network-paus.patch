From bbdaad42e9f5d44572920373b2f11365904bf83a Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Thu, 8 Oct 2026 16:33:14 +0300
Subject: [PATCH 092/106] urltest: keep the test results through a network
 pause, test again after a busy round

Three things went wrong around a change of the default interface.

While there is no default interface every dial fails at once. The group's
ticker stops for that time, but the judgements made from traffic did not:
each member the group tried lost its test result in turn. They now stop
too, and a confirming test that fails because the network went away under
it is discarded.

A forced round that met a running one was dropped, so the results of the
old interface stayed until the next interval. It is now remembered and one
more round follows the running one, however many were asked for.

A member that failed the download test was frozen as of the end of the
test, so a URL test that passed meanwhile (the forced round, whose network
change also cut the download) did not count as newer. It is frozen as of
the start of the test.
---
 protocol/group/urltest.go              |  13 +-
 protocol/group/urltest_download.go     |   6 +-
 protocol/group/urltest_failure.go      |  17 ++-
 protocol/group/urltest_network_test.go | 161 +++++++++++++++++++++++++
 4 files changed, 194 insertions(+), 3 deletions(-)
 create mode 100644 protocol/group/urltest_network_test.go

diff --git a/protocol/group/urltest.go b/protocol/group/urltest.go
index b8ac03af1..5ecbae6f8 100644
--- a/protocol/group/urltest.go
+++ b/protocol/group/urltest.go
@@ -270,6 +270,7 @@ type URLTestGroup struct {
 	idleTimeout                  time.Duration
 	history                      *urltest.HistoryStorage
 	checking                     atomic.Bool
+	recheck                      atomic.Bool
 	selectedOutboundTCP          common.TypedValue[adapter.Outbound]
 	selectedOutboundUDP          common.TypedValue[adapter.Outbound]
 	interruptGroup               *interrupt.Group
@@ -485,9 +486,19 @@ func (g *URLTestGroup) urlTest(ctx context.Context, force bool) (map[string]uint
 // URLTestOutbounds).
 func (g *URLTestGroup) urlTestRound(ctx context.Context, force bool, wait bool) (map[string]uint16, error) {
 	if g.checking.Swap(true) {
+		if force {
+			// the round in progress began before whatever forced this one (a new default
+			// interface, mostly): its results are of the old state, so another follows it
+			g.recheck.Store(true)
+		}
 		return make(map[string]uint16), nil
 	}
-	defer g.checking.Store(false)
+	defer func() {
+		g.checking.Store(false)
+		if g.recheck.Swap(false) && g.ctx.Err() == nil && !g.networkPaused() {
+			go g.CheckOutbounds(g.ctx, true)
+		}
+	}()
 	return URLTestOutbounds(ctx, g.outbound, g.history, g.logger, g.members, g.link, g.interval, force, wait), nil
 }
 
