From 4ccb24fde0e3f5d01ff86ce5adb9402f08271edb Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Thu, 8 Oct 2026 16:33:14 +0300
Subject: [PATCH 093/125] urltest: one error for a failed dial, naming the
 member

A dial that failed through the group was logged twice, by the group and by
the connection manager, and neither line said which member failed: the
manager names the outbound it dialed, which is the group or a selector
above it.

The group no longer logs the error; it returns it wrapped with the type and
tag of the member, so the manager's line has the member and the cause.
---
 protocol/group/urltest.go              | 13 +++++++++----
 protocol/group/urltest_network_test.go | 25 +++++++++++++++++++++++++
 2 files changed, 34 insertions(+), 4 deletions(-)

diff --git a/protocol/group/urltest.go b/protocol/group/urltest.go
index 5ecbae6f8..ba97a2f1d 100644
--- a/protocol/group/urltest.go
+++ b/protocol/group/urltest.go
@@ -222,9 +222,15 @@ func (s *URLTest) DialContext(ctx context.Context, network string, destination M
 		}
 		return s.group.interruptGroup.NewConn(conn, interrupt.IsExternalConnectionFromContext(ctx)), nil
 	}
-	s.logger.ErrorContext(ctx, err)
 	s.group.memberFailed(ctx, outbound, N.NetworkName(network), err, start)
-	return nil, err
+	return nil, memberError(outbound, err)
+}
+
+// memberError names the member a dial through the group failed on. The caller logs the
+// error once, with the tag of the outbound it dialed (the group, or a selector above it):
+// without the member in it nothing in the log says which server failed.
+func memberError(member adapter.Outbound, err error) error {
+	return E.Cause(err, "outbound/", member.Type(), "[", member.Tag(), "]")
 }
 
 func (s *URLTest) ListenPacket(ctx context.Context, destination M.Socksaddr) (net.PacketConn, error) {
@@ -240,9 +246,8 @@ func (s *URLTest) ListenPacket(ctx context.Context, destination M.Socksaddr) (ne
 	if err == nil {
 		return s.group.interruptGroup.NewPacketConn(conn, interrupt.IsExternalConnectionFromContext(ctx)), nil
 	}
-	s.logger.ErrorContext(ctx, err)
 	s.group.memberFailed(ctx, outbound, N.NetworkUDP, err, time.Time{})
-	return nil, err
+	return nil, memberError(outbound, err)
 }
 
 func (s *URLTest) NewConnection(ctx context.Context, conn net.Conn, metadata adapter.InboundContext, onClose N.CloseHandlerFunc) {
diff --git a/protocol/group/urltest_network_test.go b/protocol/group/urltest_network_test.go
index e56baa17e..af9e45da8 100644
--- a/protocol/group/urltest_network_test.go
+++ b/protocol/group/urltest_network_test.go
@@ -2,7 +2,9 @@ package group
 
 import (
 	"context"
+	"errors"
 	"net"
+	"os"
 	"sync/atomic"
 	"syscall"
 	"testing"
@@ -159,3 +161,26 @@ func TestURLTestFrozenAsOfDownloadStart(t *testing.T) {
 	group.performUpdateCheck()
 	require.Equal(t, int32(2), frozen.gets.Load(), "the result that came during the download test did not count as newer")
 }
+
+// A dial that fails through the group returns one error that names the member, and the
+// error still is what it was for the code above the group.
+func TestURLTestDialErrorNamesMember(t *testing.T) {
+	link, _ := testURL(t, 0)
+	blackholed := newTestMember(C.TypeVLESS, "blackholed", func(context.Context, string, M.Socksaddr) (net.Conn, error) {
+		return nil, &net.OpError{Op: "dial", Net: "tcp", Err: os.ErrDeadlineExceeded}
+	})
+	spare := newTestMember(C.TypeVLESS, "spare", dialWorking)
+	urlTest, _ := newTestURLTest(t, link, blackholed, spare)
+
+	_, err := urlTest.DialContext(context.Background(), N.NetworkTCP, M.ParseSocksaddr("1.2.3.4:443"))
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "outbound/vless[blackholed]: ")
+	var netErr net.Error
+	require.True(t, errors.As(err, &netErr) && netErr.Timeout())
+	require.ErrorIs(t, err, os.ErrDeadlineExceeded)
+
+	_, err = urlTest.ListenPacket(context.Background(), M.ParseSocksaddr("1.2.3.4:443"))
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "outbound/vless[")
+	require.ErrorIs(t, err, os.ErrInvalid)
+}
