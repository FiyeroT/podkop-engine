+// The forged segment of every method, byte for byte, for IPv4 and IPv6: the sequence
+// number moved back by the payload, the checksum inverted, the acknowledgment moved back,
+// the MD5 signature option, the timestamp option an hour back (and at zero when the clock
+// is younger than that). The packets are the ones the encoder of sing-box 1.14 makes.
+var spoofFrameVectors = []struct {
+	family    string
+	source    string
+	target    string
+	method    Method
+	timestamp uint32
+	frame     string
+}{
+	{"IPv4", "192.0.2.10:40000", "203.0.113.5:443", MethodWrongSequence, 0xa1b2c3, "4500003b0000000040067cadc000020acb0071059c4001bb123456659abcdef05018ffff3bf10000666f726765642d636c69656e742d68656c6c6f"},
+	{"IPv4", "192.0.2.10:40000", "203.0.113.5:443", MethodWrongChecksum, 0xa1b2c3, "4500003b0000000040067cadc000020acb0071059c4001bb123456789abcdef05018ffffc4210000666f726765642d636c69656e742d68656c6c6f"},
+	{"IPv4", "192.0.2.10:40000", "203.0.113.5:443", MethodWrongAcknowledgment, 0xa1b2c3, "4500003b0000000040067cadc000020acb0071059c4001bb123456789abc5ef15018ffffbbdd0000666f726765642d636c69656e742d68656c6c6f"},
+	{"IPv4", "192.0.2.10:40000", "203.0.113.5:443", MethodWrongMD5Sig, 0xa1b2c3, "4500004f0000000040067c99c000020acb0071059c4001bb123456789abcdef0a018ffffd8b700001312000000000000000000000000000000000000666f726765642d636c69656e742d68656c6c6f"},
+	{"IPv4", "192.0.2.10:40000", "203.0.113.5:443", MethodWrongTimestamp, 0xa1b2c3, "450000470000000040067ca1c000020acb0071059c4001bb123456789abcdef08018ffff3f1a0000080a006ac443000000000000666f726765642d636c69656e742d68656c6c6f"},
+	{"IPv4", "192.0.2.10:40000", "203.0.113.5:443", MethodWrongTimestamp, 0x3e8, "450000470000000040067ca1c000020acb0071059c4001bb123456789abcdef08018ffff03c80000080a00000000000000000000666f726765642d636c69656e742d68656c6c6f"},
+	{"IPv6", "[2001:db8::10]:40000", "[2001:db8:1::5]:443", MethodWrongSequence, 0xa1b2c3, "600000000027064020010db800000000000000000000001020010db80001000000000000000000059c4001bb123456659abcdef05018ffffde790000666f726765642d636c69656e742d68656c6c6f"},
+	{"IPv6", "[2001:db8::10]:40000", "[2001:db8:1::5]:443", MethodWrongChecksum, 0xa1b2c3, "600000000027064020010db800000000000000000000001020010db80001000000000000000000059c4001bb123456789abcdef05018ffff21990000666f726765642d636c69656e742d68656c6c6f"},
+	{"IPv6", "[2001:db8::10]:40000", "[2001:db8:1::5]:443", MethodWrongAcknowledgment, 0xa1b2c3, "600000000027064020010db800000000000000000000001020010db80001000000000000000000059c4001bb123456789abc5ef15018ffff5e660000666f726765642d636c69656e742d68656c6c6f"},
+	{"IPv6", "[2001:db8::10]:40000", "[2001:db8:1::5]:443", MethodWrongMD5Sig, 0xa1b2c3, "60000000003b064020010db800000000000000000000001020010db80001000000000000000000059c4001bb123456789abcdef0a018ffff7b4000001312000000000000000000000000000000000000666f726765642d636c69656e742d68656c6c6f"},
+	{"IPv6", "[2001:db8::10]:40000", "[2001:db8:1::5]:443", MethodWrongTimestamp, 0xa1b2c3, "600000000033064020010db800000000000000000000001020010db80001000000000000000000059c4001bb123456789abcdef08018ffffe1a20000080a006ac443000000000000666f726765642d636c69656e742d68656c6c6f"},
+	{"IPv6", "[2001:db8::10]:40000", "[2001:db8:1::5]:443", MethodWrongTimestamp, 0x3e8, "600000000033064020010db800000000000000000000001020010db80001000000000000000000059c4001bb123456789abcdef08018ffffa6500000080a00000000000000000000666f726765642d636c69656e742d68656c6c6f"},
+}
+
+func TestSpoofFrameVectors(t *testing.T) {
+	for _, vector := range spoofFrameVectors {
+		frame, err := buildSpoofFrame(vector.method, netip.MustParseAddrPort(vector.source), netip.MustParseAddrPort(vector.target),
+			0x12345678, 0x9abcdef0, vector.timestamp, nil, []byte("forged-client-hello"))
+		require.NoError(t, err)
+		require.Equal(t, vector.frame, hex.EncodeToString(frame), "%s %s timestamp %d", vector.family, vector.method, vector.timestamp)
+	}
+}
