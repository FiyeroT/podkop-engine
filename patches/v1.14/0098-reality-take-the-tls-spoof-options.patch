From fed41e840bdeed41395e08b445f0afc052746457 Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Thu, 8 Oct 2026 17:06:43 +0300
Subject: [PATCH 098/118] reality: take the tls spoof options

The REALITY client refused spoof and spoof_method, though its handshake runs over the
same TCP connection as that of any other TLS client, and REALITY authenticates by the
real ClientHello, which the forged one does not touch. The forged ClientHello is sent
before the uTLS handshake, as the uTLS client does it; the options keep their checks.
---
 common/tls/reality_client.go     |  9 +++++---
 common/tls/reality_spoof_test.go | 36 ++++++++++++++++++++++++++++++++
 2 files changed, 42 insertions(+), 3 deletions(-)
 create mode 100644 common/tls/reality_spoof_test.go

diff --git a/common/tls/reality_client.go b/common/tls/reality_client.go
index f6ec87dee..d2e3178dc 100644
--- a/common/tls/reality_client.go
+++ b/common/tls/reality_client.go
@@ -89,9 +89,6 @@ func newRealityClient(ctx context.Context, logger logger.ContextLogger, serverAd
 	if options.UTLS == nil || !options.UTLS.Enabled {
 		return nil, E.New("uTLS is required by reality client")
 	}
-	if options.Spoof != "" || options.SpoofMethod != "" {
-		return nil, E.New("spoof is unsupported in reality")
-	}
 
 	classicFingerprint, err := checkRealityFingerprint(options.UTLS.Fingerprint)
 	if err != nil {
@@ -181,6 +178,12 @@ func (e *RealityClientConfig) ClientHandshake(ctx context.Context, conn net.Conn
 	uConfig.InsecureSkipVerify = true
 	uConfig.SessionTicketsDisabled = true
 	uConfig.VerifyPeerCertificate = verifier.VerifyPeerCertificate
+	// the forged ClientHello goes before the real one on the same connection, as with any
+	// other TLS client; REALITY authenticates by the real one
+	conn, err := applyTLSSpoof(conn, e.uClient.spoof, e.uClient.spoofMethod)
+	if err != nil {
+		return nil, err
+	}
 	uConn, err := newUClient(conn, uConfig, e.uClient.id)
 	if err != nil {
 		return nil, err
diff --git a/common/tls/reality_spoof_test.go b/common/tls/reality_spoof_test.go
new file mode 100644
index 000000000..8151dd42c
--- /dev/null
+++ b/common/tls/reality_spoof_test.go
@@ -0,0 +1,36 @@
+//go:build with_utls && linux
+
+package tls
+
+import (
+	"context"
+	"testing"
+
+	"github.com/sagernet/sing-box/common/tlsspoof"
+
+	"github.com/stretchr/testify/require"
+)
+
+// A REALITY client takes the spoof options as the other TLS clients do, with their
+// checks: the forged name must differ from the server name.
+func TestRealityClientTakesSpoof(t *testing.T) {
+	logger, _ := newWarnLogger(t)
+	options := realityOptionsForTest("chrome", true)
+	options.Spoof = "packagist.org"
+	options.SpoofMethod = tlsspoof.MethodNameWrongMD5Sig
+	config, err := NewClient(context.Background(), logger, "192.0.2.1", options)
+	require.NoError(t, err)
+	reality, isReality := config.(*RealityClientConfig)
+	require.True(t, isReality)
+	require.Equal(t, "packagist.org", reality.uClient.spoof)
+	require.Equal(t, tlsspoof.MethodWrongMD5Sig, reality.uClient.spoofMethod)
+
+	options.Spoof = options.ServerName
+	_, err = NewClient(context.Background(), logger, "192.0.2.1", options)
+	require.ErrorContains(t, err, "must differ from `server_name`")
+
+	options.Spoof = "packagist.org"
+	options.SpoofMethod = "wrong-everything"
+	_, err = NewClient(context.Background(), logger, "192.0.2.1", options)
+	require.ErrorContains(t, err, "unknown method")
+}
