index 000000000..279f62739
--- /dev/null
+++ b/common/tls/utls_fallback.go
@@ -0,0 +1,242 @@
+//go:build with_utls
+
+package tls
+
+import (
+	"net"
+	"net/netip"
+	"os"
+	"strings"
+	"sync"
+
+	"github.com/sagernet/sing-box/log"
+	E "github.com/sagernet/sing/common/exceptions"
+	"github.com/sagernet/sing/common/logger"
+	M "github.com/sagernet/sing/common/metadata"
+
+	utls "github.com/metacubex/utls"
+)
+
+const (
+	// handshakes of one dial; the next dial goes on with the list
+	utlsFallbackAttempts = 3
+	// local addresses whose fingerprint is remembered
+	utlsFallbackPaths = 8
+)
+
+var (
+	utlsFallbackOrder   = os.Getenv("SING_BOX_UTLS_FALLBACK")
+	utlsFallbackWarning sync.Once
+)
+
+type utlsFallbackCandidate struct {
+	name string
+	id   utls.ClientHelloID
+}
+
+// utlsFallbackPath is what the fallback has learned from one local address.
+type utlsFallbackPath struct {
+	local netip.Addr
+	// the candidate in use
+	position int
+	// candidates in a row whose ClientHello got no acknowledgment
+	failed int
+	// the candidate reported as the one that works, plus one
+	reported int
+}
+
+// utlsFallback is shared by a client configuration and its clones.
+type utlsFallback struct {
+	logger logger.ContextLogger
+	// the configured fingerprint first
+	candidates []utlsFallbackCandidate
+	// with tls.spoof nothing is remembered: the forged ClientHello may be what the
+	// path does not let through, and then no fingerprint is the one that works
+	spoof  bool
+	access sync.Mutex
+	paths  []*utlsFallbackPath
+}
+
+// newUTLSFallback makes the fallback of a client with the fingerprint configured (of the
+// ID configuredID), nil when it is off: no list in the environment, a list with a name
+// that is not a fingerprint, or nothing in it to go on with. For REALITY the fingerprints
+// it does not work with, or only with older servers, are left out.
+func newUTLSFallback(logger logger.ContextLogger, configured string, configuredID utls.ClientHelloID, reality bool, spoof bool) *utlsFallback {
+	if utlsFallbackOrder == "" {
+		return nil
+	}
+	if logger == nil {
+		logger = log.StdLogger()
+	}
+	if configured == "" {
+		configured = "chrome"
+	}
+	candidates := []utlsFallbackCandidate{{configured, configuredID}}
+	for _, name := range strings.Split(utlsFallbackOrder, ",") {
+		name = strings.TrimSpace(name)
+		if name == "" {
+			continue
+		}
+		id, err := uTLSClientHelloID(name)
+		if err != nil {
+			utlsFallbackWarning.Do(func() {
+				logger.Warn("SING_BOX_UTLS_FALLBACK: ", name, " is not a uTLS fingerprint, the fingerprint fallback is off")
+			})
+			return nil
+		}
+		if reality {
+			classic, err := checkRealityFingerprint(name)
+			if err != nil || classic {
+				continue
+			}
+		}
+		known := false
+		for _, candidate := range candidates {
+			if candidate.id == id {
+				known = true
+				break
+			}
+		}
+		if !known {
+			candidates = append(candidates, utlsFallbackCandidate{name, id})
+		}
+	}
+	if len(candidates) < 2 {
+		return nil
+	}
+	return &utlsFallback{logger: logger, candidates: candidates, spoof: spoof}
+}
+
+// path returns what is known of the local address of conn. The caller holds the lock.
+func (f *utlsFallback) path(conn net.Conn) *utlsFallbackPath {
+	local := M.AddrPortFromNet(conn.LocalAddr()).Addr().Unmap().WithZone("")
+	if f.spoof {
+		return &utlsFallbackPath{local: local}
+	}
+	for index, path := range f.paths {
+		if path.local == local {
+			// the most recently used first
+			copy(f.paths[1:index+1], f.paths[:index])
+			f.paths[0] = path
+			return path
+		}
+	}
+	path := &utlsFallbackPath{local: local}
+	if len(f.paths) < utlsFallbackPaths {
+		f.paths = append(f.paths, nil)
+	}
+	copy(f.paths[1:], f.paths)
+	f.paths[0] = path
+	return path
+}
+
+func (f *utlsFallback) names() string {
+	names := make([]string, 0, len(f.candidates))
+	for _, candidate := range f.candidates {
+		names = append(names, candidate.name)
+	}
+	return strings.Join(names, ", ")
+}
+
+// utlsFallbackDial follows one dial: fingerprintDial.
+type utlsFallbackDial struct {
+	fallback *utlsFallback
+	// configuration returns the configuration of the dial with another fingerprint
+	configuration func(id utls.ClientHelloID) Config
+	path          *utlsFallbackPath
+	// the candidate of the last attempt
+	position int
+	attempts int
+}
+
+func (d *utlsFallbackDial) attempt(conn net.Conn) Config {
+	f := d.fallback
+	f.access.Lock()
+	if d.path == nil {
+		d.path = f.path(conn)
+	}
+	d.position = d.path.position
+	f.access.Unlock()
+	d.attempts++
+	return d.configuration(f.candidates[d.position].id)
+}
+
+func (d *utlsFallbackDial) answered() {
+	f := d.fallback
+	f.access.Lock()
+	defer f.access.Unlock()
+	if d.path.position != d.position {
+		return
+	}
+	d.path.failed = 0
+	if d.position != 0 && d.path.reported != d.position+1 && !f.spoof {
+		d.path.reported = d.position + 1
+		f.logger.Warn("tls: fingerprint ", f.candidates[d.position].name, " is answered where ", f.candidates[0].name, " was not; it is used from now on")
+	}
+}
+
+func (d *utlsFallbackDial) unanswered(destination M.Socksaddr) (bool, error) {
+	f := d.fallback
+	f.access.Lock()
+	defer f.access.Unlock()
+	last := f.candidates[d.position].name
+	// another dial may have moved on already
+	if d.path.position == d.position {
+		d.path.position = (d.position + 1) % len(f.candidates)
+		d.path.failed++
+	}
+	if d.path.failed >= len(f.candidates) {
+		d.path.failed = 0
+		note := ""
+		if f.spoof {
+			note = "; tls.spoof is enabled and may be the cause"
+		}
+		f.logger.Warn("tls: ClientHello to ", destination, " unanswered with all fingerprints (", f.names(), ")", note)
+		return false, E.New("ClientHello unanswered with all fingerprints (", f.names(), ")", note)
+	}
+	next := f.candidates[d.path.position].name
+	if d.attempts >= utlsFallbackAttempts {
+		if f.spoof {
+			f.logger.Warn("tls: ClientHello to ", destination, " unanswered with fingerprint ", last, " and the ones before it; tls.spoof is enabled and may be the cause")
+		} else {
+			f.logger.Warn("tls: ClientHello to ", destination, " unanswered with fingerprint ", last, ", the next connection tries ", next)
+		}
+		return false, E.New("ClientHello unanswered with fingerprint ", last)
+	}
+	f.logger.Warn("tls: ClientHello to ", destination, " unanswered with fingerprint ", last, ", retrying with ", next)
+	return true, nil
+}
+
+func (c *UTLSClientConfig) fingerprintDial() fingerprintDial {
+	if c.fallback == nil {
+		return nil
+	}
+	return &utlsFallbackDial{
+		fallback: c.fallback,
+		configuration: func(id utls.ClientHelloID) Config {
+			attempt := *c
+			attempt.id = id
+			return &attempt
+		},
+	}
+}
+
+func (e *RealityClientConfig) fingerprintDial() fingerprintDial {
+	if e.uClient.fallback == nil {
+		return nil
+	}
+	return &utlsFallbackDial{
+		fallback: e.uClient.fallback,
+		configuration: func(id utls.ClientHelloID) Config {
+			uClient := *e.uClient
+			uClient.id = id
+			attempt := *e
+			attempt.uClient = &uClient
+			if id != e.uClient.id {
+				// the fingerprints of the list carry the key share REALITY asks for
+				attempt.classicFingerprint = ""
+			}
+			return &attempt
+		},
+	}
+}
diff --git a/common/tls/utls_fallback_test.go b/common/tls/utls_fallback_test.go
new file mode 100644
index 000000000..1f08abb80
--- /dev/null
+++ b/common/tls/utls_fallback_test.go
@@ -0,0 +1,233 @@
+//go:build with_utls
+
+package tls
+
+import (
+	"context"
+	"net"
+	"strings"
+	"sync"
+	"testing"
+
+	M "github.com/sagernet/sing/common/metadata"
+
+	utls "github.com/metacubex/utls"
+	"github.com/stretchr/testify/require"
+)
+
+type localAddrConn struct {
+	net.Conn
+	local string
+}
+
+func (c localAddrConn) LocalAddr() net.Addr {
+	return &net.TCPAddr{IP: net.ParseIP(c.local), Port: 40000}
+}
+
+func setFallbackOrder(t *testing.T, order string) {
+	previous := utlsFallbackOrder
+	utlsFallbackOrder = order
+	utlsFallbackWarning = sync.Once{}
+	t.Cleanup(func() {
+		utlsFallbackOrder = previous
+		utlsFallbackWarning = sync.Once{}
+	})
+}
+
+func fallbackClient(t *testing.T, fingerprint string, reality bool) (Config, *warnLog) {
+	logger, warnings := newWarnLogger(t)
+	config, err := NewClient(context.Background(), logger, "192.0.2.1", realityOptionsForTest(fingerprint, reality))
+	require.NoError(t, err)
+	return config, warnings
+}
+
+func attemptName(t *testing.T, dial fingerprintDial, local string) string {
+	config := dial.attempt(localAddrConn{local: local})
+	var id utls.ClientHelloID
+	switch config := config.(type) {
+	case *UTLSClientConfig:
+		id = config.id
+	case *RealityClientConfig:
+		id = config.uClient.id
+	default:
+		t.Fatalf("unexpected configuration %T", config)
+	}
+	for _, name := range []string{"chrome", "firefox", "safari", "edge", "ios", "qq", "360", "android", "randomized"} {
+		if known, _ := uTLSClientHelloID(name); known == id {
+			return name
+		}
+	}
+	t.Fatalf("unknown fingerprint %v", id)
+	return ""
+}
+
+var fallbackServer = M.ParseSocksaddrHostPort("192.0.2.1", 443)
+
+// The candidates are the configured fingerprint and then the list, each once; for REALITY
+// without the fingerprints it refuses or accepts only from older servers. No list, a name
+// that is not a fingerprint or nothing to go on with: no fallback.
+func TestUTLSFallbackCandidates(t *testing.T) {
+	names := func(config Config) string {
+		dialer, hasFallback := config.(fingerprintFallbackConfig)
+		require.True(t, hasFallback)
+		dial := dialer.fingerprintDial()
+		if dial == nil {
+			return ""
+		}
+		return dial.(*utlsFallbackDial).fallback.names()
+	}
+	setFallbackOrder(t, "safari,randomized,firefox,chrome")
+	config, _ := fallbackClient(t, "chrome", false)
+	require.Equal(t, "chrome, safari, randomized, firefox", names(config))
+	config, _ = fallbackClient(t, "", false)
+	require.Equal(t, "chrome, safari, randomized, firefox", names(config))
+	config, _ = fallbackClient(t, "firefox", true)
+	require.Equal(t, "firefox, safari, randomized, chrome", names(config))
+	require.Equal(t, names(config), names(config.Clone()))
+
+	setFallbackOrder(t, " edge, ios,qq,android,360 ,,safari")
+	config, _ = fallbackClient(t, "chrome", true)
+	require.Equal(t, "chrome, safari", names(config))
+	config, _ = fallbackClient(t, "chrome", false)
+	require.Equal(t, "chrome, edge, ios, qq, android, 360, safari", names(config))
+
+	setFallbackOrder(t, "chrome")
+	config, _ = fallbackClient(t, "chrome", false)
+	require.Empty(t, names(config))
+
+	setFallbackOrder(t, "")
+	config, _ = fallbackClient(t, "chrome", false)
+	require.Empty(t, names(config))
+
+	setFallbackOrder(t, "safari,opera")
+	config, warnings := fallbackClient(t, "chrome", false)
+	require.Empty(t, names(config))
+	lines := warnings.take()
+	require.Len(t, lines, 1)
+	require.Contains(t, lines[0], "opera is not a uTLS fingerprint")
+	_, warnings = fallbackClient(t, "chrome", false)
+	require.Empty(t, warnings.take(), "the warning comes once")
+}
+
+// One dial goes through the list until a ClientHello is answered, three handshakes at
+// most; the fingerprint that was answered is the one the next dials begin with, and the
+// one that is not answered any more gives way to the next.
+func TestUTLSFallbackDial(t *testing.T) {
+	setFallbackOrder(t, "safari,randomized,firefox")
+	for _, reality := range []bool{false, true} {
+		config, warnings := fallbackClient(t, "chrome", reality)
+		newDial := func() fingerprintDial {
+			return config.(fingerprintFallbackConfig).fingerprintDial()
+		}
+
+		dial := newDial()
+		require.Equal(t, "chrome", attemptName(t, dial, "192.0.2.10"))
+		again, err := dial.unanswered(fallbackServer)
+		require.True(t, again)
+		require.NoError(t, err)
+		require.Equal(t, "safari", attemptName(t, dial, "192.0.2.10"))
+		dial.answered()
+		lines := warnings.take()
+		require.Len(t, lines, 2)
+		require.Contains(t, lines[0], "tls: ClientHello to 192.0.2.1:443 unanswered with fingerprint chrome, retrying with safari")
+		require.Contains(t, lines[1], "tls: fingerprint safari is answered where chrome was not; it is used from now on")
+
+		dial = newDial()
+		require.Equal(t, "safari", attemptName(t, dial, "192.0.2.10"))
+		dial.answered()
+		require.Empty(t, warnings.take())
+
+		// the clone of a transport shares what was learned
+		cloned := config.Clone().(fingerprintFallbackConfig).fingerprintDial()
+		require.Equal(t, "safari", attemptName(t, cloned, "192.0.2.10"))
+
+		// another local address is another network
+		dial = newDial()
+		require.Equal(t, "chrome", attemptName(t, dial, "198.51.100.7"))
+		dial.answered()
+		dial = newDial()
+		require.Equal(t, "safari", attemptName(t, dial, "192.0.2.10"))
+
+		// nothing is answered: three handshakes a dial, then the whole list is reported
+		again, err = dial.unanswered(fallbackServer)
+		require.True(t, again)
+		require.NoError(t, err)
+		require.Equal(t, "randomized", attemptName(t, dial, "192.0.2.10"))
+		again, _ = dial.unanswered(fallbackServer)
+		require.True(t, again)
+		require.Equal(t, "firefox", attemptName(t, dial, "192.0.2.10"))
+		again, err = dial.unanswered(fallbackServer)
+		require.False(t, again)
+		require.ErrorContains(t, err, "ClientHello unanswered with fingerprint firefox")
+		lines = warnings.take()
+		require.Len(t, lines, 3)
+		require.Contains(t, lines[2], "unanswered with fingerprint firefox, the next connection tries chrome")
+
+		dial = newDial()
+		require.Equal(t, "chrome", attemptName(t, dial, "192.0.2.10"))
+		again, err = dial.unanswered(fallbackServer)
+		require.False(t, again)
+		require.ErrorContains(t, err, "ClientHello unanswered with all fingerprints (chrome, safari, randomized, firefox)")
+		lines = warnings.take()
+		require.Len(t, lines, 1)
+		require.Contains(t, lines[0], "tls: ClientHello to 192.0.2.1:443 unanswered with all fingerprints (chrome, safari, randomized, firefox)")
+		require.False(t, strings.Contains(lines[0], "tls.spoof"))
+
+		// the configuration itself keeps its fingerprint
+		switch config := config.(type) {
+		case *UTLSClientConfig:
+			require.Equal(t, utls.HelloChrome_Auto, config.id)
+		case *RealityClientConfig:
+			require.Equal(t, utls.HelloChrome_Auto, config.uClient.id)
+		}
+	}
+}
+
+// Two dials that lost the same ClientHello move the list on by one fingerprint, not two.
+func TestUTLSFallbackConcurrentDials(t *testing.T) {
+	setFallbackOrder(t, "safari,randomized,firefox")
+	config, _ := fallbackClient(t, "chrome", false)
+	first := config.(fingerprintFallbackConfig).fingerprintDial()
+	second := config.(fingerprintFallbackConfig).fingerprintDial()
+	require.Equal(t, "chrome", attemptName(t, first, "192.0.2.10"))
+	require.Equal(t, "chrome", attemptName(t, second, "192.0.2.10"))
+	again, _ := first.unanswered(fallbackServer)
+	require.True(t, again)
+	again, _ = second.unanswered(fallbackServer)
+	require.True(t, again)
+	require.Equal(t, "safari", attemptName(t, first, "192.0.2.10"))
+	require.Equal(t, "safari", attemptName(t, second, "192.0.2.10"))
+}
+
+// With tls.spoof nothing is remembered, and the report names it as a possible cause.
+func TestUTLSFallbackWithSpoof(t *testing.T) {
+	setFallbackOrder(t, "safari,firefox")
+	logger, warnings := newWarnLogger(t)
+	options := realityOptionsForTest("chrome", false)
+	options.Spoof = "packagist.org"
+	config, err := NewClient(context.Background(), logger, "192.0.2.1", options)
+	if err != nil {
+		t.Skip("tls spoof is not supported here: ", err)
+	}
+	dial := config.(fingerprintFallbackConfig).fingerprintDial()
+	require.Equal(t, "chrome", attemptName(t, dial, "192.0.2.10"))
+	again, _ := dial.unanswered(fallbackServer)
+	require.True(t, again)
+	require.Equal(t, "safari", attemptName(t, dial, "192.0.2.10"))
+	dial.answered()
+	require.Len(t, warnings.take(), 1, "no fingerprint is announced as the one that works")
+
+	dial = config.(fingerprintFallbackConfig).fingerprintDial()
+	require.Equal(t, "chrome", attemptName(t, dial, "192.0.2.10"))
+	again, _ = dial.unanswered(fallbackServer)
+	require.True(t, again)
+	require.Equal(t, "safari", attemptName(t, dial, "192.0.2.10"))
+	again, _ = dial.unanswered(fallbackServer)
+	require.True(t, again)
+	require.Equal(t, "firefox", attemptName(t, dial, "192.0.2.10"))
+	again, err = dial.unanswered(fallbackServer)
+	require.False(t, again)
+	require.ErrorContains(t, err, "tls.spoof is enabled and may be the cause")
+	lines := warnings.take()
+	require.Contains(t, lines[len(lines)-1], "unanswered with all fingerprints (chrome, safari, firefox); tls.spoof is enabled and may be the cause")
+}
