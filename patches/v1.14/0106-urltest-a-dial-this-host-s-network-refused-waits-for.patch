From d93b6e1f17059fade6adfca30d63d8e3d501d89e Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Thu, 8 Oct 2026 19:46:34 +0300
Subject: [PATCH 106/106] urltest: a dial this host's network refused waits for
 the network monitor

When the default route goes, the network monitor reports the missing
default interface a second later: it delays its look at the routes. The
dials of that second fail with "network is unreachable", and the group
judged its members by them before the pause was known. On a stand a WAN
that went down for 30 seconds cost both members of a group their test
results and moved the group to the second one; the pause checks alone
did not change that.

A failure that is this host's own (no route, no interface up, no address
to send from) is now judged after the monitor has had time to speak, and
only if the network is still said to be there and the member was neither
tested nor used since: then the missing route was the member's own, an
interface it is bound to. The same for a confirming test that met the
missing route.
---
 protocol/group/urltest.go              |   1 +
 protocol/group/urltest_failure.go      |  65 +++++++++++++++-
 protocol/group/urltest_network_test.go | 102 +++++++++++++++++++++++++
 3 files changed, 165 insertions(+), 3 deletions(-)

diff --git a/protocol/group/urltest.go b/protocol/group/urltest.go
index ba97a2f1d..5a12402ea 100644
--- a/protocol/group/urltest.go
+++ b/protocol/group/urltest.go
@@ -292,6 +292,7 @@ type URLTestGroup struct {
 	unansweredConfirms           map[string]*memberConfirm
 	epoch                        time.Time
 	successes                    sync.Map // member tag → *atomic.Int64, its last successful TCP dial, since epoch
+	localFailures                sync.Map // member tag → a failure of this host's own network waits to be judged
 	downloadLink                 string
 	frozen                       common.TypedValue[map[string]time.Time] // member tag → when it last failed the download test
 	responses                    sync.Map                                // member tag → *memberResponses
diff --git a/protocol/group/urltest_failure.go b/protocol/group/urltest_failure.go
index 42ee1a0d4..91263ae77 100644
--- a/protocol/group/urltest_failure.go
+++ b/protocol/group/urltest_failure.go
@@ -7,6 +7,7 @@ import (
 	"net"
 	"os"
 	"sync/atomic"
+	"syscall"
 	"time"
 
 	"github.com/sagernet/sing-box/adapter"
@@ -41,6 +42,13 @@ import (
 // path, drops the first data, every dial succeeds. Only a member with a test result is
 // judged, the others are unavailable already, and a failure the caller caused (it
 // canceled, or closed the connection itself) says nothing.
+//
+// Nor does a failure this host's own network caused, while that network is gone: with no
+// default interface every dial through every member fails at once. The network monitor
+// says so (networkPaused), but a second after the route went: until then the dials fail
+// with "network is unreachable" (localNetworkError). Such a failure waits for the monitor
+// (afterLocalFailure) and is judged only if the network is still said to be there: then
+// it was the member's own way that was missing.
 
 // serverOnlyDial reports whether a dial through outbound contacts only its server, so that a
 // failed dial or handshake write is the server's.
@@ -71,6 +79,18 @@ func (g *URLTestGroup) memberFailed(ctx context.Context, member adapter.Outbound
 		return
 	}
 	tag := RealTag(g.outbound, member)
+	if localNetworkError(err) {
+		g.afterLocalFailure(tag, func() {
+			g.judgeFailure(tag, member, network, err, start)
+		})
+		return
+	}
+	g.judgeFailure(tag, member, network, err, start)
+}
+
+// judgeFailure decides what a failure that is neither the caller's nor the network's says
+// about the member.
+func (g *URLTestGroup) judgeFailure(tag string, member adapter.Outbound, network string, err error, start time.Time) {
 	if !start.IsZero() && g.succeededSince(tag, start) {
 		g.logger.Debug("outbound ", tag, " failed while another connection through it succeeded: ", err)
 		return
@@ -86,6 +106,38 @@ func (g *URLTestGroup) memberFailed(ctx context.Context, member adapter.Outbound
 	g.requestUpdateCheck()
 }
 
+// localFailureGrace is how long a failure of this host's own network waits for the network
+// monitor, which looks at the routes a second after they change.
+var localFailureGrace = 3 * time.Second
+
+// localNetworkError reports whether err is this host's own refusal to send: no route to
+// the address, no interface that is up, no address to send from.
+func localNetworkError(err error) bool {
+	return errors.Is(err, syscall.ENETUNREACH) || errors.Is(err, syscall.ENETDOWN) || errors.Is(err, syscall.EADDRNOTAVAIL)
+}
+
+// afterLocalFailure runs judge for a failure of this host's own network through the member
+// once the network monitor has had time to tell whether the network is gone. It is not run
+// if the network is reported gone by then, or if the member was tested or carried a
+// connection since: the failure is of the past. A member has one failure waiting at a time.
+func (g *URLTestGroup) afterLocalFailure(tag string, judge func()) {
+	if _, waiting := g.localFailures.LoadOrStore(tag, struct{}{}); waiting {
+		return
+	}
+	failed := time.Now()
+	time.AfterFunc(localFailureGrace, func() {
+		g.localFailures.Delete(tag)
+		if g.ctx.Err() != nil || g.networkPaused() || g.succeededSince(tag, failed) {
+			return
+		}
+		history := g.history.LoadURLTestHistory(tag)
+		if history != nil && history.Time.After(failed) {
+			return
+		}
+		judge()
+	})
+}
+
 // networkPaused reports whether the device sleeps or has no default interface. The ticker
 // of the group stops for that time, and so must the judgements made from traffic: they
 // would erase the test results of every member the group tries, one after another.
@@ -196,9 +248,16 @@ func (g *URLTestGroup) confirmWith(confirms *map[string]*memberConfirm, tag stri
 			// a test that failed because the network went away meanwhile proves nothing
 			return
 		}
-		g.logger.Info("outbound ", tag, " unavailable: ", err)
-		g.history.DeleteURLTestHistory(tag)
-		g.performUpdateCheck()
+		unavailable := func() {
+			g.logger.Info("outbound ", tag, " unavailable: ", err)
+			g.history.DeleteURLTestHistory(tag)
+			g.performUpdateCheck()
+		}
+		if localNetworkError(err) {
+			g.afterLocalFailure(tag, unavailable)
+			return
+		}
+		unavailable()
 	}()
 	return true
 }
diff --git a/protocol/group/urltest_network_test.go b/protocol/group/urltest_network_test.go
index af9e45da8..0ee6fb300 100644
--- a/protocol/group/urltest_network_test.go
+++ b/protocol/group/urltest_network_test.go
@@ -184,3 +184,105 @@ func TestURLTestDialErrorNamesMember(t *testing.T) {
 	require.Contains(t, err.Error(), "outbound/vless[")
 	require.ErrorIs(t, err, os.ErrInvalid)
 }
+
+// dialUnreachable fails as a dial does when this host has no route to the server.
+func dialUnreachable(context.Context, string, M.Socksaddr) (net.Conn, error) {
+	return nil, &net.OpError{Op: "dial", Net: "tcp", Err: os.NewSyscallError("connect", syscall.ENETUNREACH)}
+}
+
+func shortLocalFailureGrace(t *testing.T) {
+	saved := localFailureGrace
+	localFailureGrace = 300 * time.Millisecond
+	t.Cleanup(func() { localFailureGrace = saved })
+}
+
+// The route goes a second before the network monitor reports that there is no default
+// interface, and the dials of that second fail with "network is unreachable". They are
+// this host's failure: once the monitor has spoken the members still have their test
+// results, and the group has not moved.
+func TestURLTestLocalNetworkErrorWaitsForMonitor(t *testing.T) {
+	shortLocalFailureGrace(t)
+	link, requests := testURL(t, 0)
+	first := newTestMember(C.TypeVLESS, "first", dialUnreachable)
+	second := newTestMember(C.TypeVLESS, "second", dialUnreachable)
+	urlTest, group := newTestURLTest(t, link, first, second)
+	paused := &testPause{}
+	group.pause = paused
+
+	for range 3 {
+		_, err := urlTest.DialContext(context.Background(), N.NetworkTCP, M.ParseSocksaddr("1.2.3.4:443"))
+		require.Error(t, err)
+	}
+	paused.networkPaused.Store(true) // the monitor speaks
+	time.Sleep(2 * localFailureGrace)
+	require.NotNil(t, group.history.LoadURLTestHistory("first"))
+	require.NotNil(t, group.history.LoadURLTestHistory("second"))
+	require.Equal(t, "first", group.selectedOutboundTCP.Load().Tag())
+	require.Equal(t, int32(3), first.dials.Load())
+	require.Equal(t, int32(0), second.dials.Load())
+	require.Equal(t, int32(0), requests.Load())
+}
+
+// With the network still there after that time the missing route was the member's own (an
+// interface it is bound to went down): the member is unavailable, as after any failed dial.
+func TestURLTestLocalNetworkErrorOfOneMember(t *testing.T) {
+	shortLocalFailureGrace(t)
+	link, _ := testURL(t, 0)
+	first := newTestMember(C.TypeVLESS, "first", dialUnreachable)
+	second := newTestMember(C.TypeVLESS, "second", dialWorking)
+	urlTest, group := newTestURLTest(t, link, first, second)
+	group.pause = &testPause{}
+
+	_, err := urlTest.DialContext(context.Background(), N.NetworkTCP, M.ParseSocksaddr("1.2.3.4:443"))
+	require.Error(t, err)
+	require.NotNil(t, group.history.LoadURLTestHistory("first"), "judged before the monitor could speak")
+	waitSelected(t, group, "second")
+	require.Nil(t, group.history.LoadURLTestHistory("first"))
+}
+
+// A member tested after the failure, by the round a new default interface forces, keeps
+// that result: the failure was of the network that is no more.
+func TestURLTestLocalNetworkErrorOutdated(t *testing.T) {
+	shortLocalFailureGrace(t)
+	link, _ := testURL(t, 0)
+	first := newTestMember(C.TypeVLESS, "first", dialUnreachable)
+	second := newTestMember(C.TypeVLESS, "second", dialWorking)
+	urlTest, group := newTestURLTest(t, link, first, second)
+	group.pause = &testPause{}
+
+	_, err := urlTest.DialContext(context.Background(), N.NetworkTCP, M.ParseSocksaddr("1.2.3.4:443"))
+	require.Error(t, err)
+	group.history.StoreURLTestHistory("first", &adapter.URLTestHistory{Time: time.Now(), Delay: 10})
+	time.Sleep(2 * localFailureGrace)
+	require.NotNil(t, group.history.LoadURLTestHistory("first"))
+	require.Equal(t, "first", group.selectedOutboundTCP.Load().Tag())
+}
+
+// A confirming test that met the missing route waits for the monitor too.
+func TestURLTestConfirmLocalNetworkErrorWaitsForMonitor(t *testing.T) {
+	shortLocalFailureGrace(t)
+	link, _ := testURL(t, 0)
+	member := newTestMember(C.TypeVLESS, "member", dialUnreachable)
+	spare := newTestMember(C.TypeVLESS, "spare", dialWorking)
+	urlTest, group := newTestURLTest(t, link, member, spare)
+	paused := &testPause{}
+	group.pause = paused
+
+	// a failed packet dial is confirmed by a URL test of the member, which finds no route
+	_, err := urlTest.ListenPacket(context.Background(), M.ParseSocksaddr("1.2.3.4:443"))
+	require.Error(t, err)
+	waitConfirmed(t, group, "member")
+	require.Equal(t, int32(1), member.dials.Load())
+	paused.networkPaused.Store(true)
+	time.Sleep(2 * localFailureGrace)
+	require.NotNil(t, group.history.LoadURLTestHistory("member"))
+	require.Equal(t, "member", group.selectedOutboundTCP.Load().Tag())
+
+	// and without the monitor's word the member is unavailable after that time
+	paused.networkPaused.Store(false)
+	allowConfirm(group, "member", time.Now())
+	_, err = urlTest.ListenPacket(context.Background(), M.ParseSocksaddr("1.2.3.4:443"))
+	require.Error(t, err)
+	waitSelected(t, group, "spare")
+	require.Nil(t, group.history.LoadURLTestHistory("member"))
+}
