From 9278379026e1b1f0d11a2015cf1fe5d11cc28946 Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Fri, 9 Oct 2026 12:55:10 +0300
Subject: [PATCH 117/118] clashapi: do not write to the record of a connection
 while it is listed

When a tracked connection closes, the traffic manager wrote the closing
time into the record of the connection and then took a copy of it for
the list of closed connections. The same record is what a listing of the
connections reads: the Clash API copies or marshals the record of every
live connection. A dashboard that polls /connections while connections
close reads a record that is being written; the race detector reported
it in a ten-minute run of the whole release under load, 3 and 4 times on
the two lines.

The time is now written into the copy that is kept. The closed
connections and the events carry it as before; nothing read it from the
record of the connection itself.
---
 common/trafficcontrol/manager.go           |  5 ++-
 common/trafficcontrol/manager_race_test.go | 45 ++++++++++++++++++++++
 2 files changed, 49 insertions(+), 1 deletion(-)
 create mode 100644 common/trafficcontrol/manager_race_test.go

diff --git a/common/trafficcontrol/manager.go b/common/trafficcontrol/manager.go
index d5b6a2b53..649a4d008 100644
--- a/common/trafficcontrol/manager.go
+++ b/common/trafficcontrol/manager.go
@@ -104,8 +104,11 @@ func (m *Manager) leave(tracker Tracker) {
 		m.closedConnectionsAccess.Unlock()
 		return
 	}
-	metadata.ClosedAt = closedAt
+	// The time goes into the copy that is kept, not into the record of the connection
+	// itself: that one is being read by whoever lists the connections at this moment (the
+	// Clash API copies every record), and the write raced with that read (podkop-engine).
 	metadataCopy := *metadata
+	metadataCopy.ClosedAt = closedAt
 	if m.closedConnections.Len() >= closedConnectionsLimit {
 		evicted := m.closedConnections.PopFront()
 		m.closedUploadTotal += evicted.Upload.Load()
diff --git a/common/trafficcontrol/manager_race_test.go b/common/trafficcontrol/manager_race_test.go
new file mode 100644
index 000000000..e4ce44977
--- /dev/null
+++ b/common/trafficcontrol/manager_race_test.go
@@ -0,0 +1,45 @@
+package trafficcontrol
+
+import (
+	"sync/atomic"
+	"testing"
+
+	"github.com/gofrs/uuid/v5"
+	"github.com/stretchr/testify/require"
+)
+
+type recordTracker struct {
+	metadata TrackerMetadata
+}
+
+func (t *recordTracker) Metadata() *TrackerMetadata { return &t.metadata }
+func (t *recordTracker) Close() error               { return nil }
+
+// A connection that closes while the connections are being listed: the record of the
+// connection is read by the one who lists (the Clash API copies each), so the closing
+// writes its time into the copy it keeps and not into that record. With the race detector
+// this test is the race itself.
+func TestLeaveDoesNotWriteTheRecordBeingRead(t *testing.T) {
+	manager := NewManager(nil)
+	var read int64
+	for range 100 {
+		tracker := &recordTracker{metadata: TrackerMetadata{ID: uuid.Must(uuid.NewV4()), Upload: new(atomic.Int64), Download: new(atomic.Int64)}}
+		manager.join(tracker)
+		listed := make(chan struct{})
+		go func() {
+			defer close(listed)
+			for _, metadata := range manager.Connections() {
+				record := *metadata
+				atomic.AddInt64(&read, record.ClosedAt.Unix())
+			}
+		}()
+		manager.leave(tracker)
+		<-listed
+		require.True(t, tracker.metadata.ClosedAt.IsZero(), "the record of the connection was written to")
+	}
+	closed := manager.ClosedConnections()
+	require.Len(t, closed, 100)
+	for _, metadata := range closed {
+		require.False(t, metadata.ClosedAt.IsZero(), "the record that is kept has no closing time")
+	}
+}
