# Всё, от чего зависит сборка. Меняется руками при выпуске (см. docs/RELEASE.md).

# Ветки sing-box: последний тег каждой ветки upstream. HASH — sha256 архива
# https://codeload.github.com/SagerNet/sing-box/tar.gz/v<версия> (его проверяет SDK).
# RELEASE — номер ревизии пакета (-rN): +1 при изменении наших патчей на той же версии upstream.
LINES="1.12 1.13 1.14"

SB_1_12_VERSION=1.12.25
SB_1_12_HASH=881435f07b5ab8170ccf3cb69e87130759521dc0ed1ae4bfeacbe7772a93a158
SB_1_12_RELEASE=1

SB_1_13_VERSION=1.13.21
SB_1_13_HASH=c994018d7c2a8fc9fcf6080e4b9cc4f2f915e755342238b77e46fc0806fe96db
SB_1_13_RELEASE=9

SB_1_14_VERSION=1.14.2
SB_1_14_HASH=67dd8f8c37ecaaadcfcafad1f0827eed4b034c963b86fd3aa5c0d7a36876845d
SB_1_14_RELEASE=9

# Go: lang/golang из openwrt/packages (ветка openwrt-25.12, Go 1.26.8) подменяет штатный
# в каждом SDK — в 24.10 штатный Go 1.23 не собирает sing-box 1.13+.
GOLANG_FEED_REPO=https://github.com/openwrt/packages.git
GOLANG_FEED_COMMIT=f60a090afff932579d015045dd1eff9f744fa043
GO_VERSION=1.26.8   # что даёт этот коммит (для описания релиза)

# lld for the NaiveProxy link of podkop-engine-full (see the Makefile): Chromium's clang
# package of the cronet version (naiveproxy src/tools/clang/scripts/update.py), from Google
# Storage; apt.llvm.org refused connections from CI runners.
LLD_URL=https://commondatastorage.googleapis.com/chromium-browser-clang/Linux_x64/clang-llvmorg-23-init-10931-g20b6ec66-11.tar.xz
LLD_SHA256=de584381536aa5ba2403033c4f8b70f3c39c2e5d7fa87c953b7fd8bfbba0ee2a

# SDK (образы openwrt/sdk:<target>-v<версия>): ipk собирается в 24.10, apk — в 25.12
# (ставится и на snapshot).
SDK_IPK_RELEASE=24.10.8
SDK_APK_RELEASE=25.12.5
